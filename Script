function Fn.teleportTo(player)
	local tr = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local lr = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
	if tr and lr then
		Fn.notify("Teleportation", "Teleporting to " .. player.DisplayName .. ".", "ok")
		lr.CFrame = CFrame.new(tr.Position) * (lr.CFrame - lr.CFrame.Position)
	else
		Fn.notify("Teleportation Error", player.DisplayName .. " cannot be teleported to right now.", "warn")
	end
end

function Fn.restoreCamera()
	State.spectating = nil
	local h = Fn.humanoid()
	if h then
		camera.CameraSubject = h
	end
	camera.CameraType = Enum.CameraType.Custom
end

function Fn.toggleSpectate(player)
	if State.spectating == player then
		Fn.restoreCamera()
		Fn.notify("Stopped Spectating", "Camera returned to your character.", "info")
		return false
	end
	local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not h then
		Fn.notify("Unable to Spectate", player.DisplayName .. " has no loaded character right now.", "warn")
		return false
	end
	State.spectating = player
	camera.CameraSubject = h
	camera.CameraType = Enum.CameraType.Custom
	Fn.notify("Spectating", "Now spectating " .. player.DisplayName .. ".", "info")
	return true
end

