	do
		local function setupExtras()
		local X = { live = {}, waypoints = {} }
		local keyCodes = Enum.KeyCode
		local humanoidStates = Enum.HumanoidStateType
		local virtualUser = getService("VirtualUser")

		local function bind(name, signal, fn)
			local old = X.live[name]
			if old then
				pcall(function()
					old:Disconnect()
				end)
			end
			local c = signal:Connect(fn)
			X.live[name] = c
			track(c)
			return c
		end

		local function unbind(name)
			local c = X.live[name]
			if c then
				pcall(function()
					c:Disconnect()
				end)
				X.live[name] = nil
			end
		end

		local function parts()
			local c = localPlayer.Character
			if not c then
				return nil
			end
			return c, c:FindFirstChildOfClass("Humanoid"), c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart
		end

		local function asset(id)
			local s = tostring(id or "")
			if s:find("^%d+$") then
				return "rbxassetid://" .. s
			end
			local n = s:match("rbxassetid://(%d+)") or s:match("[?&]id=(%d+)")
			if n then
				return "rbxassetid://" .. n
			end
			return nil
		end

		local function digits(id)
			return tostring(id or ""):match("%d+")
		end

		local function typing()
			return userInputService:GetFocusedTextBox() ~= nil
		end

		local function down(k)
			return userInputService:IsKeyDown(k)
		end

		local function flag(arg, current)
			local a = arg and string.lower(arg)
			if a == "on" or a == "true" or a == "1" then
				return true
			end
			if a == "off" or a == "false" or a == "0" then
				return false
			end
			return not current
		end

		local function say(title, text, kind)
			Fn.notify(title, text, kind or "info")
		end

		local function aim(pos, look)
			local cam = workspace.CurrentCamera
			local up = math.abs(look.Unit.Y) > 0.98 and cam.CFrame.LookVector or Vector3.yAxis
			return CFrame.lookAt(pos, pos + look, up)
		end

		local function steer(vertical)
			local cam = workspace.CurrentCamera
			local _, h = parts()
			local v = Vector3.zero
			if not typing() then
				if down(keyCodes.W) then
					v = v + cam.CFrame.LookVector
				end
				if down(keyCodes.S) then
					v = v - cam.CFrame.LookVector
				end
				if down(keyCodes.D) then
					v = v + cam.CFrame.RightVector
				end
				if down(keyCodes.A) then
					v = v - cam.CFrame.RightVector
				end
			end
			if v.Magnitude < 0.01 and h and h.MoveDirection.Magnitude > 0.05 then
				local rel = cam.CFrame:VectorToObjectSpace(h.MoveDirection)
				v = cam.CFrame.LookVector * -rel.Z + cam.CFrame.RightVector * rel.X
			end
			if vertical then
				local rise, fall = false, false
				if not typing() then
					rise = down(keyCodes.Space) or down(keyCodes.E)
					fall = down(keyCodes.Q) or down(keyCodes.LeftControl)
				end
				if h and h.Jump then
					rise = true
				end
				if rise then
					v = v + Vector3.yAxis
				end
				if fall then
					v = v - Vector3.yAxis
				end
			end
			return v
		end

		local function stopTrack(t)
			if t then
				pcall(function()
					t:Stop(0.15)
				end)
				task.delay(0.4, function()
					pcall(function()
						t:Destroy()
					end)
				end)
			end
		end

		local function loadTrack(animId, priority, looped)
			local _, h = parts()
			local ref = asset(animId)
			if not h or not ref then
				return nil
			end
			local ok, tr = pcall(function()
				local a = Instance.new("Animation")
				a.AnimationId = ref
				local t = Fn.getAnimator(h):LoadAnimation(a)
				a:Destroy()
				return t
			end)
			if not ok or not tr then
				return nil
			end
			tr.Priority = priority or Enum.AnimationPriority.Action4
			tr.Looped = looped ~= false
			return tr
		end

		local function matchEntry(list, query)
			query = string.lower(tostring(query or ""))
			if query == "" then
				return nil
			end
			local partial
			for _, e in ipairs(list) do
				local id, name = string.lower(e.id), string.lower(e.name)
				if id == query or name == query then
					return e
				end
				if not partial and (id:find(query, 1, true) or name:find(query, 1, true)) then
					partial = e
				end
			end
			return partial
		end

