function Fn.extractDomain(link)
	return link:match("([%w-_]+%.[%w-_%.]+)")
end

function Fn.readAllowlist()
	if not (isfile and readfile) then
		return nil
	end
	local ok, raw = pcall(function()
		return isfile(folderPath("allowed.json")) and readfile(folderPath("allowed.json")) or nil
	end)
	if not ok or not raw then
		return nil
	end
	local dok, decoded = pcall(httpService.JSONDecode, httpService, raw)
	if dok and type(decoded) == "table" then
		return decoded
	end
	return nil
end

function Fn.securityPrompt(title, content, link, actions)
	if not Fn.alive() then
		return false
	end
	local domain = Fn.extractDomain(link) or link
	local allow = Fn.readAllowlist()
	if allow and table.find(allow, domain) then
		return true
	end
	local card, close = Fn.promptCard(520, 190)
	ttxt(card, { Position = UDim2.fromOffset(24, 18), Size = UDim2.new(1, -48, 0, 22), Text = title, TextSize = 16, Font = Enum.Font.GothamBold, ZIndex = 3 }, "text")
	ttxt(card, { Position = UDim2.fromOffset(24, 46), Size = UDim2.new(1, -48, 0, 44), Text = content, TextSize = 12, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, TextTransparency = 0.2, ZIndex = 3 }, "muted")
	local linkBox = new("Frame", { Position = UDim2.fromOffset(24, 98), Size = UDim2.new(1, -48, 0, 28), BorderSizePixel = 0, ZIndex = 3 }, card)
	reg(linkBox, "BackgroundColor3", "tile")
	round(linkBox, 8)
	ttxt(linkBox, { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0), Text = tostring(domain), TextSize = 12, Font = Enum.Font.Code, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 4 }, "accent")
	local decision
	local x = 24
	for _, a in ipairs(actions) do
		local w = textService:GetTextSize(a[1], 12, Enum.Font.GothamBold, Vector2.new(400, 20)).X + 36
		local b = Fn.tile(card, { Position = UDim2.fromOffset(x, 138), Size = UDim2.fromOffset(w, 34), corner = 10 }, a[2] and "accent" or "tile")
		ttxt(b, { Size = UDim2.fromScale(1, 1), Text = a[1], TextSize = 12, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4 }, a[2] and "bg" or "text")
		Fn.hoverTile(b, 1.05)
		b.MouseButton1Click:Connect(function()
			if decision ~= nil then
				return
			end
			if a[2] and a[3] and writefile then
				Fn.ensureFolders()
				local list = allow or {}
				table.insert(list, domain)
				pcall(writefile, folderPath("allowed.json"), httpService:JSONEncode(list))
			end
			decision = a[2] and true or false
			close()
		end)
		x += w + 10
	end
	local deadline = os.clock() + 60
	while decision == nil do
		if os.clock() > deadline then
			decision = false
			close()
			break
		end
		task.wait()
	end
	return decision
end

function Fn.installInterception()
	if originalRequest then
		local hook = function(data)
			if type(data) ~= "table" then
				return originalRequest(data)
			end
			if not (Fn.alive() and Values.intflowintercept) then
				return originalRequest(data)
			end
			local url = data.Url or data.url or "Unknown Link"
			local title = "Do you trust this source?"
			local content = "Schweins Admin stopped data from being sent off-client. Allow data to be sent or retrieved from this source?"
			local actions = { { "Always Allow", true, true }, { "Allow once", true }, { "Don't Allow", false } }
			if url == "http://127.0.0.1:6463/rpc?v=1" and data.Body then
				local ok, body = pcall(httpService.JSONDecode, httpService, data.Body)
				if ok and type(body) == "table" and body.cmd == "INVITE_BROWSER" then
					title = "Join this Discord server?"
					content = "Your Discord client tried to automatically join a server. Continue or block it?"
					url = body.args and body.args.code and ("discord.gg/" .. body.args.code) or "Unknown Invite"
					actions = { { "Allow", true }, { "Don't Allow", false } }
				end
			end
			if Fn.securityPrompt(title, content, tostring(url), actions) then
				return originalRequest(data)
			end
			return { Success = false, StatusCode = 403, StatusMessage = "Blocked", Headers = {}, Body = "" }
		end
		for _, alias in ipairs({ "request", "http_request" }) do
			if env[alias] then
				env[alias] = hook
			end
		end
	end
	if originalSetClipboard then
		env.setclipboard = function(data)
			if not (Fn.alive() and Values.intflowinterceptclip) then
				return originalSetClipboard(data)
			end
			local actions = { { "Allow", true }, { "Don't Allow", false } }
			if Fn.securityPrompt("Copy this to your clipboard?", "A script tried to set the text below on your clipboard. Allow it?", tostring(data or "Empty"), actions) then
				return originalSetClipboard(data)
			end
		end
	end
end

function Fn.initAntiKick()
	if not Values.antikick or not (hookMetamethod and getNamecallMethod) or env.schweinsAntiKick then
		return
	end
	env.schweinsAntiKick = true
	local ok, err = pcall(function()
		local oldIndex, oldNamecall
		oldIndex = hookMetamethod(game, "__index", function(self, key)
			if self == localPlayer and type(key) == "string" and key:lower() == "kick" and Values.antikick and Fn.alive() then
				Fn.notify("Kick Prevented", "Prevented a client kick request.", "warn")
				return error("Expected ':' not '.' calling member function Kick", 2)
			end
			return oldIndex(self, key)
		end)
		oldNamecall = hookMetamethod(game, "__namecall", function(self, ...)
			if self == localPlayer and getNamecallMethod():lower() == "kick" and Values.antikick and Fn.alive() then
				Fn.notify("Kick Prevented", "Prevented a client kick request.", "warn")
				return
			end
			return oldNamecall(self, ...)
		end)
	end)
	if not ok then
		env.schweinsAntiKick = nil
		warn("Schweins Admin | Anti Kick unavailable: " .. tostring(err))
	end
end

