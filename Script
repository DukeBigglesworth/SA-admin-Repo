local saved = {}

local function keep(obj, prop)
	saved[obj] = saved[obj] or {}
	if saved[obj][prop] == nil then
		saved[obj][prop] = obj[prop]
	end
end

local function restoreAll(prefix)
	for obj, props in pairs(saved) do
		for p, v in pairs(props) do
			pcall(function()
				obj[p] = v
			end)
		end
	end
	saved = {}
