		local function rampSpeed(base, mode, t)
			local wave = math.sin(t * 1.4 - 1.57) * 0.5 + 0.5
			local v = base
			if mode == "rise" then
				v = base * (0.35 + wave * 1.35)
			elseif mode == "fall" then
				v = base * (1.7 - wave * 1.35)
			elseif mode == "wave" then
				v = base * (1 + math.sin(t * 2.2) * 0.45)
			elseif mode == "pulse" then
				v = base * (math.sin(t * 4.4) > 0.55 and 1.8 or 0.85)
			end
			return math.clamp(v, 0.05, 6)
		end

