		local function startAirwalk()
			local _, h, r = parts()
			if not (h and r) then
				return say("Airwalk", "Your character isn't ready.", "warn")
			end
			local a = X.air
			stopAirwalk(true)
			a.on = true
			a.y = feetY(h, r)
