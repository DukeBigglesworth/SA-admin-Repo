		Fn.notify("Set keybind", "Press a key. Backspace clears. Esc cancels.", "info")
		waiting = userInputService.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.Keyboard then
				return
			end
			waiting:Disconnect()
			waiting = nil
			task.defer(function()
				State.checkingKey = nil
			end)
			local binds = Fn.tableValue("binds")
			local name = primary(c)
			if input.KeyCode == Enum.KeyCode.Escape then
				return refresh()
			end
			for key, cmd in pairs(binds) do
				if lower(cmd) == name then
					binds[key] = nil
				end
			end
			if input.KeyCode ~= Enum.KeyCode.Backspace then
				binds[input.KeyCode.Name] = name
			end
			Fn.saveSettings()
			refresh()
		end)
		task.delay(8, function()
			if waiting then
				waiting:Disconnect()
				waiting = nil
				State.checkingKey = nil
				refresh()
			end
		end)
	end)
	return refresh
