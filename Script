		add({ "copyanim", "copyemote" }, "copyanim <player>", "Mirror a player's animations", function(args)
			local p = Fn.findPlayer(args[1])
			if not p then
				return say("Copy Animation", "Give a player to copy.", "warn")
			end
			stopCopy()
			bind("copyanim", runService.Heartbeat, function()
				local _, h = parts()
				local th = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
				local ta = th and th:FindFirstChildOfClass("Animator")
				if not (h and ta) then
					return
				end
				local animator = Fn.getAnimator(h)
				local seen = {}
				for _, t in ipairs(ta:GetPlayingAnimationTracks()) do
					local id = t.Animation and t.Animation.AnimationId
					if id and id ~= "" then
						seen[id] = true
						local mine = X.copy.tracks[id]
						if not mine then
							local ok, loaded = pcall(function()
								local a = Instance.new("Animation")
								a.AnimationId = id
								local l = animator:LoadAnimation(a)
								a:Destroy()
								return l
							end)
							if ok and loaded then
								mine = loaded
								mine.Priority = Enum.AnimationPriority.Action4
								mine.Looped = t.Looped
								mine:Play(0.1)
								X.copy.tracks[id] = mine
							end
						end
						if mine then
							pcall(function()
								mine:AdjustSpeed(t.Speed)
								if math.abs(mine.TimePosition - t.TimePosition) > 0.3 then
									mine.TimePosition = t.TimePosition
								end
							end)
						end
					end
				end
				for id, tr in pairs(X.copy.tracks) do
					if not seen[id] then
						stopTrack(tr)
						X.copy.tracks[id] = nil
					end
				end
			end)
			say("Copy Animation", "Mirroring " .. p.DisplayName, "ok")
		end)
		add({ "uncopyanim", "uncopyemote" }, "uncopyanim", "Stop mirroring", function()
