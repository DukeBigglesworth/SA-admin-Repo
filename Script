local starterGui, textService, teleportService, statsService = S.starterGui, S.textService, S.teleportService, S.statsService
local localPlayer, gui, folderPath = S.localPlayer, S.gui, C.folderPath
local lower, format, floor, clamp = string.lower, string.format, math.floor, math.clamp
local Mod = Fn.Mod
local An = { speed = 1, looped = false, cancelOnMove = true, priority = Enum.AnimationPriority.Action, name = "", log = {}, logOn = false, logConns = {}, logAll = false, extras = {}, packSel = {}, origPack = {}, paused = false }
Fn.Anim = An
local mpService = game:GetService("MarketplaceService")
local CATS = { "idle", "walk", "run", "jump", "fall", "climb", "swim", "swimidle" }
local CAT_NAMES = { idle = "Idle", walk = "Walk", run = "Run", jump = "Jump", fall = "Fall", climb = "Climb", swim = "Swim", swimidle = "Swim Idle" }
local PACK_MAP = {
	idle = { { "idle", "Animation1" }, { "idle", "Animation2" } },
	walk = { { "walk", "WalkAnim" } },
	run = { { "run", "RunAnim" } },
	jump = { { "jump", "JumpAnim" } },
	fall = { { "fall", "FallAnim" } },
