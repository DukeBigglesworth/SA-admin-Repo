local cache, pending, Pose = {}, {}, {}

local function getTrack(id, cb)
	local c = cache[id]
	if c then
		return cb(c)
	end
	if pending[id] then
		return
	end
	pending[id] = true
	task.spawn(function()
		local tr = Fn.loadAnimById(id)
		pending[id] = nil
		if tr then
			tr.Priority = Enum.AnimationPriority.Action4
			tr.Looped = true
			cache[id] = tr
			cb(tr)
		end
	end)
end

local function setPose(id)
	if Pose.want == id then
		return
	end
	Pose.want = id
	if Pose.track then
		pcall(function()
			Pose.track:Stop(0.2)
		end)
		Pose.track = nil
	end
	if id == "" or not Fl.animate then
		return
	end
	getTrack(id, function(tr)
		if Pose.want == id then
			Pose.track = tr
			pcall(function()
				tr:Play(0.2)
			end)
		end
	end)
end

local function clearPose()
	Pose.want = nil
	if Pose.track then
		pcall(function()
			Pose.track:Stop(0.2)
		end)
		Pose.track = nil
	end
end

