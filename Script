function Fn.ring(parent, pos, color, size, thick, dur)
	local rg = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = pos, Size = UDim2.fromOffset(6, 6), BackgroundTransparency = 1, ZIndex = 150,
	}, parent)
	round(rg, 9999)
	local st = stroke(rg, color, 0.1, thick)
	tween(rg, dur, { Size = UDim2.fromOffset(size, size) }, Enum.EasingStyle.Quart)
	tween(st, dur, { Transparency = 1, Thickness = 0 })
	task.delay(dur + 0.1, function()
		rg:Destroy()
	end)
end

function Fn.ripple(button)
	button.ClipsDescendants = true
	button.MouseButton1Down:Connect(function(x, y)
		local rel = Vector2.new(x, y) - button.AbsolutePosition
		local scale = button:FindFirstChildOfClass("UIScale")
		if scale then
			rel = rel / scale.Scale
		end
		local dot = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(rel.X, rel.Y), Size = UDim2.fromOffset(4, 4),
			BackgroundColor3 = Theme.accent, BackgroundTransparency = 0.55, BorderSizePixel = 0, ZIndex = 9,
		}, button)
		round(dot, 9999)
		local big = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 2.4
		tween(dot, 0.6, { Size = UDim2.fromOffset(big, big), BackgroundTransparency = 1 })
		task.delay(0.65, function()
			dot:Destroy()
		end)
	end)
end

function Fn.tile(parent, props, fill)
	local b = new("TextButton", {
		Position = props.Position, Size = props.Size, AnchorPoint = props.AnchorPoint, Text = "", AutoButtonColor = false, BorderSizePixel = 0, ZIndex = props.ZIndex or 3,
	}, parent)
	reg(b, "BackgroundColor3", fill or "tile")
	if fill == "accent" then
		b:SetAttribute("SchweinsAccent", true)
	end
	round(b, props.corner or 10)
	local st = stroke(b, nil, 0.4, 1)
	reg(st, "Color", "stroke")
	return b, st
end

function Fn.hoverTile(b, scaleUp)
	local sc = new("UIScale", { Scale = 1 }, b)
	b.MouseEnter:Connect(function()
		if not b:GetAttribute("SchweinsAccent") then
			tween(b, 0.3, { BackgroundColor3 = Theme.tileHover })
		end
		tween(sc, 0.35, { Scale = scaleUp or 1.04 }, Enum.EasingStyle.Back)
	end)
	b.MouseLeave:Connect(function()
		if not b:GetAttribute("SchweinsAccent") then
			tween(b, 0.3, { BackgroundColor3 = Theme.tile })
		end
		tween(sc, 0.3, { Scale = 1 })
	end)
	b.MouseButton1Down:Connect(function()
		tween(sc, 0.12, { Scale = 0.94 })
	end)
	b.MouseButton1Up:Connect(function()
		tween(sc, 0.35, { Scale = scaleUp or 1.04 }, Enum.EasingStyle.Back)
	end)
	return sc
end

function Fn.stagger(content)
	local i = 0
	for _, child in ipairs(content:GetChildren()) do
		if child:IsA("GuiObject") then
			if child:GetAttribute("home") == nil then
				child:SetAttribute("home", child.Position)
			end
			local home = child:GetAttribute("home")
			i += 1
			child.Position = home + UDim2.fromOffset(0, 16)
			task.delay(0.05 + i * 0.02, function()
				if child.Parent then
					tween(child, 0.6, { Position = home }, Enum.EasingStyle.Back)
				end
			end)
		end
	end
end

function Fn.alive()
