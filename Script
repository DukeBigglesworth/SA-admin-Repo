		local function encodeFrames(frames)
			local out = {}
			for _, f in ipairs(frames) do
				local p = {}
				for name, cf in pairs(f.p) do
					p[name] = { cf:GetComponents() }
				end
				out[#out + 1] = { t = f.t, p = p }
			end
			return httpService:JSONEncode(out)
		end

		local function decodeFrames(text)
			local ok, data = pcall(httpService.JSONDecode, httpService, text)
			if not ok or type(data) ~= "table" then
				return nil
			end
			local frames = {}
			for _, f in ipairs(data) do
				local p = {}
				for name, c in pairs(f.p or {}) do
					if type(c) == "table" and #c == 12 then
						p[name] = CFrame.new(table.unpack(c))
					end
				end
				frames[#frames + 1] = { t = tonumber(f.t) or 0, p = p }
			end
			table.sort(frames, function(a, b)
				return a.t < b.t
			end)
			return #frames > 0 and frames or nil
		end

