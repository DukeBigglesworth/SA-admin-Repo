function Fn.buildInput()
	track(userInputService.InputBegan:Connect(function(input, processed)
		if not Fn.alive() then
			return
		end

		if type(State.checkingKey) == "string" then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				local id = State.checkingKey
				State.checkingKey = nil
				if input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then
					Fn.onSetting(id, "")
				elseif input.KeyCode ~= Enum.KeyCode.Escape then
					Fn.onSetting(id, input.KeyCode.Name)
				end
				if W.keyButtons and W.keyButtons[id] then
					W.keyButtons[id].Text = (Values[id] ~= nil and Values[id] ~= "") and Values[id] or "No Keybind"
				end
				Fn.refreshKeyChips(id)
			end
			return
		end

		if State.checkingKey then
			State.checkingKey = nil
		end
		if not State.ready or input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end

		if processed and userInputService:GetFocusedTextBox() then
			return
		end
		for _, cat in ipairs(SettingDefs) do
			for _, item in ipairs(cat.items) do
				if item.type == "Key" then
					local val = Values[item.id]
					if type(val) == "string" and val ~= "" and input.KeyCode == Fn.keyFromName(val) then
						if item.id == "smartbar" then
							Fn.setDock(not State.dockOpen)
						elseif item.id == "scriptsearch" then
							if State.dockOpen then
								if W.scriptWin and W.scriptWin.open then
									W.scriptWin.hide()
								else
									Fn.openScriptWindow("search", nil)
								end
							end
						elseif item.id == "cmdbar" then
							if Fn.openCmdBar then
								Fn.openCmdBar()
							end
						elseif item.id == "k_speed" then
							Fn.toggleSpeedBoost()
						elseif item.id == "k_jump" then
							Fn.toggleJumpBoost()
						elseif item.action then
							Fn.toggleAction(item.action)
						elseif Fn.keyIdFor then
							for idx, kid in pairs(Fn.keyIdFor) do
								if kid == item.id then
									Fn.toggleAction(idx)
									break
								end
							end
						end
					end
				end
			end
		end
	end))
	track(userInputService.InputChanged:Connect(function(input)
		if State.activeSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			Fn.updateSliderFromX(State.activeSlider, input.Position.X)
		end
	end))
	track(userInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if State.activeSlider then
				tween(State.activeSlider.frame, 0.3, { BackgroundTransparency = 0.82 })
				State.activeSlider = nil
			end
		end
	end))
	track(userInputService.WindowFocusReleased:Connect(function()
		Fn.windowFocus(false)
	end))
	track(userInputService.WindowFocused:Connect(function()
		Fn.windowFocus(true)
	end))
end

function Fn.buildLoops()
	track(runService.RenderStepped:Connect(function(dt)
		if not Fn.alive() then
			return
		end
		W.logo.Rotation = (W.logo.Rotation + State.logoSpin * dt) % 360
		State.logoSpin = lerp(State.logoSpin, 22, math.min(dt * 1.2, 1))
		if Values.animstroke then
			for _, e in ipairs(animGradients) do
				e.g.Rotation = (e.g.Rotation + e.speed * dt) % 360
			end
		end
		if W.embersOn then
			for _, e in ipairs(W.emberList) do
				local p = e.f.Position
				local y = p.Y.Scale - e.sp * dt
				if y < -0.05 then
					y = 1.05
				end
				e.f.Position = UDim2.fromScale(p.X.Scale + math.sin(os.clock() * 1.5 + e.sw) * e.amp * dt, y)
			end
		end
		local fq = State.frame
		local fps = math.round(1 / math.max(dt, 0.0001))
		table.insert(fq.queue, fps)
		fq.total += fps
		if #fq.queue > 10 then
			fq.total -= fq.queue[1]
			table.remove(fq.queue, 1)
		end
		State.fpsAcc = (State.fpsAcc or 0) + dt
		State.fpsN = (State.fpsN or 0) + 1
		if State.fpsAcc >= 0.5 then
			State.fps = State.fpsN / State.fpsAcc
			State.fpsAcc, State.fpsN = 0, 0
		end
	end))

	local actions = Fn.Actions
	local sliders = Fn.Sliders
	track(runService.Stepped:Connect(function()
		if not Fn.alive() then
			return
		end
		local active = actions[1].enabled or actions[6].enabled
		if not active and not State.noclipWas then
			return
		end
		for part in pairs(State.partList) do
			if part.Parent then
				if active then
					part.CanCollide = false
				else
					local d = State.partDefaults[part]
					part.CanCollide = d == nil and true or d
				end
			end
		end
		State.noclipWas = active
	end))

	local wasFlying = false
	track(runService.Heartbeat:Connect(function(dt)
		if not Fn.alive() then
			return
		end
		local c = localPlayer.Character
		local root = c and c.PrimaryPart
		if not root then
			return
		end
		local bv, bg = Fn.getMovers()
		local flying = actions[2].enabled
		if flying then
			local cf = camera.CFrame
			local dir = Vector3.zero
			local k = userInputService
			if k:IsKeyDown(Enum.KeyCode.W) then
				dir += cf.LookVector
			end
			if k:IsKeyDown(Enum.KeyCode.S) then
				dir -= cf.LookVector
			end
			if k:IsKeyDown(Enum.KeyCode.D) then
				dir += cf.RightVector
			end
			if k:IsKeyDown(Enum.KeyCode.A) then
				dir -= cf.RightVector
			end
			if k:IsKeyDown(Enum.KeyCode.Space) then
				dir += Vector3.yAxis
			end
			if k:IsKeyDown(Enum.KeyCode.LeftShift) then
				dir -= Vector3.yAxis
			end
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			local speed = (sliders[3] and sliders[3].value or 3) * 45
			if dir.Magnitude > 0.01 then
				local step = dir.Unit * speed * (typeof(dt) == "number" and dt or 1 / 60)
				if State.flyStyle == "superman" then
					root.CFrame = CFrame.new(root.Position + step) * (cf.Rotation * CFrame.Angles(math.rad(-85), 0, 0))
				else
					local flat = Vector3.new(dir.X, 0, dir.Z)
					if flat.Magnitude < 0.01 then
						flat = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
					end
					if flat.Magnitude > 0.01 then
						local pos = root.Position + step
						root.CFrame = CFrame.lookAt(pos, pos + flat.Unit)
					else
						root.CFrame = root.CFrame + step
					end
				end
			end
			bv.Parent = nil
			bg.Parent = nil
			Fn.playFlightAnim(true)
			wasFlying = true
		else
			bv.Parent = nil
			bg.Parent = nil
			Fn.playFlightAnim(false)
			if wasFlying then
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
				wasFlying = false
			end
		end

		local h = Fn.humanoid()
		if State.speedBoost and h and h.MoveDirection.Magnitude > 0.08 and not flying and Fn.styleAnimId("run") then
			Fn.playRunAnim(true)
		else
			Fn.playRunAnim(false)
		end
	end))

	track(runService.Heartbeat:Connect(function()
		if not Fn.alive() then
			return
		end
		if Values.spatialshield then
			local threshold = tonumber(Values.spatialshieldthreshold) or 300
			for i = #State.soundList, 1, -1 do
				local s = State.soundList[i]
				if not s or not s.Parent then
					table.remove(State.soundList, i)
				elseif gameSettings.MasterVolume * s.PlaybackLoudness * s.Volume >= threshold then
					if s.Volume > 0.55 then
						State.suppressed[s.SoundId] = "S"
						s.Volume = 0.5
					elseif s.Volume > 0.2 then
						State.suppressed[s.SoundId] = "S2"
						s.Volume = 0.1
					else
						State.suppressed[s.SoundId] = "Mute"
						s.Volume = 0
					end
					if State.shieldCooldown == 0 then
						Fn.notify("Spatial Shield", "A high-volume audio (" .. s.Name .. ") was suppressed.", "warn")
						State.shieldCooldown = 15
					end
					table.remove(State.soundList, i)
				end
			end
		end
		if State.shieldCooldown > 0 then
			State.shieldCooldown -= 0.0167
			if State.shieldCooldown < 0 then
				State.shieldCooldown = 0
			end
		end
		local anon = Values.anonmode
		if anon then
			State.anonTick += 1
			if State.anonTick >= 15 then
				State.anonTick = 0
				for i = #State.textList, 1, -1 do
					local t = State.textList[i]
					if not t or not t.Parent then
						State.textSet[t] = nil
						table.remove(State.textList, i)
					elseif State.originalText[t] == nil then
						local raw = t.Text
						local lowered = string.lower(raw)
						if string.find(lowered, lowerName, 1, true) or string.find(lowered, lowerDisplay, 1, true) then
							State.originalText[t] = raw
							t.Text = Fn.replacePlain(Fn.replacePlain(raw, lowerName, randomName), lowerDisplay, randomName)
						end
					end
				end
			end
		elseif State.anonWas then
			for t, original in pairs(State.originalText) do
				t.Text = original
			end
			table.clear(State.originalText)
		end
		State.anonWas = anon
	end))

	track(game.DescendantAdded:Connect(function(inst)
		if Fn.alive() then
			pcall(Fn.registerDescendant, inst)
		end
	end))
	track(game.DescendantRemoving:Connect(function(inst)
		State.soundSet[inst] = nil
		State.textSet[inst] = nil
	end))

	task.spawn(function()
		while task.wait(1) do
			if not Fn.alive() then
				Fn.teardown()
				break
			end
			local ok, err = pcall(Fn.tick)
			if not ok then
				warn("Schweins Admin | update loop error: " .. tostring(err))
			end
		end
	end)
end

function Fn.teardown()
	pcall(function()
		W.espContainer:Destroy()
	end)
	for _, c in pairs(State.espConn) do
		c:Disconnect()
	end
	for _, c in ipairs(State.connections) do
		pcall(function()
			c:Disconnect()
		end)
	end
	table.clear(State.connections)
	pcall(function()
		for part in pairs(State.partList) do
			if part.Parent then
				local d = State.partDefaults[part]
				part.CanCollide = d == nil and true or d
			end
		end
	end)
	Fn.trackParts(nil)
	for t, original in pairs(State.originalText) do
		pcall(function()
			t.Text = original
		end)
	end
	pcall(Fn.restoreCamera)
	pcall(Fn.removeReverbs, 0.1)
	if setFpsCap then
		pcall(setFpsCap, 240)
	end
	pcall(function()
		gameSettings.MasterVolume = State.oldVolume or 1
	end)
	for _, n in ipairs({ "SchweinsNotifBlur", "SchweinsHomeBlur" }) do
		local b = lighting:FindFirstChild(n)
		if b then
			b:Destroy()
		end
	end
	for _, g in ipairs(State.cachedGui) do
		pcall(function()
			g.Enabled = true
		end)
	end
	for _, n in ipairs(State.cachedCore) do
		pcall(starterGui.SetCoreGuiEnabled, starterGui, Enum.CoreGuiType[n], true)
	end
end

