do
	local SAref, NTref = Fn.SA, Fn.NT
	if SAref and NTref then
		local circles = {}
		local farState = {}
		local LOD_FAR = 200
		local LOD_NEAR = 190

		for _, cat in ipairs(SettingDefs) do
			for i = #cat.items, 1, -1 do
				local label = string.lower(tostring(cat.items[i].name or ""))
				if string.find(label, "equip nametag", 1, true) then
					Values[cat.items[i].id] = nil
					table.remove(cat.items, i)
				end
			end
		end

		local function makeCircle(p, head)
			local g = Instance.new("BillboardGui")
			g.Name = "SchweinsTagFar"
			g.Size = UDim2.fromOffset(56, 56)
			g.StudsOffset = Vector3.new(0, 3.1, 0)
			g.AlwaysOnTop = true
			g.Active = true
			g.LightInfluence = 0
			g.ResetOnSpawn = false
			g.MaxDistance = 100000
			g.Adornee = head
			local btn = Instance.new("ImageButton")
			btn.Name = "Hit"
			btn.AnchorPoint = Vector2.new(0.5, 0.5)
			btn.Position = UDim2.fromScale(0.5, 0.5)
			btn.Size = UDim2.fromScale(1, 1)
			btn.BackgroundColor3 = Color3.fromRGB(12, 12, 18)
			btn.BackgroundTransparency = 0.15
			btn.BorderSizePixel = 0
			btn.AutoButtonColor = false
			btn.ScaleType = Enum.ScaleType.Crop
			btn.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(p.UserId) .. "&w=150&h=150"
			btn.Parent = g
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(1, 0)
			corner.Parent = btn
			local ring = Instance.new("UIStroke")
			ring.Thickness = 2
			ring.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			ring.Parent = btn
			reg(ring, "Color", "accent")
			btn.MouseButton1Click:Connect(function()
				if type(Fn.teleportTo) == "function" then
					pcall(Fn.teleportTo, p)
				end
			end)
			g.Parent = head
			return g
		end

		local function clearCircle(p)
			local c = circles[p]
			if c then
				pcall(function()
					c:Destroy()
				end)
				circles[p] = nil
			end
			farState[p] = nil
		end

		track(runService.Heartbeat:Connect((function()
			local acc = 0
			return function(dt)
				acc += dt
				if acc < 0.2 then
					return
				end
				acc = 0
				local cam = workspace.CurrentCamera
				local root = Fn.rootPart()
				local origin = root and root.Position or (cam and cam.CFrame.Position)
				if not origin then
					return
				end
				for p, tag in pairs(SAref.tags) do
					local g = tag.gui
					local head = g and g.Parent
					if head and head:IsA("BasePart") then
						local dist = (head.Position - origin).Magnitude
						local far = farState[p] == true
						if far then
							if dist < LOD_NEAR then
								far = false
							end
						elseif dist > LOD_FAR then
							far = true
						end
						farState[p] = far
						g.Enabled = not far
						local c = circles[p]
						if far then
							if not c or not c.Parent or c.Adornee ~= head then
								if c then
									c:Destroy()
								end
								c = makeCircle(p, head)
								circles[p] = c
							end
							c.Enabled = true
						elseif c then
							c.Enabled = false
						end
					end
				end
				for p in pairs(circles) do
					if not p.Parent or not SAref.tags[p] then
						clearCircle(p)
					end
				end
			end
		end)()))

		Fn.onCleanup(function()
			for p in pairs(circles) do
				clearCircle(p)
			end
		end)

		local origPlayReanim = Fn.playReanim
		if type(origPlayReanim) == "function" then
			function Fn.playReanim(query)
				local text = tostring(query or "")
				local id = text:match("^%s*(%d+)%s*$") or text:match("rbxassetid://(%d+)")
				if id and Fn.Anim and Fn.Anim.play then
					if Fn.Reanim and Fn.Reanim.active then
						Fn.stopReanim(true)
					end
					Fn.Anim.play(id, "Animation " .. id, "anim", { looped = not (Fn.Reanim and Fn.Reanim.loop == false) })
					Fn.notify("Reanim", "Playing " .. id .. " through your Animator, which other players can see.", "ok")
					return
				end
				local result = origPlayReanim(query)
				Fn.notify("Reanim", "Saved keyframe clips pose your joints locally. Only animation ids play for other players.", "info")
				return result
			end
		end
	end
end

