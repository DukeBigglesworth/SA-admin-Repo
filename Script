				say("M7 Flight", "Off", "info")
			end
		end

		local function startMfly(speed)
			local _, h, r = parts()
			if not (h and r) then
				return say("M7 Flight", "Your character isn't ready.", "warn")
			end
			stopFlightModes("mfly")
			stopMrun(true)
			stopMfly(true)
			local m = X.mfly
			if speed then
				m.speed = math.clamp(speed, 5, 600)
			end
			m.on = true
			m.slot = {}
			h.PlatformStand = true
			h.AutoRotate = false
			local bv = Instance.new("BodyVelocity")
			bv.MaxForce = Vector3.one * 9e9
			bv.P = 12500
			bv.Velocity = Vector3.zero
			bv.Parent = r
			local bg = Instance.new("BodyGyro")
			bg.MaxTorque = Vector3.one * 9e9
			bg.P = 40000
			bg.D = 1500
			bg.CFrame = r.CFrame
			bg.Parent = r
			m.bv, m.bg = bv, bg
			local vel = Vector3.zero
			local face = r.CFrame
			bind("mfly", runService.Heartbeat, function(dt)
				local _, h2, r2 = parts()
				if not (m.on and h2 and r2 and bv.Parent and bg.Parent) then
					stopMfly(true)
					return
				end
				local dir = steer(true)
				local moving = dir.Magnitude > 0.01
				local spd = m.speed
				if not typing() and down(keyCodes.LeftShift) then
					spd = spd * 1.5
				end
				vel = vel:Lerp(moving and dir.Unit * spd or Vector3.zero, math.min(dt * 8, 1))
				if vel.Magnitude < 0.35 then
					vel = Vector3.zero
				end
				bv.Velocity = vel
				local look = moving and dir.Unit or workspace.CurrentCamera.CFrame.LookVector
				face = face:Lerp(aim(r2.Position, look), math.min(dt * 6, 1))
				bg.CFrame = face
				setMotion(m.slot, "fly", moving)
			end)
			say("M7 Flight", "On - " .. m.speed .. " studs/s. Shift boosts, Space/E up, Q/Ctrl down.", "ok")
		end

		stopCfly = function(silent)
			local c = X.cfly
			if not c.on then
				return
			end
			c.on = false
			unbind("cfly")
			clearMotion(c.slot)
			local _, h, r = parts()
			if h then
