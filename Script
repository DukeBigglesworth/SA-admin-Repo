	function Fn.findCommand(name)
		local matches = {}
		for _, c in ipairs(Fn.Commands) do
			for _, n in ipairs(c.names) do
				if n == name then
					return c
				end
				if n:sub(1, #name) == name and not table.find(matches, c) then
					table.insert(matches, c)
				end
			end
		end
		if #matches == 1 then
			return matches[1]
		end
		return nil
	end

	function Fn.runCommand(text)
		if not State.ready then
			return false
		end
		text = tostring(text or "")
		text = text:gsub("^%s+", "")
		text = text:gsub("^;+", "")
		local parts = {}
		for w in text:gmatch("%S+") do
			parts[#parts + 1] = w
		end
		if #parts == 0 then
			return false
		end
		local name = string.lower(table.remove(parts, 1))
		local c = Fn.findCommand(name)
		if not c then
			Fn.notify("Unknown Command", "'" .. name .. "' isn't a command (or matches more than one). Type cmds for the list.", "warn")
			return false
		end
		local ok, err = pcall(c.run, parts)
		if not ok then
			Fn.notify("Command Error", name .. " failed: " .. tostring(err), "warn")
		end
		return ok
	end

