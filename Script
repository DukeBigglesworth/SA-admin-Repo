function Fn.readMic()
	local muted

	pcall(function()
		if Avcb.internal and typeof(Avcb.internal.IsMuted) == "function" then
			muted = Avcb.internal:IsMuted()
		end
	end)
	if typeof(muted) == "boolean" then
		return muted
	end
	pcall(function()
		local adi = localPlayer:FindFirstChildWhichIsA("AudioDeviceInput", true)
		if adi then
			if adi.Muted == true then
				muted = true
				return
			end
			if adi.Active == false then
				muted = true
				return
			end
			if adi.Muted == false and adi.Active ~= false then
				muted = false
			end
		end
	end)
	if typeof(muted) == "boolean" then
		return muted
	end
	return nil
end

function Fn.forceUnmute()
	local ok = false
	pcall(function()
		if Avcb.internal and Avcb.internal.PublishPause then
			Avcb.internal:PublishPause(false)
			ok = true
		end
	end)
	pcall(function()
		local adi = localPlayer:FindFirstChildWhichIsA("AudioDeviceInput", true)
		if adi then
			if adi.Muted ~= nil then
				adi.Muted = false
			end
			if adi.Active ~= nil then
				adi.Active = true
			end
			ok = true
		end
	end)
	return ok
end

function Fn.micLabel()
	local m = Fn.readMic()
	Avcb.mic = m
	if m == true then
		return "Muted"
	elseif m == false then
