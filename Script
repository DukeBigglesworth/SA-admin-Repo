local function applyWalkSpeed(on)
	local h = Fn.humanoid()
	if not h then
		return
	end
	local spec = Fn.Sliders[1]

	h.WalkSpeed = on and (spec and spec.value or 100) or 16
	if not on then
		local root = localPlayer.Character and localPlayer.Character.PrimaryPart
		if root then
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
		end
	end
end

local function applyJump(on)
	local h = Fn.humanoid()
	if not h then
		return
	end
	local spec = Fn.Sliders[2]
	local v = on and (spec and spec.value or 50) or (spec and spec.default or 50)
	if h.UseJumpPower then
		h.JumpPower = v
	else
		h.JumpHeight = v
	end
end

