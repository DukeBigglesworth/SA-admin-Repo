		local function readBands(a, pos)
			local out, spec, total = {}, nil, 0
			if viz.analyzer and not viz.fallback then
				local ok, s = pcall(viz.analyzer.GetSpectrum, viz.analyzer)
				if ok and type(s) == "table" and #s > 0 then spec = s end
			end
			if spec then
				local binHz = 24000 / #spec
				for i, e in ipairs(EDGES) do
					local lo = math.clamp(math.floor(e[1] / binHz) + 1, 1, #spec)
					local hi = math.clamp(math.floor(e[2] / binHz) + 1, lo, #spec)
					local peak = 0
					for b = lo, hi do
						local v = spec[b]
						if type(v) == "number" and v > peak then peak = v end
					end
					total += peak
					local db = 20 * math.log10(math.max(peak, 1e-5))
					out[i] = math.clamp((db + 62 + (i - 1) * 1.6) / 60, 0, 1)
				end
			end
			local loud = math.clamp((a.PlaybackLoudness or 0) / 450, 0, 1)
			if spec and total <= 0 and loud > 0.05 then
				viz.silentFrames += 1
				if viz.silentFrames > 120 then viz.fallback = true end
			elseif total > 0 then
				viz.silentFrames = 0
			end
			if not spec or viz.fallback then
				for i = 1, BANDS do
					local wob = 0.35 + 0.65 * math.abs(math.sin(pos * (2.3 + i * 1.7) + i * 1.3))
					out[i] = math.clamp(loud * wob * (1.15 - i * 0.07), 0, 1)
				end
			end
			return out
		end

