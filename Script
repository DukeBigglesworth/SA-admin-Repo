function Fn.applyShader(name)
	local p = presets[lower(name or "")]
	if not p then
		return false
	end
	for prop, v in pairs(p.bloom) do
		effect("BloomEffect", "SchweinsBloom")[prop] = v
	end
	for prop, v in pairs(p.cc) do
		effect("ColorCorrectionEffect", "SchweinsCC")[prop] = v
	end
	for prop, v in pairs(p.rays) do
		effect("SunRaysEffect", "SchweinsRays")[prop] = v
	end
	return true
end

