local function httpGet(url)
	local req = request or http_request or (syn and syn.request) or (http and http.request)
	if not req then
		return nil, "Your executor has no request function."
	end
	local ok, res = pcall(req, { Url = url, Method = "GET" })
	if not ok or type(res) ~= "table" then
		return nil, "The request failed."
	end
	if res.StatusCode and res.StatusCode >= 400 then
		return nil, "The link returned " .. tostring(res.StatusCode) .. "."
	end
	return res.Body
end

local function validate(raw)
	raw = tostring(raw or "")
	if #raw < 10 then
		return nil
	end
	if string.find(raw, "CFrame", 1, true) or string.find(raw, "return", 1, true) then
		local ok, tab = pcall(Fn.kfParseLua, raw)
		if ok and type(tab) == "table" then
			if tab[1] and type(tab[1]) == "table" and tab[1].Data then
				return "lua", #tab
			end
			for _, v in pairs(tab) do
				if type(v) == "table" and v[1] and (v[1].Time or v[1].Data) then
					return "lua", #v
				end
			end
		end
		return nil
	end
	local ok, d = pcall(httpService.JSONDecode, httpService, raw)
	if ok and type(d) == "table" and type(d.frames) == "table" then
		return "json", #d.frames
	end
	return nil
end

local function cleanName(n)
	n = tostring(n or ""):gsub("[^%w _%-%.]", ""):gsub("^%s+", ""):gsub("%s+$", "")
	n = string.sub(n, 1, 40)
	n = n:gsub("%.lua$", ""):gsub("%.json$", ""):gsub("%.txt$", "")
	return n
end

local function addEntry(name, raw)
	if not writefile then
		Fn.notify("Keyframes", "Your executor can't write files.", "warn")
		return false
	end
	local kind, count = validate(raw)
	if not kind then
		Fn.notify("Keyframes", "That isn't a keyframe animation I can read.", "warn")
		return false
	end
	name = cleanName(name)
	if name == "" then
		name = "keyframes " .. os.date("%H-%M-%S")
	end
	local file = name .. (kind == "lua" and ".lua" or ".json")
	local ok = pcall(writefile, folder() .. "/" .. file, raw)
	if not ok then
		Fn.notify("Keyframes", "Couldn't save the file.", "warn")
		return false
	end
	Fn.notify("Keyframes", "Added " .. name .. " (" .. count .. " keyframes).", "ok")
	return true
end

local function durationOf(frames)
	local last = frames[#frames]
	return last and tonumber(last.Time) or 0
end

