Fn.cmd("Utility", { "repeat", "loopcmd" }, "repeat <times> <seconds> <command>", "Run a command on a timer (times 0 = forever)", function(args)
	local times, secs = tonumber(args[1]), tonumber(args[2])
	if not times or not secs or #args < 3 then
		return Fn.notify("Repeat", "Usage: repeat <times> <seconds> <command...>", "warn")
	end
	local text = table.concat(args, " ", 3)
	local token = {}
	Mod.repeaters[#Mod.repeaters + 1] = token
	task.spawn(function()
		local n = 0
		while not token.stop and Fn.alive() and (times == 0 or n < times) do
			n += 1
			Fn.runCommand(text)
			task.wait(math.max(secs, 0.05))
		end
	end)
	Fn.notify("Repeat", "Running '" .. text .. "'. Use stoprepeat to cancel.", "ok")
end)

