local function avcbSet(text, tone)
	Avcb.status = text
	if W.homeValues and W.homeValues.AvcbStatus then
		W.homeValues.AvcbStatus.Text = text
		if tone == "bad" then
			W.homeValues.AvcbStatus.TextColor3 = Color3.fromRGB(255, 90, 90)
		elseif tone == "ok" then
			W.homeValues.AvcbStatus.TextColor3 = Color3.fromRGB(90, 220, 140)
		elseif tone == "warn" then
			W.homeValues.AvcbStatus.TextColor3 = Color3.fromRGB(255, 180, 60)
		end
	end
end

function Fn.runAvcb()
	if Avcb.loading or Avcb.active then
		return
	end
	if not getConnectionsFor then
		Fn.notify("AVCB", "your unc is too low get a better executor", "warn")
		avcbSet("UNC too low", "bad")
		return
	end
	if not Avcb.voice then
		Fn.notify("AVCB", "Voice chat isn't available in this session.", "warn")
		avcbSet("No voice service", "bad")
		return
	end
	if Fn.readMic() == true then
		Fn.notify("AVCB", "Unmute first, then run Anti VC Ban.", "warn")
		avcbSet("Unmute first", "bad")
		return
	end

	Avcb.loading = true
	avcbSet("Starting…", "warn")

	task.spawn(function()
		local function fail(msg)
			Avcb.loading = false
			Avcb.active = false
			avcbSet(msg, "bad")
			Fn.notify("AVCB", msg, "warn")
		end

		avcbSet("Confirming unmuted…", "warn")
		task.wait(3)
		local t0 = os.clock()
		while os.clock() - t0 < 120 do
			if Fn.readMic() == false then
				break
			end
			task.wait(0.5)
		end
		if Fn.readMic() == true then
			fail("Still muted. Unmute and try again.")
			return
		end

		avcbSet("Leaving voice…", "warn")
		pcall(function()
			Avcb.voice:leaveVoice()
		end)
		task.wait(2)

		avcbSet("Clearing hooks…", "warn")
		local disabled = 0
		pcall(function()
			if Avcb.internal and Avcb.internal.StateChanged then
				local conns = getConnectionsFor(Avcb.internal.StateChanged)
				if type(conns) == "table" then
					for i = 7, #conns do
						if conns[i] then
							pcall(function()
								conns[i]:Disable()
								disabled += 1
							end)
						end
					end
				end
			end
		end)
		avcbSet("Cleared " .. tostring(disabled) .. " hooks", "warn")
		task.wait(2)

		avcbSet("Rejoining voice…", "warn")
		task.wait(1)
		local joinDone, joinOk = false, false
		local joinWait = os.clock()
		task.spawn(function()
			joinOk = pcall(function()
				Avcb.voice:joinVoice()
			end)
			joinDone = true
		end)
		while not joinDone and os.clock() - joinWait < 8 do
			task.wait(0.1)
		end
		task.wait(2)

		avcbSet("Waiting for voice…", "warn")
		local reconnected = false
		local deadline = os.clock() + 20
		local stateConn
		pcall(function()
			if Avcb.internal and Avcb.internal.StateChanged then
				stateConn = Avcb.internal.StateChanged:Connect(function(_, new)
					local n = string.lower(tostring(new and (new.Name or new) or ""))
					if n:find("join", 1, true) or n:find("connect", 1, true) or n:find("ingame", 1, true) or n:find("active", 1, true) or n:find("joined", 1, true) then
						reconnected = true
					end
				end)
			end
		end)
		while os.clock() < deadline and not reconnected do
			pcall(function()
				local st = Avcb.internal and Avcb.internal.VoiceChatState
				if st then
					local n = string.lower(tostring(st.Name or st))
					if n:find("join", 1, true) or n:find("connect", 1, true) or n:find("ingame", 1, true) or n:find("joined", 1, true) then
						reconnected = true
					end
				end
			end)
			pcall(function()
				if localPlayer:FindFirstChildWhichIsA("AudioDeviceInput", true) then
					reconnected = true
				end
			end)
			if joinDone and joinOk and os.clock() > joinWait + 1.25 then
				reconnected = true
			end
			task.wait(0.2)
		end
		pcall(function()
			if stateConn then
				stateConn:Disconnect()
			end
		end)

		Avcb.loading = false
		Avcb.active = true
		if reconnected then
			avcbSet("Active — don't mute", "ok")
			Fn.notify("AVCB on", "Don't mute while it's active.", "ok")
		else
			avcbSet("Active (voice quiet)", "warn")
			Fn.notify("AVCB", "Cycle finished. Still — don't mute.", "info")
		end
	end)
end

