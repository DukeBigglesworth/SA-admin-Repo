function Fn.rejoin()
	Fn.notify("Rejoining Session", "We're queueing a rejoin to this session, give us a moment.", "info")
	if #players:GetPlayers() <= 1 then
		task.wait()
		teleportService:Teleport(placeId, localPlayer)
	else
		teleportService:TeleportToPlaceInstance(placeId, jobId, localPlayer)
	end
end

function Fn.serverhop()
	local ok, response = pcall(function()
		return httpService:JSONDecode(game:HttpGetAsync("https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"))
	end)
	if not ok or type(response) ~= "table" or not response.data then
		return Fn.notify("Unable to find servers", "Couldn't reach the Roblox server list, this is usually rate limiting. Try again shortly.", "warn")
	end
	local best, target = 0, nil
	for _, v in ipairs(response.data) do
		if type(v) == "table" and v.maxPlayers > v.playing and v.id ~= jobId and v.playing > best then
			best, target = v.playing, v.id
		end
	end
	if not target then
		return Fn.notify("No Servers Found", "We couldn't find another server, this may be the only one.", "warn")
	end
	Fn.notify("Teleporting", "Moving you to a new session, this may take a few seconds.", "info")
	task.wait(0.3)
	if not pcall(teleportService.TeleportToPlaceInstance, teleportService, placeId, target) then
		Fn.notify("Teleport Failed", "Roblox refused the teleport. Try again in a moment.", "warn")
	end
end

function Fn.leaveExperience()
	if pcall(function()
		game:Shutdown()
	end) then
		return
	end
	if pcall(teleportService.Teleport, teleportService, 0, localPlayer) then
		return
	end
	Fn.notify("Unable to leave", "Couldn't close the experience from here, you'll need to leave manually.", "warn")
end

