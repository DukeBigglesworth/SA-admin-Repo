local function folderPath(sub)
	return CONFIG.Folder .. (sub and ("/" .. sub) or "")
end

function Fn.ensureFolders()
	if not (isfolder and makefolder) then
		return
	end
	for _, path in ipairs({ folderPath(), folderPath("Music"), folderPath("Scripts") }) do
		if not isfolder(path) then
			pcall(makefolder, path)
		end
	end
end

function Fn.saveSettings()
	if not writefile then
		return
	end
	Fn.ensureFolders()
	local ok, encoded = pcall(httpService.JSONEncode, httpService, Values)
	if ok then
		pcall(writefile, folderPath("settings.json"), encoded)
	end
end

function Fn.loadSettings()
	if not (isfile and readfile) then
		return
	end
	local ok, data = pcall(function()
		if isfile(folderPath("settings.json")) then
			return httpService:JSONDecode(readfile(folderPath("settings.json")))
		end
	end)
	if ok and type(data) == "table" then
		for k, v in pairs(data) do
			if Values[k] ~= nil and typeof(v) == typeof(Values[k]) then
				Values[k] = v
			end
		end
	end
end

function Fn.saveLibrary()
	if not writefile then
		return
	end
	Fn.ensureFolders()
	local ok, encoded = pcall(httpService.JSONEncode, httpService, State.library)
	if ok then
		pcall(writefile, folderPath("library.json"), encoded)
