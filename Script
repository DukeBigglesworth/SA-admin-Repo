function Fn.makeSlider(parent, o)
	local z = o.z or 5
	local f = new("Frame", { Position = o.pos, Size = o.size, BorderSizePixel = 0, BackgroundTransparency = 0.82, ZIndex = z, ClipsDescendants = true }, parent)
	reg(f, "BackgroundColor3", "accent")
	round(f, 8)
	reg(stroke(f, nil, 0.55, 1), "Color", "accent")
	local prog = new("Frame", { Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, BackgroundTransparency = 0.35, ZIndex = z }, f)
	reg(prog, "BackgroundColor3", "accent")
	local lbl = ttxt(f, { Size = UDim2.fromScale(1, 1), TextSize = 11, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = z + 1, Font = Enum.Font.GothamMedium }, "text")
	local dec = o.decimals or 0
	local obj = { min = o.min, max = o.max, value = o.value, frame = f }
	local function fmt(v)
		if dec == 0 then
			return tostring(floor(v + 0.5))
		end
		return format("%." .. dec .. "f", v)
	end
	function obj.set(v, silent)
		v = clamp(v, o.min, o.max)
		obj.value = v
		lbl.Text = (o.label and (o.label .. "  ") or "") .. fmt(v)
		prog.Size = UDim2.fromScale((v - o.min) / math.max(o.max - o.min, 1e-6), 1)
		if o.callback and not silent then
			o.callback(v)
		end
	end
	function obj.updateX(x)
		local a = clamp((x - f.AbsolutePosition.X) / math.max(f.AbsoluteSize.X, 1), 0, 1)
		local v = o.min + (o.max - o.min) * a
		local m = 10 ^ dec
		obj.set(floor(v * m + 0.5) / m)
	end
	local hit = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = z + 2 }, f)
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			Fn.dragSlider = obj
			obj.updateX(input.Position.X)
		end
	end)
	obj.set(o.value, true)
	return obj
end

function Fn.pickList(title, items, current, onPick)
	local card, close = Fn.promptCard(380, 460)
	ttxt(card, { Position = UDim2.fromOffset(20, 14), Size = UDim2.new(1, -60, 0, 22), Text = title, TextSize = 15, Font = Enum.Font.GothamBold, ZIndex = 3 }, "text")
	local x = new("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 10), Size = UDim2.fromOffset(28, 28), Text = "", BackgroundTransparency = 1, ZIndex = 5 }, card)
	Fn.icon(x, "close", 14, "muted")
	x.MouseButton1Click:Connect(close)
	local box = Fn.makeInput(card, UDim2.fromOffset(20, 48), UDim2.new(1, -40, 0, 32), "Search", "", 3)
	local list = new("ScrollingFrame", {
		Position = UDim2.fromOffset(20, 90), Size = UDim2.new(1, -40, 1, -106), BackgroundTransparency = 1, BorderSizePixel = 0, CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 2, ZIndex = 3,
	}, card)
	reg(list, "ScrollBarImageColor3", "accent")
	new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	local function render()
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("GuiObject") then
				c:Destroy()
			end
		end
		local q = lower(box.Text)
		local shown = 0
		for i, item in ipairs(items) do
			if q == "" or string.find(lower(item.name), q, 1, true) then
				shown += 1
				if shown > 120 then
					break
				end
				local on = item.id == current
				local b = Fn.tile(list, { Size = UDim2.new(1, -6, 0, 30), corner = 8, ZIndex = 4 }, on and "tileHover" or "tile")
				b.LayoutOrder = i
				ttxt(b, { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0), Text = item.name, TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 5, Font = on and Enum.Font.GothamBold or Enum.Font.GothamMedium }, on and "accent" or "text")
				Fn.hoverTile(b, 1.02)
				b.MouseButton1Click:Connect(function()
					Fn.playSound("Click")
					close()
					onPick(item)
				end)
			end
		end
	end
	box:GetPropertyChangedSignal("Text"):Connect(render)
	render()
	task.defer(function()
		box:CaptureFocus()
	end)
end

