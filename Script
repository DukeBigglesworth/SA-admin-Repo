function Fn.checkFriends()
	if (State.friendsCooldown or 0) > 0 then
		State.friendsCooldown -= 1
		return
	end
	State.friendsCooldown = 25
	task.spawn(function()
		local all = {}
		local ok, page = pcall(players.GetFriendsAsync, players, localPlayer.UserId)
		if ok then
			repeat
				for _, f in pairs(page:GetCurrentPage()) do
					all[#all + 1] = f
				end
				if not page.IsFinished then
					page:AdvanceToNextPageAsync()
				end
			until page.IsFinished
		end
		local online, ingame = 0, 0
		for _, f in ipairs(all) do
			if f.IsOnline then
				online += 1
			end
			if players:FindFirstChild(f.Username) then
				ingame += 1
			end
		end
		if Fn.alive() then
			W.homeValues["FriendsAll"].Text = #all .. " friends"
			W.homeValues["FriendsOnline"].Text = online .. " friends"
			W.homeValues["FriendsOffline"].Text = (#all - online) .. " friends"
			W.homeValues["FriendsIn Game"].Text = ingame .. " friends"
		end
	end)
end

function Fn.updateHome()
	if not (Fn.alive() and State.homeOpen and W.homeValues) then
		return
	end
	local function set(k, v)
		local l = W.homeValues[k]
		if l then
			l.Text = tostring(v)
		end
	end
	local ping = Fn.ping()
	local mem = 0
	pcall(function()
		mem = statsService:GetTotalMemoryUsageMb()
	end)
	local t = time()
	local greet = (type(Values.welcomeName) == "string" and Values.welcomeName ~= "") and Values.welcomeName or localPlayer.DisplayName
	W.homeTitle.Text = "Welcome home, " .. greet
	set("ServerPlayers", #players:GetPlayers() .. " playing")
	set("ServerMax Players", players.MaxPlayers)
	set("ServerLatency", math.floor(ping) .. "ms")
	set("ServerSession Time", string.format("%02d:%02d:%02d", t // 3600, (t % 3600) // 60, t % 60))
	set("ServerPlace ID", placeId)
	set("PlayerAccount Age", localPlayer.AccountAge .. " days")
	set("PlayerUser ID", localPlayer.UserId)
	local name
	if getExecutorName then
		local ok, n = pcall(getExecutorName)
		name = ok and type(n) == "string" and #n > 0 and n or nil
	end
	set("ClientExecutor", name or "Unknown")
	set("ClientSupport", name and "Detected" or "Unidentified")
	set("ClientVersion", CONFIG.Version)
	set("PerformanceFPS", math.floor(State.fps))
	set("PerformancePing", math.floor(ping) .. "ms")
	set("PerformanceMemory", math.floor(mem) .. " MB")
	set("AvcbMic", Fn.micLabel())
	set("AvcbStatus", Avcb.status)
	Fn.checkFriends()
end

local function hideGameUI()
	State.cachedGui = {}
	for _, g in ipairs(playerGui:GetChildren()) do
		if g:IsA("ScreenGui") and g.Enabled and g ~= gui then
			State.cachedGui[#State.cachedGui + 1] = g
			g.Enabled = false
		end
	end
	State.cachedCore = {}
	for _, name in ipairs({ "PlayerList", "Chat", "EmotesMenu", "Health", "Backpack" }) do
		local ok, enabled = pcall(starterGui.GetCoreGuiEnabled, starterGui, Enum.CoreGuiType[name])
		if ok and enabled then
			State.cachedCore[#State.cachedCore + 1] = name
			pcall(starterGui.SetCoreGuiEnabled, starterGui, Enum.CoreGuiType[name], false)
		end
	end
end

local function restoreGameUI()
	for _, g in ipairs(State.cachedGui) do
		if g.Parent then
			g.Enabled = true
		end
	end
	State.cachedGui = {}
	for _, name in ipairs(State.cachedCore) do
		pcall(starterGui.SetCoreGuiEnabled, starterGui, Enum.CoreGuiType[name], true)
	end
	State.cachedCore = {}
end

function Fn.setHome(open)
	if State.homeOpen == open then
		return
	end
	State.homeOpen = open
	if open then
		Fn.closeAllPanels()
		W.home.Visible = true
		Fn.updateHome()
		W.homeBlur = W.homeBlur or new("BlurEffect", { Size = 0, Name = "SchweinsHomeBlur" }, lighting)
		tween(W.homeBlur, 0.7, { Size = HOME_BLUR })
		tween(W.home, 0.5, { BackgroundTransparency = HOME_DIM })
		for i, c in ipairs(W.homeCards) do
			c.card.Position = c.pos + UDim2.fromOffset(0, c.dy)
			task.delay(0.04 + i * 0.07, function()
				if State.homeOpen and c.card.Parent then
					tween(c.card, 0.6, { GroupTransparency = 0 })
					tween(c.card, 0.9, { Position = c.pos }, Enum.EasingStyle.Back)
				end
			end)
		end
		if HIDE_GAME_UI then
			hideGameUI()
		end
		Fn.playSound("Open", 1, 0.8)
	else
		if W.homeBlur then
			tween(W.homeBlur, 0.5, { Size = 0 })
		end
		tween(W.home, 0.5, { BackgroundTransparency = 1 })
		for _, c in ipairs(W.homeCards) do
			tween(c.card, 0.4, { GroupTransparency = 1 })
		end
		restoreGameUI()
		Fn.playSound("Close", 1, 0.8)
		task.delay(0.55, function()
			if not State.homeOpen then
				W.home.Visible = false
			end
		end)
	end
end

function Fn.createReverb(timing)
	for _, sound in ipairs(State.soundList) do
		if sound.Parent and not sound:FindFirstChild("SchweinsAudioProfile") then
			local eq = Instance.new("EqualizerSoundEffect")
			eq.Name = "SchweinsAudioProfile"
			eq.HighGain, eq.LowGain, eq.MidGain = 0, 0, 0
			eq.Parent = sound
			tween(eq, timing, { HighGain = -20, LowGain = 5, MidGain = -20 }, Enum.EasingStyle.Exponential)
		end
	end
end

function Fn.removeReverbs(timing)
	for _, sound in ipairs(State.soundList) do
		local eq = sound:FindFirstChild("SchweinsAudioProfile")
		if eq then
			tween(eq, timing, { HighGain = 0, LowGain = 0, MidGain = 0 }, Enum.EasingStyle.Exponential)
			task.delay(timing + 0.05, function()
				eq:Destroy()
			end)
		end
	end
end

function Fn.playNext()
	State.playGen += 1
	local gen = State.playGen
	while true do
		if #State.musicQueue == 0 then
			if W.currentAudio then
				W.currentAudio.Playing = false
				W.currentAudio.SoundId = ""
			end
			W.nowPlaying.Text = "Not Playing"
			return
		end
		if not W.currentAudio then
			W.currentAudio = new("Sound", { Name = "Audio", Volume = tonumber(Values.musicVolume) or 0.5 }, gui)
		end
		local entry = State.musicQueue[1]
		local ok, asset = pcall(getCustomAsset, folderPath("Music") .. "/" .. entry.sound)
		if not ok or not asset then
			Fn.notify("Unable to play file", entry.sound .. " could not be loaded and was skipped.", "warn")
			table.remove(State.musicQueue, 1)
			Fn.refreshQueue()
			continue
		end
		if Values.nowplaying then
			Fn.notify("Now Playing", entry.sound, "info")
		end
		W.currentAudio.SoundId = asset
		W.nowPlaying.Text = entry.sound
		W.currentAudio:Play()
		Fn.refreshQueue()
		W.currentAudio.Ended:Wait()
		if gen ~= State.playGen then
			return
		end
		table.remove(State.musicQueue, 1)
		Fn.refreshQueue()
	end
end

function Fn.refreshQueue()
	if not W.queueList then
		return
	end
	for _, c in ipairs(W.queueList:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	for i, entry in ipairs(State.musicQueue) do
		local row = new("Frame", { Size = UDim2.new(1, -6, 0, 38), BorderSizePixel = 0, LayoutOrder = i, ZIndex = 3 }, W.queueList)
		reg(row, "BackgroundColor3", i == 1 and "tileHover" or "tile")
		round(row, 10)
		ttxt(row, { Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -60, 1, 0), Text = entry.sound, TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 4 }, i == 1 and "text" or "muted")
		local rm = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(26, 26), Text = "", BackgroundTransparency = 1, ZIndex = 5 }, row)
		Fn.icon(rm, "close", 14, "muted")
		rm.MouseButton1Click:Connect(function()
			local wasCurrent = State.musicQueue[1] == entry
			for idx, e in ipairs(State.musicQueue) do
				if e == entry then
					table.remove(State.musicQueue, idx)
					break
				end
			end
			Fn.refreshQueue()
			if wasCurrent then
				task.spawn(Fn.playNext)
			end
		end)
	end
end

function Fn.onSetting(id, v)
	Values[id] = v
	Fn.saveSettings()
	if id == "demon" then
		Fn.applyTheme(v and "demon" or "ice", 0.9)
	elseif id == "hidetoggle" then
		W.chevron.Visible = not v
	elseif id == "embers" then
