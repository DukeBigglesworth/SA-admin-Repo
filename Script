	function Fn.listKeyframeFiles()
		local out = {}
		local seen = {}
		if Fn.BuiltinKeyframes then
			for name in pairs(Fn.BuiltinKeyframes) do
				local n = tostring(name)
				if not seen[n] then
					seen[n] = true
					out[#out + 1] = n
				end
			end
		end
		if listFiles then
			local ok, files = pcall(listFiles, kfFolder())
			if ok and type(files) == "table" then
				for _, path in ipairs(files) do
					local name = tostring(path):match("([^/\\]+)$")
					if name and (name:lower():match("%.json$") or name:lower():match("%.lua$") or name:lower():match("%.txt$")) then
						if not seen[name] then
							seen[name] = true
							out[#out + 1] = name
						end
					end
				end
			end
		end
		table.sort(out)
		return out
	end

	local function jointsOf(char)
		local map, folded = {}, {}
		local function add(name, joint)
			if not name or name == "" then return end
			map[name] = joint
			folded[string.lower(tostring(name)):gsub("[^%w]", "")] = joint
		end
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("Motor6D") or d:IsA("AnimationConstraint") then
				add(d.Name, d)
				local part1
				pcall(function() part1 = d.Part1 end)
				if not part1 and d:IsA("AnimationConstraint") then
					local attachment = d.Attachment1
					part1 = attachment and attachment.Parent
				end
				if part1 then add(part1.Name, d) end
			end
		end
		return map, folded
	end

	local function findJoint(name)
		local key = tostring(name or "")
		local joints = Reanim.joints or {}
		return joints[key] or (Reanim.foldedJoints and Reanim.foldedJoints[string.lower(key):gsub("[^%w]", "")])
	end

	local function poseCFrame(value)
		if typeof(value) == "CFrame" then return value end
		if type(value) ~= "table" then return nil end
		if #value >= 12 then
			return CFrame.new(table.unpack(value, 1, 12))
		elseif #value >= 7 then
			return CFrame.new(value[1], value[2], value[3], value[4], value[5], value[6], value[7])
		elseif #value >= 6 then
			return CFrame.new(value[4], value[5], value[6]) * CFrame.fromOrientation(math.rad(value[1]), math.rad(value[2]), math.rad(value[3]))
		end
	end

	local function normaliseFrames(frames)
		local out = {}
		for _, fr in ipairs(frames or {}) do
			local time = type(fr) == "table" and tonumber(fr.Time or fr.time or fr.t)
			if time then
				local data = {}
				local source = type(fr.Data) == "table" and fr.Data or fr.poses
				if type(source) == "table" then
					for joint, value in pairs(source) do
						local cf = poseCFrame(value)
						if cf then data[joint] = cf end
					end
				end
				out[#out + 1] = { Time = time, Data = data }
			end
		end
		table.sort(out, function(a, b) return a.Time < b.Time end)
		return out
	end

	local function readPoses(pose, out)
		for _, child in ipairs(pose:GetChildren()) do
			if child:IsA("Pose") then
				if child.Weight > 0 then out[child.Name] = child.CFrame end
				readPoses(child, out)
			end
		end
	end

	local function framesFromAssetId(id)
		local seq
		pcall(function()
			for _, obj in ipairs(game:GetObjects("rbxassetid://" .. id)) do
				if obj:IsA("KeyframeSequence") then seq = obj break end
				local inner = obj:FindFirstChildWhichIsA("KeyframeSequence", true)
				if inner then seq = inner break end
			end
		end)
		if not seq then
			pcall(function()
				seq = game:GetService("KeyframeSequenceProvider"):GetKeyframeSequenceAsync("rbxassetid://" .. id)
			end)
		end
		if not seq then return nil end
		local frames = {}
		for _, k in ipairs(seq:GetKeyframes()) do
			local data = {}
			readPoses(k, data)
			frames[#frames + 1] = { Time = k.Time, Data = data }
		end
		return normaliseFrames(frames), seq.Loop
	end

	local function resolveClip(query)
		query = tostring(query or "")
		local lib = Fn.BuiltinKeyframes
		local frames, loop, label
		if lib then
			frames = lib[query]
			label = query
			if not frames then
				local low = query:lower()
				for name, fr in pairs(lib) do
					if tostring(name):lower() == low or tostring(name):lower():find(low, 1, true) then
						frames, label = fr, tostring(name)
						break
					end
				end
			end
		end
		if frames then return normaliseFrames(frames), true, label end
		local id = query:match("^%s*(%d+)%s*$") or query:match("rbxassetid://(%d+)") or query:match("[?&]id=(%d+)")
		if id then
			local f, lp = framesFromAssetId(id)
			if f and #f > 0 then return f, lp ~= false, "animation " .. id end
			return nil, nil, nil, "Couldn't read keyframes from " .. id .. " (Roblox only exposes animations you own or that are free)."
		end
		if not (isfile and readfile) then return nil, nil, nil, "No library match for '" .. query .. "'." end
		local path = kfFolder() .. "/" .. query
		if not isfile(path) then
			for _, ext in ipairs({ ".json", ".lua", ".txt" }) do
				if isfile(path .. ext) then path = path .. ext break end
			end
		end
		if not isfile(path) then return nil, nil, nil, "No animation called '" .. query .. "'. Try 'reanim list'." end
		local raw = readfile(path)
		local ok, parsed = pcall(function()
			if raw:find("return", 1, true) or raw:find("CFrame", 1, true) then
				local tab
				if Fn.kfParseLua then
					local okp, res = pcall(Fn.kfParseLua, raw)
					if okp then tab = res end
				end
				if not tab then
					local fn, err = loadstring(raw)
					if not fn then error(err) end
					tab = fn()
				end
				if type(tab) == "table" then
					if tab[1] and (tab[1].Data or tab[1].Time) then return tab end
					for _, v in pairs(tab) do
						if type(v) == "table" and v[1] and (v[1].Time or v[1].Data) then return v end
					end
					if type(tab.frames) == "table" then return tab.frames end
				end
				error("no frames")
			end
			local decoded = httpService:JSONDecode(raw)
			return decoded.frames or decoded.keyframes or decoded
		end)
		if not ok then return nil, nil, nil, "Couldn't read " .. query .. " as a keyframe file." end
		local f = normaliseFrames(parsed)
		if #f == 0 then return nil, nil, nil, query .. " has no usable frames." end
		return f, true, query
	end

	local function sampleClip(clip, t, out)
		local frames = clip.frames
		local n = #frames
		if n == 1 or t <= frames[1].Time then
			for j, cf in pairs(frames[1].Data) do out[j] = cf end
			return
		end
		if t >= frames[n].Time then
			for j, cf in pairs(frames[n].Data) do out[j] = cf end
			return
		end
		local lo, hi = 1, n
		while hi - lo > 1 do
			local mid = (lo + hi) // 2
			if frames[mid].Time <= t then lo = mid else hi = mid end
		end
		local a, b = frames[lo], frames[hi]
		local span = b.Time - a.Time
		local alpha = span > 0 and (t - a.Time) / span or 0
		for j, cfa in pairs(a.Data) do
			local cfb = b.Data[j]
			out[j] = cfb and cfa:Lerp(cfb, alpha) or cfa
		end
	end

	local function stopTracks(h)
		if not h then return end
		for _, t in ipairs(h:GetPlayingAnimationTracks()) do
			pcall(function() t:Stop(0) end)
		end
	end

	local function driveStep(dt)
		local c = Reanim.char
		if not (Reanim.active and c and c.Parent) then
			return Fn.stopReanim(true)
		end
		if localPlayer.Character ~= c then
			return Fn.stopReanim(true)
		end
		local h = c:FindFirstChildOfClass("Humanoid")
		local animate = c:FindFirstChild("Animate")
		if animate then
			animate.Disabled = true
			Reanim.animate = animate
		end
		if h then
			for _, tr in ipairs(h:GetPlayingAnimationTracks()) do
				pcall(function()
					tr:Stop(0)
				end)
			end
			local animator = h:FindFirstChildOfClass("Animator")
			if animator then
				for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
					pcall(function()
						tr:Stop(0)
					end)
				end
			end
		end
		if Reanim.playing and Reanim.clip then
			local len = Reanim.clip.length or 0
			local nextTime = Reanim.time + (dt or 0.016) * (Reanim.speed or 1)
			if len > 0 then
				if Reanim.loop then
					nextTime = ((nextTime % len) + len) % len
				elseif nextTime >= len then
					nextTime, Reanim.playing = len, false
				elseif nextTime <= 0 then
					nextTime, Reanim.playing = 0, false
				end
			end
			Reanim.time = nextTime
			table.clear(Reanim.pose)
			sampleClip(Reanim.clip, Reanim.time, Reanim.pose)
		end
		local studio = Fn.KF
		for name, cf in pairs(Reanim.pose) do
			if typeof(cf) == "CFrame" then
				local j = findJoint(name)
				if j and j.Parent and not Reanim.override[name] then
					if not (studio and studio.engaged and studio.pose and studio.pose[name]) then
						j.Transform = cf
					end
				end
			end
		end
		for name, cf in pairs(Reanim.override) do
			if typeof(cf) == "CFrame" then
				local j = findJoint(name)
				if j and j.Parent then
					j.Transform = cf
				end
			end
		end
	end

	function Fn.reanimTakeControl(onReady)
		if Reanim.active and Reanim.char == localPlayer.Character then
			if onReady then task.defer(onReady) end
			return
		end
		Reanim.pendingCallbacks = Reanim.pendingCallbacks or {}
		if onReady then Reanim.pendingCallbacks[#Reanim.pendingCallbacks + 1] = onReady end
		if Reanim.pending then return end
		Reanim.pending = true
		Reanim.token += 1
		local token = Reanim.token
		Fn.stopReanim(true)
		Reanim.pending = true
		task.spawn(function()
			local c = localPlayer.Character
			if not c then c = localPlayer.CharacterAdded:Wait() end
			if token ~= Reanim.token then return end
			local hum = c:FindFirstChildOfClass("Humanoid") or c:WaitForChild("Humanoid", 10)
			c:WaitForChild("HumanoidRootPart", 10)
			if not hum then
				Reanim.pending = false
				Reanim.pendingCallbacks = {}
				return Fn.notify("Reanim", "Your character never loaded.", "warn")
			end
			task.wait(0.05)
			if token ~= Reanim.token or localPlayer.Character ~= c then
				Reanim.pending = false
				return
			end
			local joints, folded = jointsOf(c)
			local unique, count = {}, 0
			for _, joint in pairs(joints) do
				if not unique[joint] then unique[joint] = true; count += 1 end
			end
			if count == 0 then
				Reanim.pending = false
				Reanim.pendingCallbacks = {}
				return Fn.notify("Reanim", "No supported animation joints were found on this avatar.", "warn")
			end
			local animate = c:FindFirstChild("Animate")
			if animate then animate.Disabled = true end
			for _, d in ipairs(c:GetDescendants()) do
				if d:IsA("Animator") then
					for _, tr in ipairs(d:GetPlayingAnimationTracks()) do
						pcall(function() tr:Stop(0) end)
					end
				end
			end
			stopTracks(hum)
			Reanim.char, Reanim.animate = c, animate
			Reanim.joints, Reanim.foldedJoints = joints, folded
			Reanim.pose, Reanim.override, Reanim.clip = {}, {}, nil
			Reanim.playing, Reanim.active, Reanim.time = false, true, 0
			Reanim.speed = Reanim.speed or 1
			Reanim.pending = false
			if Reanim.connection then Reanim.connection:Disconnect() end
			Reanim.connection = runService.PreSimulation:Connect(driveStep)
			Fn.notify("Reanim", "Active (" .. count .. " joints). Choose a keyframe to play.", "ok")
			local callbacks = Reanim.pendingCallbacks or {}
			Reanim.pendingCallbacks = {}
			for _, callback in ipairs(callbacks) do task.spawn(callback) end
			local win = W.dockWindows and W.dockWindows.Reanim
			if win and win.refresh then win.refresh() end
		end)
	end

	function Fn.playReanim(query)
		local frames, loop, label, err = resolveClip(query)
		if not frames then return Fn.notify("Reanim", err or "Couldn't load that animation.", "warn") end
		local function start()
			local matched = false
			for _, frame in ipairs(frames) do
				for name in pairs(frame.Data) do
					if findJoint(name) then matched = true break end
				end
				if matched then break end
			end
			if not matched then
				return Fn.notify("Reanim", "These keyframes do not match the joints on this avatar.", "warn")
			end
			Reanim.clip = { frames = frames, length = frames[#frames].Time }
			Reanim.loop = loop ~= false and Reanim.loop
			if loop == false then Reanim.loop = false end
			Reanim.time, Reanim.playing, Reanim.label = 0, true, label
			Fn.notify("Reanim", ("Playing %s (%d keyframes, %.1fs)"):format(label, #frames, Reanim.clip.length), "ok")
			local win = W.dockWindows and W.dockWindows.Reanim
			if win and win.refresh then win.refresh() end
		end
		if Reanim.active and Reanim.char == localPlayer.Character then start() else Fn.reanimTakeControl(start) end
	end

	function Fn.stopReanim(silent)
		local wasActive = Reanim.active
		Reanim.active, Reanim.playing = false, false
		if Reanim.connection then
			Reanim.connection:Disconnect()
			Reanim.connection = nil
		end
		if wasActive then
			for j, base in pairs(Reanim.baseC0 or {}) do
				pcall(function()
					if j and j.Parent then
						j.Transform = CFrame.new()
						j.C0 = base
					end
				end)
			end
			for _, j in pairs(Reanim.joints or {}) do
				pcall(function()
					if j and j.Parent then
						j.Transform = CFrame.new()
					end
				end)
			end
			if Reanim.animate and Reanim.animate.Parent then Reanim.animate.Disabled = false end
			Reanim.animate, Reanim.char = nil, nil
			Reanim.pose, Reanim.override, Reanim.baseC0 = {}, {}, {}
			if not silent then Fn.notify("Reanim", "Released. Your normal animations are back.", "info") end
		end
	end
	Fn.onCleanup(function() Fn.stopReanim(true) end)

	function Fn.openReanim()
		local function show()
			local win = Fn.buildReanimUI()
			if win and win.show then win.show() end
		end
		if Reanim.active then show() else Fn.reanimTakeControl(show) end
	end

	local function startsWith(list, q)
		local low = q:lower()
		for name in pairs(Reanim.joints) do
			if name:lower() == low then return name end
		end
		for name in pairs(Reanim.joints) do
			if name:lower():find(low, 1, true) then return name end
		end
	end

	Fn.cmd("Animation", { "reanimate", "reanim", "reanimation" }, "reanim [name|animation id|list]", "Take joint control. With a name/id plays that keyframe. No args opens the keyframe list.", function(args)
		local q = table.concat(args, " ")
		if q:lower() == "list" or q:lower() == "ls" then
			local files = Fn.listKeyframeFiles()
			return Fn.notify("Reanim", #files > 0 and table.concat(files, ", ") or "Nothing in the library yet.", "info")
		end
		if q == "" then
			Fn.openReanim()
			return
		end
		Fn.playReanim(q)
	end)
	Fn.cmd("Animation", { "unreanim", "stopreanim", "unreanimate" }, "unreanim", "Release your joints and restore normal animations", function()
		if not Reanim.active then return Fn.notify("Reanim", "You aren't reanimated.", "info") end
		Fn.stopReanim()
	end)
	Fn.cmd("Animation", { "rpause", "reanimpause" }, "rpause", "Pause or resume the reanimation clip", function()
		if Reanim.clip then
			Reanim.playing = not Reanim.playing
			Fn.notify("Reanim", Reanim.playing and "Resumed" or "Paused", "info")
		end
	end)
	Fn.cmd("Animation", { "rspeed", "reanimspeed" }, "rspeed <number>", "Reanimation playback speed (negative plays backwards)", function(args)
		local n = tonumber(args[1])
		if n then Reanim.speed = math.clamp(n, -10, 10) end
		Fn.notify("Reanim", "Speed " .. tostring(Reanim.speed), "info")
	end)
	Fn.cmd("Animation", { "rloop", "reanimloop" }, "rloop [on|off]", "Loop the reanimation clip", function(args)
		local a = tostring(args[1] or ""):lower()
		if a == "on" then Reanim.loop = true elseif a == "off" then Reanim.loop = false else Reanim.loop = not Reanim.loop end
		Fn.notify("Reanim", Reanim.loop and "Looping" or "Not looping", "info")
	end)
	Fn.cmd("Animation", { "joints" }, "joints", "List the joints you can pose after reanim", function()
		if not Reanim.active then return Fn.notify("Joints", "Run 'reanim' first.", "warn") end
		local names = {}
		for name, j in pairs(Reanim.joints) do
			if j.Part1 and j.Part1.Name == name then names[#names + 1] = name end
		end
		table.sort(names)
		Fn.notify("Joints", table.concat(names, ", "), "info")
	end)
	Fn.cmd("Animation", { "joint", "pose" }, "joint <name> <rx> <ry> <rz> [x y z]  |  joint <name> reset", "Rotate (degrees) or offset one joint while reanimated", function(args)
		if not Reanim.active then return Fn.notify("Joint", "Run 'reanim' first.", "warn") end
		local name = args[1] and startsWith(Reanim.joints, args[1])
		if not name then return Fn.notify("Joint", "Unknown joint. Use 'joints' to list them.", "warn") end
		if tostring(args[2] or ""):lower() == "reset" then
			Reanim.override[name] = nil
			Reanim.pose[name] = nil
			if Reanim.joints[name] then Reanim.joints[name].Transform = CFrame.new() end
			return Fn.notify("Joint", name .. " reset", "info")
		end
		local rx, ry, rz = tonumber(args[2]) or 0, tonumber(args[3]) or 0, tonumber(args[4]) or 0
		local px, py, pz = tonumber(args[5]) or 0, tonumber(args[6]) or 0, tonumber(args[7]) or 0
		Reanim.override[name] = CFrame.new(px, py, pz) * CFrame.fromOrientation(math.rad(rx), math.rad(ry), math.rad(rz))
	end)
	Fn.cmd("Animation", { "jointreset", "unpose" }, "jointreset", "Clear every manual joint pose", function()
		Reanim.override = {}
	end)
	Fn.cmd("Animation", { "kffiles", "kfadd", "kfimportfile" }, "kffiles", "Open the keyframe library to add or load animations", function()
		Fn.openKeyframeLibrary()
	end)

	task.defer(function()
		pcall(kfFolder)
	end)
end

