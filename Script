			return m
		end
		local kind, idx = key:sub(1, 1), tonumber(key:sub(2))
		if kind == "a" then
			local opts = {
				actionIdx = idx,
				sliderIdx = idx == 2 and 3 or nil,
				keyId = Fn.keyIdFor[idx],
			}
			if idx == 2 then
				opts.animKind = "fly"
			end
			return Fn.makeMini(key, Fn.miniTitles[idx], opts)
		end
		local opts = { sliderIdx = idx, reset = true }
		if idx == 1 then
			opts.keyId = "k_speed"
			opts.animKind = "run"
		elseif idx == 2 then
			opts.keyId = "k_jump"
		end
		return Fn.makeMini(key, Fn.sliderTitles[idx], opts)
	end

	function Fn.runAction(idx, arg)
		local a = Fn.Actions[idx]
		local key = "a" .. idx
		local fresh = Fn.miniOpen(key) == nil
		arg = arg and string.lower(arg) or nil
		if arg == "off" and fresh then
			if a.enabled then
				Fn.toggleAction(idx)
			end
			return
		end
		Fn.openMini(key)
		if a.disableAfter then
			Fn.toggleAction(idx)
		elseif arg == "on" then
			if not a.enabled then
				Fn.toggleAction(idx)
			end
		elseif arg == "off" then
			if a.enabled then
				Fn.toggleAction(idx)
			end
		elseif fresh then
			if not a.enabled then
				Fn.toggleAction(idx)
			end
		else
			Fn.toggleAction(idx)
		end
	end

