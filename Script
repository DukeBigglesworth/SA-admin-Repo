		return cb(src)
	end
	if string.match(src, "^%d+$") then
		return cb("rbxassetid://" .. src)
	end
	local entry = NT.cache[src]
	if entry then
		if entry.ready then
			return cb(entry.asset, entry.kind, entry.w, entry.h)
		end
		table.insert(entry.waiting, cb)
		return
	end
	if not (http and writefile and getcustomasset) then
		return
	end
	entry = { waiting = { cb } }
	NT.cache[src] = entry
	task.spawn(function()
		local res = send({ Url = src, Method = "GET" })
		local body = res and res.Body
		if type(body) ~= "string" or #body > 3000000 or #body < 16 then
			NT.cache[src] = nil
			return
		end
		local kind, w, h
		if string.sub(body, 1, 4) == "\137PNG" then
			kind = "png"
			w, h = string.unpack(">I4I4", body, 17)
		elseif string.sub(body, 1, 2) == "\255\216" then
			kind = "jpg"
		elseif string.sub(body, 1, 4) == "\26E\223\163" then
			kind = "webm"
		elseif string.sub(body, 1, 3) == "GIF" then
			NT.cache[src] = nil
			Fn.notify("Nametag", "Roblox can't play .gif files. Convert it to a spritesheet PNG or a .webm video.", "warn")
			return
		else
			NT.cache[src] = nil
			return
		end
		local path = cacheFolder() .. "/" .. hash(src) .. "." .. kind
		local okw = pcall(writefile, path, body)
		local oka, asset = false, nil
		if okw then
			oka, asset = pcall(getcustomasset, path)
		end
		if not oka or not asset then
			NT.cache[src] = nil
			return
		end
		entry.ready, entry.asset, entry.kind, entry.w, entry.h = true, asset, kind, w, h
		for _, f in ipairs(entry.waiting) do
			pcall(f, asset, kind, w, h)
		end
		entry.waiting = {}
	end)
end

local strokeOn = true
local function newLabel(parent, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.TextStrokeTransparency = strokeOn and 0.65 or 1
	l.TextStrokeColor3 = Color3.new(0, 0, 0)
	for k, v in pairs(props) do
		l[k] = v
	end
	l.Parent = parent
	return l
end

local function buildText(parent, text, size, fontName, hex1, hex2, anim, maxW, y, h, stroked)
	local font = NT.Fonts[fontName] or Enum.Font.GothamBold
	local c1, c2 = toColor(hex1), toColor(hex2)
	strokeOn = stroked ~= false
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.ZIndex = 4
	holder.Position = UDim2.fromOffset(0, y)
	holder.Size = UDim2.new(1, 0, 0, h)
	holder.Parent = parent
	if text == "" then
		return { animated = false }
	end
	local ts = size
	while ts > 8 and textService:GetTextSize(text, ts, font, Vector2.new(1000, 100)).X > maxW do
		ts -= 1
	end
	if anim == "none" then
		local l = newLabel(holder, { Size = UDim2.fromScale(1, 1), Text = text, TextSize = ts, Font = font, TextColor3 = c1 })
		if hex1 ~= hex2 then
			local g = Instance.new("UIGradient")
			g.Color = ColorSequence.new(c1, c2)
			g.Parent = l
			l.TextColor3 = Color3.new(1, 1, 1)
		end
		return { animated = false }
	end
	local chars, total, n = {}, 0, 0
	for _, cp in utf8.codes(text) do
		n += 1
		local ch = utf8.char(cp)
		local w = textService:GetTextSize(ch, ts, font, Vector2.new(1000, 100)).X
		chars[n] = { ch = ch, w = w, x = total }
		total += w
	end
	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.AnchorPoint = Vector2.new(0.5, 0.5)
	row.Position = UDim2.fromScale(0.5, 0.5)
	row.Size = UDim2.fromOffset(total, h)
	row.Parent = holder
	for i, c in ipairs(chars) do
		c.label = newLabel(row, { Position = UDim2.fromOffset(c.x, 0), Size = UDim2.fromOffset(c.w + 1, h), Text = c.ch, TextSize = ts, Font = font })
		c.base = c1:Lerp(c2, n > 1 and (i - 1) / (n - 1) or 0)
		c.label.TextColor3 = c.base
	end
	local seed = math.random() * 10
	local function tick(t)
		if anim == "rainbow" then
			for i, c in ipairs(chars) do
				c.label.TextColor3 = Color3.fromHSV((t * 0.35 + i * 0.06) % 1, 0.65, 1)
			end
		elseif anim == "gradient" then
			for i, c in ipairs(chars) do
				c.label.TextColor3 = c1:Lerp(c2, (math.sin(t * 1.6 - i * 0.4) + 1) / 2)
			end
		elseif anim == "pulse" then
			local a = 0.5 * (0.5 + 0.5 * math.sin(t * 3))
			for _, c in ipairs(chars) do
				c.label.TextTransparency = a
			end
		elseif anim == "wave" then
			for i, c in ipairs(chars) do
				c.label.Position = UDim2.fromOffset(c.x, math.sin(t * 4 + i * 0.6) * 3)
			end
		elseif anim == "float" then
			row.Position = UDim2.new(0.5, 0, 0.5, math.sin(t * 2) * 2.5)
		elseif anim == "shake" then
			for _, c in ipairs(chars) do
				c.label.Position = UDim2.fromOffset(c.x + math.random(-1, 1), math.random(-1, 1))
			end
		elseif anim == "glitch" then
			local burst = (t + seed) % 1.6 < 0.14
			for _, c in ipairs(chars) do
				if burst then
					c.label.Position = UDim2.fromOffset(c.x + math.random(-3, 3), math.random(-1, 1))
					c.label.TextColor3 = math.random() < 0.5 and Color3.fromRGB(0, 255, 240) or Color3.fromRGB(255, 0, 140)
				else
					c.label.Position = UDim2.fromOffset(c.x, 0)
					c.label.TextColor3 = c.base
				end
			end
		elseif anim == "typewriter" then
			local shown = floor((t * 6) % (n + 6))
			for i, c in ipairs(chars) do
				c.label.TextTransparency = i <= shown and 0 or 1
			end
		end
	end
	return { animated = true, tick = tick }
end

local function buildParticles(card, kind, hex, w, h)
	if kind == "none" then
		return nil
	end
	local count = kind == "orbit" and 3 or 9
	local color = toColor(hex)
	local ps = {}
	for i = 1, count do
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.ZIndex = 6
		f.BackgroundColor3 = kind == "snow" and Color3.new(1, 1, 1) or (kind == "embers" and Color3.fromRGB(255, 150, 60) or color)
		f.Size = UDim2.fromOffset(kind == "snow" and 4 or 3, kind == "snow" and 4 or 3)
		f.BackgroundTransparency = 1
		f.Parent = card
		if kind == "snow" then
			local u = Instance.new("UICorner")
			u.CornerRadius = UDim.new(1, 0)
			u.Parent = f
		end
		if kind == "sparkles" then
			f.Rotation = 45
		end
		ps[i] = { f = f, life = math.random(), x = math.random() * w, y = math.random() * h, sp = 0.6 + math.random() * 0.8 }
	end
	local perimeter = 2 * (w + h)
	return function(t, dt)
		for i, p in ipairs(ps) do
			if kind == "orbit" then
				local d = ((t * 0.22 + i / count) % 1) * perimeter
				local x, y
				if d < w then
					x, y = d, 0
				elseif d < w + h then
					x, y = w, d - w
				elseif d < 2 * w + h then
					x, y = w - (d - w - h), h
				else
					x, y = 0, h - (d - 2 * w - h)
				end
				p.f.Position = UDim2.fromOffset(x - 1.5, y - 1.5)
				p.f.BackgroundTransparency = 0.1
			else
				p.life += dt * p.sp * (kind == "sparkles" and 0.9 or 0.35)
				if p.life >= 1 then
					p.life = 0
					p.x = math.random() * w
					p.y = kind == "embers" and h + 2 or (kind == "snow" and -2 or math.random() * h)
				end
				if kind == "embers" then
					p.y -= dt * 22 * p.sp
					p.x += math.sin(t * 2 + i) * dt * 6
				elseif kind == "snow" then
					p.y += dt * 18 * p.sp
					p.x += math.sin(t * 1.5 + i) * dt * 8
				end
				p.f.Position = UDim2.fromOffset(p.x, p.y)
				p.f.BackgroundTransparency = 1 - math.sin(math.pi * p.life) * (kind == "sparkles" and 0.95 or 0.8)
			end
		end
	end
end

function NT.build(parent, p, userId)
	local sc = p.scale
	local W0, H0 = (170 + (p.avatar and 40 or 0)) * sc, 52 * sc
	local ticks = {}
	local root = Instance.new("Frame")
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.Parent = parent
	local cw, ch = W0 - 8, H0 - 8
	local bd, bg = p.border, p.bg
	local bc1, bc2 = toColor(bd.color), toColor(bd.color2)

	if bd.glow and bd.style ~= "none" then
		local glow = Instance.new("Frame")
		glow.AnchorPoint = Vector2.new(0.5, 0.5)
		glow.Position = UDim2.fromScale(0.5, 0.5)
		glow.Size = UDim2.new(1, -8, 1, -8)
		glow.BackgroundTransparency = 1
		glow.Parent = root
		local gc = Instance.new("UICorner")
		gc.CornerRadius = UDim.new(0, bd.corner)
		gc.Parent = glow
		local gs = Instance.new("UIStroke")
		gs.Thickness = 6
		gs.Transparency = 0.8
		gs.Color = bc1
		gs.Parent = glow
	end

	local card = Instance.new("Frame")
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position = UDim2.fromScale(0.5, 0.5)
	card.Size = UDim2.new(1, -8, 1, -8)
	card.BorderSizePixel = 0
	card.ClipsDescendants = true
	card.BackgroundColor3 = toColor(bg.color)
	card.BackgroundTransparency = bg.transparency
	card.Parent = root
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, bd.corner)
	corner.Parent = card

	local stk = Instance.new("UIStroke")
	stk.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stk.Thickness = bd.style == "none" and 0 or bd.thickness
	stk.Color = bc1
	stk.Parent = card
	if bd.style == "gradient" or bd.style == "rainbow" then
		local g = Instance.new("UIGradient")
		if bd.style == "gradient" then
			g.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, bc1), ColorSequenceKeypoint.new(0.5, bc2), ColorSequenceKeypoint.new(1, bc1) })
		else
			local keys = {}
			for i = 0, 6 do
				keys[#keys + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6 % 1, 0.8, 1))
			end
			g.Color = ColorSequence.new(keys)
		end
		g.Parent = stk
		ticks[#ticks + 1] = function(t)
			g.Rotation = (t * 90) % 360
		end
	elseif bd.style == "pulse" then
		ticks[#ticks + 1] = function(t)
			stk.Transparency = 0.5 * (0.5 + 0.5 * math.sin(t * 3))
		end
	end

	local bgGrad
	if bg.type == "gradient" or p.bgEffect == "flow" then
		card.BackgroundColor3 = Color3.new(1, 1, 1)
		local c1, c2 = toColor(bg.color), toColor(bg.color2)
		bgGrad = Instance.new("UIGradient")
		bgGrad.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, c1), ColorSequenceKeypoint.new(0.5, c2), ColorSequenceKeypoint.new(1, c1) })
		bgGrad.Rotation = 20
		bgGrad.Parent = card
		if p.bgEffect == "flow" then
			ticks[#ticks + 1] = function(t)
				bgGrad.Offset = Vector2.new(math.sin(t * 0.8) * 0.5, 0)
			end
		end
	end

	local media
	if bg.type == "image" and bg.image ~= "" then
		media = Instance.new("ImageLabel")
		media.ScaleType = Enum.ScaleType.Crop
		media.BackgroundTransparency = 1
		media.Size = UDim2.fromScale(1, 1)
		media.ZIndex = 1
		media.Parent = card
		NT.asset(bg.image, function(asset)
			if media.Parent then
				media.Image = asset
			end
		end)
	elseif bg.type == "sprite" and bg.sprite.url ~= "" then
		media = Instance.new("ImageLabel")
		media.ScaleType = Enum.ScaleType.Stretch
		media.BackgroundTransparency = 1
		media.Size = UDim2.fromScale(1, 1)
		media.ZIndex = 1
		media.Parent = card
		local sp = bg.sprite
		local cellW, cellH = sp.cw, sp.ch
		NT.asset(sp.url, function(asset, kind, w, h)
			if not media.Parent then
				return
			end
			if cellW == 0 and w then
				cellW = floor(w / sp.cols)
			end
			if cellH == 0 and h then
				cellH = floor(h / sp.rows)
			end
			media.Image = asset
			if cellW > 0 and cellH > 0 then
				media.ImageRectSize = Vector2.new(cellW, cellH)
				ticks[#ticks + 1] = function(t)
					local idx = floor(t * sp.fps) % sp.frames
					media.ImageRectOffset = Vector2.new((idx % sp.cols) * cellW, floor(idx / sp.cols) * cellH)
				end
				p.__spriteReady = true
			end
		end)
	elseif bg.type == "video" and bg.video ~= "" then
		local okv, vf = pcall(Instance.new, "VideoFrame")
		if okv then
			media = vf
			vf.BackgroundTransparency = 1
			vf.Size = UDim2.fromScale(1, 1)
			vf.ZIndex = 1
			vf.Looped = true
			vf.Volume = 0
			vf.Parent = card
			NT.asset(bg.video, function(asset)
				if vf.Parent then
					vf.Video = asset
					vf.Playing = true
				end
			end)
		end
	end
	if media then
		local scrim = Instance.new("Frame")
		scrim.BackgroundColor3 = Color3.new(0, 0, 0)
		scrim.BackgroundTransparency = 1 - bg.dim
		scrim.BorderSizePixel = 0
		scrim.Size = UDim2.fromScale(1, 1)
		scrim.ZIndex = 2
		scrim.Parent = card
	end

	if p.bgEffect == "shimmer" then
		local bar = Instance.new("Frame")
		bar.AnchorPoint = Vector2.new(0.5, 0.5)
		bar.BackgroundColor3 = Color3.new(1, 1, 1)
		bar.BackgroundTransparency = 0.86
		bar.BorderSizePixel = 0
		bar.Rotation = 20
		bar.Size = UDim2.new(0.22, 0, 1.8, 0)
		bar.ZIndex = 3
		bar.Parent = card
		ticks[#ticks + 1] = function(t)
			local u = math.min((t % 3) / 1.6, 1)
			bar.Position = UDim2.new(u * 1.6 - 0.3, 0, 0.5, 0)
		end
	elseif p.bgEffect == "pulse" then
		ticks[#ticks + 1] = function(t)
			card.BackgroundTransparency = clamp(bg.transparency + 0.12 * math.sin(t * 2.5), 0, 1)
		end
	end

	local name, display = p.name, p.display
	if name == "" and display == "" then
		name = "SA user"
	end
	if name ~= "" then
		name = p.prefix .. (p.prefix ~= "" and " " or "") .. name .. (p.suffix ~= "" and " " or "") .. p.suffix
	end
	local areaX = 0
	if p.avatar and userId then
		areaX = ch
		local img = Instance.new("ImageLabel")
		img.BackgroundColor3 = Color3.new(0, 0, 0)
		img.BackgroundTransparency = 0.5
		img.Position = UDim2.fromOffset(4, 4)
		img.Size = UDim2.fromOffset(ch - 8, ch - 8)
		img.ZIndex = 5
		img.Parent = card
		local ic = Instance.new("UICorner")
		ic.CornerRadius = UDim.new(1, 0)
		ic.Parent = img
		task.spawn(function()
			local ok, thumb = pcall(players.GetUserThumbnailAsync, players, userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
			if ok and img.Parent then
				img.Image = thumb
			end
		end)
	end
	local area = Instance.new("Frame")
	area.BackgroundTransparency = 1
	area.Position = UDim2.fromOffset(areaX, 0)
	area.Size = UDim2.new(1, -areaX, 1, 0)
	area.ZIndex = 4
	area.Parent = card
	local nh, dh = 24 * sc, 14 * sc
	local nameSize, dispSize = floor(20 * sc * p.nameSize), floor(11 * sc * p.displaySize)
	local nameY, dispY
	if name ~= "" and display ~= "" then
		nameY, dispY = 5 * sc, 30 * sc
	elseif name ~= "" then
		nameY = (ch - nh) / 2
	else
		dispY = (ch - dh) / 2
	end
	if name ~= "" then
		local o = buildText(area, name, nameSize, p.font, p.nameColor, p.nameColor2, p.nameAnim, cw - areaX - 14, nameY, nh, p.textStroke)
		if o.tick then
			ticks[#ticks + 1] = o.tick
		end
	end
	if display ~= "" then
		local o = buildText(area, display, dispSize, p.font, p.displayColor, p.displayColor2, p.displayAnim, cw - areaX - 14, dispY, dh, p.textStroke)
		if o.tick then
			ticks[#ticks + 1] = o.tick
		end
	end

	local particles = buildParticles(card, p.effect, bd.color, cw, ch)
	if particles then
		ticks[#ticks + 1] = particles
	end

	local obj = { root = root, ticks = ticks }
	obj.animated = #ticks > 0 or bg.type == "sprite"
	function obj.tick(t, dt)
		for _, f in ipairs(obj.ticks) do
			f(t, dt)
		end
	end
	function obj.destroy()
		NT.objs[obj] = nil
		root:Destroy()
	end
	return obj
end

track(runService.Heartbeat:Connect((function()
	local acc = 0
	return function(dt)
		acc += dt
		if acc < 1 / 30 then
			return
		end
		local step = acc
		acc = 0
		local t = os.clock()
		local cam = workspace.CurrentCamera
		local near = {}
		for obj, anchor in pairs(NT.objs) do
			if anchor == true then
				obj.tick(t, step)
			elseif anchor.Parent and cam then
				local d = (anchor.Position - cam.CFrame.Position).Magnitude
				if d < 90 then
					near[#near + 1] = { obj, d }
				end
			end
		end
		if #near > 12 then
			table.sort(near, function(a, b)
				return a[2] < b[2]
			end)
		end
		for i = 1, math.min(#near, 12) do
			near[i][1].tick(t, step)
		end
	end
end)()))

local function publish()
	local body = httpService:JSONEncode({ u = localPlayer.UserId, t = os.time(), n = cleanText(Values.sa_text), c = hexOr(Values.sa_color, "") })
	local res = send({ Url = endpoint() .. topic(), Method = "POST", Headers = { ["Content-Type"] = "text/plain" }, Body = body })
	if res then
		SA.published += 1
	end
	return res ~= nil
end

local function poll()
	local res = send({ Url = endpoint() .. topic() .. "/json?poll=1&since=15m", Method = "GET" })
	if not res or type(res.Body) ~= "string" then
		return false
	end
	local now = os.time()
	local fresh = {}
	for line in string.gmatch(res.Body, "[^\r\n]+") do
		local ok, msg = pcall(httpService.JSONDecode, httpService, line)
		if ok and type(msg) == "table" and type(msg.message) == "string" then
			local ok2, data = pcall(httpService.JSONDecode, httpService, msg.message)
			if ok2 and type(data) == "table" and tonumber(data.u) then
				local t = tonumber(msg.time) or tonumber(data.t) or now
				if now - t < 780 then
					fresh[tonumber(data.u)] = { t = t, n = cleanText(data.n), c = hexOr(data.c, "") }
				end
			end
		end
	end
	fresh[localPlayer.UserId] = { t = now, n = cleanText(Values.sa_text), c = hexOr(Values.sa_color, "") }
	SA.users = fresh
	return true
end

local function fetchProfiles()
	local url = (type(Values.sa_profiles) == "string" and Values.sa_profiles ~= "") and Values.sa_profiles or ((type(Values.customsUrl) == "string" and Values.customsUrl ~= "") and Values.customsUrl or PROFILES_URL)
	if not (string.match(url, "^https://raw%.githubusercontent%.com/") or string.match(url, "^https://gist%.githubusercontent%.com/")) then
		return false
	end
	if string.find(url, "YOUR_NAME", 1, true) then
		return false
	end
	local res = send({ Url = url .. (string.find(url, "?", 1, true) and "&" or "?") .. "t=" .. tostring(os.time() // 60), Method = "GET" })
	if not res or type(res.Body) ~= "string" or #res.Body > 524288 then
		return false
	end
	local body = string.gsub(res.Body, ",(%s*[}%]])", "%1")
	local ok, data = pcall(httpService.JSONDecode, httpService, body)
	if not ok or type(data) ~= "table" then
		return false
	end
	local list = type(data.profiles) == "table" and data.profiles or data
	local out, ranks = {}, {}
	for uid, entry in pairs(list) do
		local id = tonumber(uid)
		if id and not (type(entry) == "table" and (entry.enabled == false or entry.approved == false)) then
			local source, rank = entry, 2
			if type(entry) == "table" and type(entry.code) == "string" then
				source = entry.code
				rank = tonumber(entry.rank) or 2
			end
			local okp, prof = pcall(NT.fromEntry, source)
			if okp then
				out[id] = prof
				ranks[id] = math.clamp(math.floor(rank), 1, 4)
			end
		end
	end
	SA.ranks = ranks
	SA.profiles = out
	SA.rev += 1
	return true
end

local function profileFor(p)
	local gh = SA.profiles[p.UserId]
	local fxOff = Values.sa_fx == false
	if gh then
		return fxOff and NT.simplify(gh) or gh, "g" .. SA.rev .. (fxOff and "x" or "")
	end
	if p == localPlayer and SA.mine and SA.running then
		return SA.mine, "m" .. SA.mineRev
	end
	local info = SA.users[p.UserId]
	if info then
		local prof = NT.default()
		local custom = Values.sa_showcustom ~= false or p == localPlayer
		if custom and info.n ~= "" then
			prof.name = info.n
		end
		if custom and info.c ~= "" then
			prof.nameColor, prof.nameColor2, prof.border.color, prof.border.color2 = info.c, info.c, info.c, info.c
		end
		return prof, "h" .. info.n .. info.c .. (custom and 1 or 0)
	end
	return nil
end

local function makeTag(p, prof, signature)
	local c = p.Character
	local head = c and c:FindFirstChild("Head")
	if not head then
		return
	end
	local old = SA.tags[p]
	if old and old.gui.Parent == head and old.sig == signature then
		return
	end
	if old then
		old.destroy()
		SA.tags[p] = nil
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "SchweinsTag"
	gui.Size = UDim2.fromOffset((170 + (prof.avatar and 40 or 0)) * prof.scale, 52 * prof.scale)
	gui.StudsOffset = Vector3.new(0, 3.1 + prof.scale * 0.5, 0)
	gui.MaxDistance = 100000
	gui.AlwaysOnTop = true
	gui.Active = true
	gui.LightInfluence = 0
	gui.ResetOnSpawn = false
	gui.Adornee = head
	local obj = NT.build(gui, prof, p.UserId)
	local hit = Instance.new("TextButton")
	hit.Name = "TPHit"
	hit.BackgroundTransparency = 1
	hit.Size = UDim2.fromScale(1, 1)
	hit.Text = ""
	hit.ZIndex = 50
	hit.Parent = gui
	hit.MouseButton1Click:Connect(function()
		if p ~= localPlayer and type(Fn.teleportTo) == "function" then
			pcall(Fn.teleportTo, p)
		end
	end)
	gui.Parent = head
	if obj.animated then
		NT.objs[obj] = head
	end
	SA.tags[p] = {
		gui = gui, obj = obj, sig = signature,
		destroy = function()
			NT.objs[obj] = nil
			gui:Destroy()
		end,
	}
end

local function sync()
	for _, p in ipairs(players:GetPlayers()) do
		local prof, signature = profileFor(p)
		if prof then
			makeTag(p, prof, signature)
		elseif SA.tags[p] then
			SA.tags[p].destroy()
			SA.tags[p] = nil
		end
	end
	for p, tag in pairs(SA.tags) do
		if not p.Parent then
			tag.destroy()
			SA.tags[p] = nil
		end
	end
end

function Fn.saSync()
	pcall(sync)
end

