function Fn.notify(title, description, kind)
	if not Fn.alive() then
		return
	end
	if Values.notifications == false then
		return
	end
	State.notifCount += 1
	State.activeNotifs += 1
	local desc = tostring(description or "")
	local size = textService:GetTextSize(desc, 12, Enum.Font.GothamMedium, Vector2.new(246, 1000))
	local h = math.max(62, 46 + size.Y)
	local holder = new("Frame", { LayoutOrder = State.notifCount, Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1 }, W.notifLayer)
	local card = new("CanvasGroup", {
		Size = UDim2.new(1, 0, 0, h), Position = UDim2.fromOffset(0, -46), BorderSizePixel = 0, GroupTransparency = 1,
	}, holder)
	reg(card, "BackgroundColor3", "bg")
	round(card, 14)
	Fn.animStroke(card, 90)
	Fn.glow(card, 14)
	local pop = new("UIScale", { Scale = 0.86 }, card)
	local ic = Fn.icon(card, kind or "pent", 24, "accent")
	ic.Position = UDim2.fromOffset(28, 28)
	ic.Rotation = -90
	local title_ = ttxt(card, {
		Position = UDim2.fromOffset(54, 12), Size = UDim2.new(1, -100, 0, 18), Text = tostring(title or "Notification"), Font = Enum.Font.GothamBold, TextSize = 14,
		TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 3,
	}, "text")
	local time_ = ttxt(card, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 14), Size = UDim2.fromOffset(40, 14), Text = "now", TextSize = 10, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 3 }, "muted")
	ttxt(card, {
		Position = UDim2.fromOffset(54, 32), Size = UDim2.fromOffset(246, size.Y + 4), Text = desc, TextSize = 12, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
		TextTransparency = 0.12, ZIndex = 3,
	}, "muted")
	local bar = new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 2), BorderSizePixel = 0, ZIndex = 4 }, card)
	reg(bar, "BackgroundColor3", "accent")
	local hit = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 6 }, card)

	if Values.blurnotifs then
		if not W.notifBlur then
			W.notifBlur = new("BlurEffect", { Size = 0, Name = "SchweinsNotifBlur" }, lighting)
		end
		tween(W.notifBlur, 0.4, { Size = 6 })
	end

	local life = math.clamp(#desc * 0.07 + 2.4, 2.8, 9)
	tween(holder, 0.45, { Size = UDim2.new(1, 0, 0, h) })
	tween(card, 0.55, { Position = UDim2.fromOffset(0, 0), GroupTransparency = 0 }, Enum.EasingStyle.Back)
	tween(pop, 0.55, { Scale = 1 }, Enum.EasingStyle.Back)
	tween(ic, 0.7, { Rotation = 0 }, Enum.EasingStyle.Back)
	tween(bar, life, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)
	Fn.playSound("Ping")

	local dismissed = false
	local function dismiss()
		if dismissed then
			return
		end
		dismissed = true
		tween(card, 0.4, { Position = UDim2.fromOffset(0, -24), GroupTransparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		tween(pop, 0.4, { Scale = 0.9 })
		task.delay(0.3, function()
			tween(holder, 0.28, { Size = UDim2.new(1, 0, 0, 0) })
		end)
		task.delay(0.65, function()
			holder:Destroy()
			State.activeNotifs -= 1
			if State.activeNotifs <= 0 and W.notifBlur then
				tween(W.notifBlur, 0.5, { Size = 0 })
			end
		end)
	end
	hit.MouseButton1Click:Connect(dismiss)
	task.delay(life, dismiss)
end

function Fn.clampWindow(window)
	if not window or not window.Parent then
		return
	end
	local cam = workspace.CurrentCamera
	local viewport = cam and cam.ViewportSize
	if not viewport then
		return
	end
	local position, size, anchor = window.Position, window.Size, window.AnchorPoint
	local width = size.X.Scale * viewport.X + size.X.Offset
	local height = size.Y.Scale * viewport.Y + size.Y.Offset
	local maxX = math.max(0, viewport.X - width)
	local maxY = math.max(0, viewport.Y - height)
	local marginX = math.min(12, maxX)
	local marginY = math.min(12, maxY)
	local x = position.X.Scale * viewport.X + position.X.Offset - anchor.X * width
	local y = position.Y.Scale * viewport.Y + position.Y.Offset - anchor.Y * height
	x = math.clamp(x, marginX, math.max(marginX, maxX - marginX))
	y = math.clamp(y, marginY, math.max(marginY, maxY - marginY))
	window.AnchorPoint = Vector2.new(0, 0)
	window.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
end

function Fn.makeDraggable(window, handle)
	local dragging, startInput, originX, originY = false, nil, 0, 0
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			Fn.clampWindow(window)
			dragging = true
			startInput = input.Position
			originX = window.Position.X.Offset
			originY = window.Position.Y.Offset
		end
	end)
	track(userInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - startInput
			window.Position = UDim2.fromOffset(originX + d.X, originY + d.Y)
			Fn.clampWindow(window)
		end
	end))
	track(userInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if dragging then
				Fn.clampWindow(window)
				pcall(Fn.saveSessionState)
			end
			dragging = false
		end
	end))
end

function Fn.makeWindow(name, w, h, titleText, subText, dockName, allowMinimize)
	local MIN_H = 38
	local win = { name = name, open = false, w = w, h = h, minimized = false, fullH = h, savedPos = nil, dockLinked = dockName ~= nil and dockName ~= "" }
	local f = new("CanvasGroup", {
		Name = name, AnchorPoint = Vector2.new(0, 0), Position = UDim2.new(0.5, -w // 2, 0.45, -h // 2), Size = UDim2.fromOffset(w, h), BorderSizePixel = 0, GroupTransparency = 1, Visible = false,
		ClipsDescendants = true,
	}, W.windows)
	reg(f, "BackgroundColor3", "bg")
	round(f, 14)
	Fn.animStroke(f, 50)
	Fn.glow(f, 14)
	local pop = new("UIScale", { Scale = 0.94 }, f)
	win.frame, win.pop = f, pop
	win.header = new("Frame", { Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1, ZIndex = 6 }, f)
	win.title = ttxt(f, { Position = UDim2.fromOffset(26, 16), Size = UDim2.fromOffset(w - 150, 30), Text = titleText, TextSize = 24, Font = Enum.Font.GothamBold, ZIndex = 7 }, "text")
	win.sub = ttxt(f, {
		Position = UDim2.fromOffset(26, 46), Size = UDim2.fromOffset(w - 150, 26), Text = subText or "", TextSize = 12, TextTransparency = 0.2, TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 7,
	}, "muted")
	local minBtn = new("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -52, 0, 10), Size = UDim2.fromOffset(28, 28), Text = "", BackgroundTransparency = 1, ZIndex = 8, Visible = allowMinimize ~= false and not win.dockLinked }, f)
	local minIcon = Fn.icon(minBtn, "chevron", 14, "muted")
	minIcon.Rotation = 0
	local close = new("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 10), Size = UDim2.fromOffset(28, 28), Text = "", BackgroundTransparency = 1, ZIndex = 8 }, f)
	local cIcon = Fn.icon(close, "close", 16, "muted")
	close.MouseEnter:Connect(function()
		tween(cIcon, 0.3, { Rotation = 90 }, Enum.EasingStyle.Back)
	end)
	close.MouseLeave:Connect(function()
		tween(cIcon, 0.3, { Rotation = 0 })
	end)
	Fn.makeDraggable(f, win.header)

	local function isChrome(child)
		if not child or not child:IsA("GuiObject") then
			return true
		end
		if child == win.header or child == win.title or child == win.sub or child == minBtn or child == close then
			return true
		end
		if child:IsA("UIScale") or child:IsA("UICorner") or child:IsA("UIStroke") or child:IsA("UIGradient") or child:IsA("UIListLayout") or child:IsA("UIPadding") then
			return true
		end
		if child:IsA("Frame") and child.BackgroundTransparency < 1 and child.Size.X.Scale == 1 and child.Size.Y.Scale == 1 and (child.ZIndex or 1) <= 2 then
			return true
		end
		return false
	end

	local function collectBody()
		win.bodyChildren = {}
		for _, child in ipairs(f:GetChildren()) do
			if not isChrome(child) then
				win.bodyChildren[#win.bodyChildren + 1] = { instance = child, visible = child.Visible }
			end
		end
	end

	local function applyExpandedLayout()
		win.title.Position = UDim2.fromOffset(26, 16)
		win.title.Size = UDim2.fromOffset(win.w - 150, 30)
		win.title.TextSize = 24
		win.title.TextXAlignment = Enum.TextXAlignment.Left
		win.sub.Visible = true
		win.header.Size = UDim2.new(1, 0, 0, 60)
		minBtn.Position = UDim2.new(1, -52, 0, 10)
		close.Position = UDim2.new(1, -16, 0, 10)
	end

	local function applyMinimizedLayout()
		win.title.Position = UDim2.fromOffset(14, 0)
		win.title.Size = UDim2.new(1, -86, 1, 0)
		win.title.TextSize = 13
		win.title.Font = Enum.Font.GothamBold
		win.title.TextXAlignment = Enum.TextXAlignment.Left
		win.title.TextYAlignment = Enum.TextYAlignment.Center
		win.sub.Visible = false
		win.header.Size = UDim2.new(1, 0, 1, 0)
		minBtn.Size = UDim2.fromOffset(26, 26)
		close.Size = UDim2.fromOffset(26, 26)
		minBtn.Position = UDim2.new(1, -36, 0.5, -13)
		close.Position = UDim2.new(1, -8, 0.5, -13)
	end

	function win.setMin(state)
		local want = state and true or false
		if win.minimized == want and f.Visible then
			return
		end
		local leftX = f.Position.X.Offset
		local topY = f.Position.Y.Offset
		win.minimized = want
		f.AnchorPoint = Vector2.new(0, 0)
		if win.minimized then
			collectBody()
			for _, item in ipairs(win.bodyChildren) do
				local ch = item.instance
				if ch and ch.Parent then
					ch.Visible = false
				end
			end
			applyMinimizedLayout()
			f.Size = UDim2.fromOffset(240, 38)
			f.Position = UDim2.fromOffset(leftX, topY)
			tween(minIcon, 0.25, { Rotation = 180 })
			win.savedPos = f.Position
		else
			for _, item in ipairs(win.bodyChildren or {}) do
				local ch = item.instance
				if ch and ch.Parent then
					ch.Visible = item.visible
				end
			end
			applyExpandedLayout()
			f.Size = UDim2.fromOffset(win.w, win.fullH or win.h)
			f.Position = UDim2.fromOffset(leftX, topY)
			tween(minIcon, 0.25, { Rotation = 0 })
			win.savedPos = f.Position
		end
	end

	minBtn.MouseButton1Click:Connect(function()
		Fn.playSound("Click")
		win.setMin(not win.minimized)
	end)

	function win.show()
		if win.open then
			if win.minimized then
				win.setMin(false)
			end
			Fn.clampWindow(f)
			return
		end
		win.open = true
		f.Visible = true
		if win.minimized then
			win.setMin(false)
		else
			applyExpandedLayout()
			f.Size = UDim2.fromOffset(win.w, win.fullH or win.h)
		end
		f.AnchorPoint = Vector2.new(0, 0)
		if win.savedPos then
			f.Position = win.savedPos
		else
			local cam = workspace.CurrentCamera
			local vs = cam and cam.ViewportSize or Vector2.new(1280, 720)
			local fw = win.w
			local fh = win.fullH or win.h
			local x = math.floor((vs.X - fw) / 2)
			local y = math.floor(math.max(0, (vs.Y - fh) / 2))
			f.Position = UDim2.fromOffset(x, y)
		end
		Fn.clampWindow(f)
		pop.Scale = 0.92
		tween(f, 0.45, { GroupTransparency = 0 })
		tween(pop, 0.55, { Scale = 1 }, Enum.EasingStyle.Back)
		task.defer(function()
			win.savedPos = f.Position
		end)
		if dockName and W.buttons[dockName] then
			tween(W.buttons[dockName].dot, 0.4, { Size = UDim2.fromOffset(14, 3) }, Enum.EasingStyle.Back)
		end
		Fn.playSound("Open")
		if win.onShow then
			win.onShow()
		end
		pcall(Fn.rememberOpenWindows)
	end
	function win.hide()
		if not win.open then
			return
		end
		win.open = false
		win.savedPos = f.Position
		tween(f, 0.3, { GroupTransparency = 1 })
		tween(pop, 0.3, { Scale = 0.94 })
		if dockName and W.buttons[dockName] then
			tween(W.buttons[dockName].dot, 0.3, { Size = UDim2.fromOffset(0, 3) })
		end
		Fn.playSound("Close")
		task.delay(0.32, function()
			if not win.open then
				f.Visible = false
			end
		end)
		pcall(Fn.rememberOpenWindows)
	end
	close.MouseButton1Click:Connect(win.hide)
	return win
end

