function Fn.saStart()
	if SA.running then
		return
	end
	SA.running = true
	SA.users = { [localPlayer.UserId] = { t = os.time(), n = cleanText(Values.sa_text), c = hexOr(Values.sa_color, "") } }
	task.spawn(function()
		local sinceBeat, sinceFetch = 1e9, 1e9
		while SA.running and Fn.alive() do
			if sinceFetch >= 600 then
				fetchProfiles()
				sinceFetch = 0
			end
			if sinceBeat >= 330 then
				if publish() then
					sinceBeat = 0
				else
					sinceBeat = 300
				end
			end
			poll()
			pcall(sync)
			for _ = 1, 6 do
				if not SA.running then
					break
				end
				task.wait(5)
				sinceBeat += 5
				sinceFetch += 5
				if SA.dirty and sinceBeat >= 20 then
					SA.dirty = false
					if publish() then
						sinceBeat = 0
						poll()
						pcall(sync)
					end
				end
			end
		end
	end)
end

function Fn.saStop()
	SA.running = false
	for _, tag in pairs(SA.tags) do
		tag.destroy()
	end
	SA.tags = {}
end
Fn.onCleanup(Fn.saStop)

