local origFind = Fn.findCommand
function Fn.findCommand(name)
	local a = Values.aliases and Values.aliases[name]
	if a then
		return {
			names = { name }, usage = name, desc = "alias: " .. a,
			run = function(args)
				Mod.aliasDepth = (Mod.aliasDepth or 0) + 1
				if Mod.aliasDepth < 6 then
					Fn.runCommand(a .. (#args > 0 and (" " .. table.concat(args, " ")) or ""))
				end
				Mod.aliasDepth = Mod.aliasDepth - 1
			end,
		}
	end
	return origFind(name)
end

local origRun = Fn.runCommand
function Fn.runCommand(text)
	text = tostring(text or "")
	text = text:gsub("^%s*;*%s*", "")
	local first = lower(text:match("^(%S+)") or "")
	if first == "r" then
		if State.lastCmd then
			return Fn.runCommand(State.lastCmd)
		end
		Fn.notify("Repeat", "No previous command yet.", "warn")
		return false
	end
	if text ~= "" and first ~= "wait" and first ~= "delay" then
		State.lastCmd = text
	end
	if string.find(text, "&&", 1, true) then
		local result = true
		for _, part in ipairs(text:split("&&")) do
			result = origRun(part)
		end
		return result
	end
	return origRun(text)
end

