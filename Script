function Fn.styleAnimId(kind)
	local list = kind == "fly" and Fn.FlyStyles or Fn.RunStyles
	local cur = kind == "fly" and State.flyStyle or State.runStyle
	for _, s in ipairs(list) do
		if s.id == cur then
			return s.anim
		end
	end
	return nil
end

function Fn.setAnimStyle(kind, styleId)
	if kind == "fly" then
		State.flyStyle = styleId
		Fn.stopAnim("fly")
		if Fn.Actions[2].enabled and styleId ~= "off" then
			Fn.playFlightAnim(true)
		end
	else
		State.runStyle = styleId
		Fn.stopAnim("run")
	end
	Fn.notify(kind == "fly" and "Flight style" or "Run style", tostring(styleId), "ok")
end

function Fn.getAnimator(humanoid)
	if not humanoid then
		return nil
	end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	return animator
end

function Fn.loadAnimTrack(kind, animId)
	local h = Fn.humanoid()
	if not h or not animId then
		return nil
	end
	State.animTracks = State.animTracks or {}
	local existing = State.animTracks[kind]
	if existing then
		pcall(function()
			existing:Stop(0.1)
		end)
		State.animTracks[kind] = nil
	end
	local track
	pcall(function()
		local animator = Fn.getAnimator(h)
		if not animator then
			return
		end
		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://" .. tostring(animId)
		track = animator:LoadAnimation(anim)
		track.Priority = Enum.AnimationPriority.Action
		track.Looped = true
	end)
	if track then
		State.animTracks[kind] = track
	end
	return track
end

function Fn.stopAnim(kind)
	local t = State.animTracks and State.animTracks[kind]
	if t then
		pcall(function()
			t:Stop(0.15)
		end)
		State.animTracks[kind] = nil
	end
end

function Fn.playRunAnim(on)
	local animId = Fn.styleAnimId("run")
	if not on or not animId then
		Fn.stopAnim("run")
		return
	end
	local track = State.animTracks and State.animTracks.run
	if not track then
		track = Fn.loadAnimTrack("run", animId)
	end
	if track then
		pcall(function()
			if not track.IsPlaying then
				track:Play(0.2)
			end
			local spd = Fn.Sliders[1] and Fn.Sliders[1].value or 16
			track:AdjustSpeed(math.clamp(spd / 16, 0.6, 3.5))
		end)
	end
end

function Fn.playFlightAnim(on)
	local animId = Fn.styleAnimId("fly")
	if not on or not animId then
		Fn.stopAnim("fly")
		return
	end
	local track = State.animTracks and State.animTracks.fly
	if not track then
		track = Fn.loadAnimTrack("fly", animId)
	end
	if track then
		pcall(function()
			if not track.IsPlaying then
				track:Play(0.25)
			end
			track:AdjustSpeed(State.flyStyle == "superman" and 1.15 or 1)
		end)
	end
end

function Fn.toggleAction(i)
	local a = Fn.Actions[i]
	a.enabled = not a.enabled
	local ok = pcall(a.callback, a.enabled)
	if not ok then
		a.enabled = false
		Fn.notify("Action Error", "'" .. a.name .. "' had an error while running.", "warn")
	end
	Fn.applyActionVisual(i)
	if a.enabled and a.disableAfter then
		task.delay(a.disableAfter, function()
			a.enabled = false
			Fn.applyActionVisual(i)
		end)
	end
end

