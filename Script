	end
	local lastRing = 0
	local sipConn = runService.RenderStepped:Connect(function(dt)
		spinDeg += (3600 + sipProgress.v * 2000) * dt
		star.Rotation = spinDeg % 360
		if pparts.runeRing then
			pparts.runeRing.Rotation = -spinDeg * 1.6
		end
		baseScale = 1.2 - 0.95 * sipProgress.v
		starScale.Scale = baseScale * (1 + 0.05 * math.sin(os.clock() * 24))
		for _, g in ipairs(glows) do
			g.BackgroundTransparency = 0.88 + 0.08 * math.sin(os.clock() * 16) + sipProgress.v * 0.1
		end
		sipProgress.drain = math.max(sipProgress.drain - dt * 3, 0)
		local amp = sipProgress.drain * 4
		W.dock.Position = UDim2.new(0.5, math.random(-100, 100) / 100 * amp, 1, -12 + math.random(-100, 100) / 100 * amp)
		W.dockScale.Scale = sc * (1 + 0.012 * sipProgress.drain)
		for _, s in ipairs(streams) do
			s.u += dt * s.sp / (0.9 * speed)
			if s.u >= 1 then
				if siphonOn then
					sipProgress.drain = math.min(sipProgress.drain + 0.12, 1)
					if os.clock() - lastRing > 0.09 then
						lastRing = os.clock()
						Fn.ring(stage, UDim2.fromOffset(s.b.X, s.b.Y), red, 46, 2, 0.45 * speed)
					end
					newStream(s, false)
				else
					s.f.BackgroundTransparency = 1
					s.u = 2
				end
			elseif s.u >= 0 then
				local p2 = bez(s, s.u)
				local p1 = bez(s, math.max(s.u - s.tail, 0))
				local d = p2 - p1
				local len = d.Magnitude
				s.f.Position = UDim2.fromOffset((p1.X + p2.X) / 2, (p1.Y + p2.Y) / 2)
				s.f.Size = UDim2.fromOffset(len + 1, s.th)
				s.f.Rotation = math.deg(math.atan2(d.Y, d.X))
				s.f.BackgroundColor3 = red:Lerp(Themes.demon.accent2, s.u)
				s.f.BackgroundTransparency = math.clamp(1 - math.sin(math.pi * s.u) ^ 0.5, 0, 1)
			else
				s.f.BackgroundTransparency = 1
			end
		end
	end)
	spinConn:Disconnect()
	anim(sipProgress, "v", 1, 2.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Fn.playSound("Rise", 1)
	w(2.8)
	siphonOn = false
	statusLabel.Text = "[ OK ]  bound"
	w(0.35)
	sipConn:Disconnect()
	for _, s in ipairs(streams) do
		s.f:Destroy()
	end
	W.dock.Position = UDim2.new(0.5, 0, 1, -12)
	W.dockScale.Scale = sc

	local logoPos = P(44, 35)
	tween(star, 0.8 * speed, { Position = UDim2.fromOffset(logoPos.X, logoPos.Y) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	tween(starScale, 0.8 * speed, { Scale = 0.12 * sc }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	local dive = runService.RenderStepped:Connect(function(dt)
		spinDeg += 3000 * dt
		star.Rotation = spinDeg % 360
	end)
	w(0.8)
	dive:Disconnect()
	star:Destroy()
	Fn.ring(gui, UDim2.fromOffset(logoPos.X, logoPos.Y), red, 220, 4, 0.8 * speed)
	flash(red, 0.25, 0.6)
	Fn.playSound("Boom", 0.7, 1.4)
	State.logoSpin = 1800

	S.progress = 1
	tween(cover, 1.1 * speed, { BackgroundTransparency = 1 })
	tween(blur, 1.1 * speed, { Size = 0 })
	for _, s in ipairs(bgStars) do
		tween(s.f, 0.8 * speed, { BackgroundTransparency = 1 })
	end
	tween(titleLabel, 0.6 * speed, { TextTransparency = 1 })
	tween(statusLabel, 0.6 * speed, { TextTransparency = 1 })
	tween(percentLabel, 0.6 * speed, { TextTransparency = 1 })
	tween(barFill, 0.6 * speed, { BackgroundTransparency = 1 })
	w(1.2)

	rs:Disconnect()
	skipConn:Disconnect()
	cover:Destroy()
	stage:Destroy()
	flashFrame:Destroy()
	blur:Destroy()
	State.ready = true
	Fn.notify(CONFIG.Name .. " is online", "Press " .. tostring(Values.smartbar) .. " to toggle the dock.", "pent")
	task.defer(function()
		pcall(Fn.runTutorial)
	end)
end

function Fn.isTutorialDone()
	if Values.tutorialDone == true then
		return true
	end
	if isfile and readfile then
		local ok, raw = pcall(function()
			if isfile(folderPath("tutorial.json")) then
				return readfile(folderPath("tutorial.json"))
			end
		end)
		if ok and type(raw) == "string" and raw:find('"done"%s*:%s*true') then
			Values.tutorialDone = true
			return true
		end
	end
	return false
end

function Fn.saveTutorialDone()
	Values.tutorialDone = true
	pcall(Fn.saveSettings)
	Fn.ensureFolders()
	if writefile then
		pcall(writefile, folderPath("tutorial.json"), '{"done":true,"at":' .. tostring(os.time()) .. "}")
	end
end

function Fn.runTutorial()
	if Fn.isTutorialDone() then
		return
	end
	if not Fn.alive or not Fn.alive() then
		return
	end

	if not State.dockOpen then
		pcall(Fn.setDock, true)
	end
	task.wait(0.3)
	pcall(Fn.closeAllPanels)
	if W.settingsWin and W.settingsWin.open then
		pcall(W.settingsWin.hide)
	end
	if W.musicWin and W.musicWin.open then
		pcall(W.musicWin.hide)
	end
	pcall(Fn.setHome, false)

	local root = new("Frame", {
		Name = "SchweinsTutorial", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
		BorderSizePixel = 0, ZIndex = 200,
	}, gui)

	local dims = {}
	for i = 1, 4 do
		local d = new("Frame", {
			BackgroundTransparency = 0.28, BorderSizePixel = 0, ZIndex = 200, Active = true,
		}, root)
		reg(d, "BackgroundColor3", "bg")
		dims[i] = d
	end

	local ring = new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 201, Active = false, Visible = false,
	}, root)
	local ringStroke = new("UIStroke", { Thickness = 2.5, Transparency = 0.05 }, ring)
	reg(ringStroke, "Color", "accent")
	round(ring, 16)

	local tip = new("Frame", {
		Size = UDim2.fromOffset(360, 178), BorderSizePixel = 0, ZIndex = 220, Active = true,
	}, root)
	reg(tip, "BackgroundColor3", "bg")
	round(tip, 16)
	Fn.animStroke(tip, 40)
	Fn.glow(tip, 14)

	local tipStep = ttxt(tip, {
		Position = UDim2.fromOffset(16, 12), Size = UDim2.fromOffset(200, 14), Text = "", TextSize = 11, ZIndex = 221,
	}, "muted")
	local tipTitle = ttxt(tip, {
		Position = UDim2.fromOffset(16, 30), Size = UDim2.fromOffset(328, 22), Text = "", TextSize = 17,
		Font = Enum.Font.GothamBold, ZIndex = 221,
	}, "text")
	local tipBody = ttxt(tip, {
		Position = UDim2.fromOffset(16, 56), Size = UDim2.fromOffset(328, 78), Text = "", TextSize = 13,
		TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 221,
	}, "muted")
	local tipAction = ttxt(tip, {
		Position = UDim2.fromOffset(16, 140), Size = UDim2.fromOffset(200, 18), Text = "", TextSize = 12,
		Font = Enum.Font.GothamBold, ZIndex = 221,
	}, "accent")

	local nameBox = new("TextBox", {
		Position = UDim2.fromOffset(16, 100), Size = UDim2.fromOffset(240, 32), Text = "",
		PlaceholderText = "e.g. Pastel", Font = Enum.Font.GothamMedium, TextSize = 14,
		ClearTextOnFocus = false, BorderSizePixel = 0, Visible = false, ZIndex = 222,
	}, tip)
	reg(nameBox, "BackgroundColor3", "tile")
	reg(nameBox, "TextColor3", "text")
	reg(nameBox, "PlaceholderColor3", "muted")
	round(nameBox, 8)

	local keyPreview = ttxt(tip, {
		Position = UDim2.fromOffset(16, 100), Size = UDim2.fromOffset(200, 36), Text = "",
		TextSize = 22, Font = Enum.Font.GothamBold, Visible = false, ZIndex = 222,
	}, "accent")

	local skipBtn = new("TextButton", {
		AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -12, 1, -12), Size = UDim2.fromOffset(88, 30),
		Text = "Skip all", Font = Enum.Font.GothamBold, TextSize = 11, AutoButtonColor = false,
		BorderSizePixel = 0, ZIndex = 222,
	}, tip)
	reg(skipBtn, "BackgroundColor3", "tile")
	reg(skipBtn, "TextColor3", "muted")
	round(skipBtn, 9)

	local continueBtn = new("TextButton", {
		AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -108, 1, -12), Size = UDim2.fromOffset(88, 30),
		Text = "Continue", Font = Enum.Font.GothamBold, TextSize = 11, AutoButtonColor = false,
		BorderSizePixel = 0, ZIndex = 222, Visible = false,
	}, tip)
	reg(continueBtn, "BackgroundColor3", "accent")
	reg(continueBtn, "TextColor3", "text")
	round(continueBtn, 9)

	local liveConn, clickConn, keyConn
	local stepIndex = 0
	local finished = false
	local onContinue
	local holePad = 12
	local currentKind
	local currentTarget

	local function clearHooks()
		if liveConn then liveConn:Disconnect() liveConn = nil end
		if clickConn then clickConn:Disconnect() clickConn = nil end
		if keyConn then keyConn:Disconnect() keyConn = nil end
		State.checkingKey = nil
		onContinue = nil
		continueBtn.Visible = false
		nameBox.Visible = false
		keyPreview.Visible = false
	end

	local function finish()
		if finished then return end
		finished = true
		clearHooks()
		Fn.saveTutorialDone()
		if root.Parent then root:Destroy() end
		Fn.notify("Tutorial done", "Press " .. tostring(Values.smartbar) .. " for the dock anytime.", "ok")
	end

	local function screenSize()
		return workspace.CurrentCamera.ViewportSize
	end

	local function resolveRect()
		local vp = screenSize()
		local sw, sh = vp.X, vp.Y
		local kind = currentKind

		if kind == "cmd" then
			local scale = 1
			if W.cmdBar then
				local us = W.cmdBar:FindFirstChildOfClass("UIScale")
				if us then scale = us.Scale end
			end
			local width = 540 * scale
			local height = 48 * scale
			if W.cmdBar and W.cmdOpen then

				height = 52 * scale
			end
			return Vector2.new(sw * 0.5 - width * 0.5, sh * 0.14), Vector2.new(width, height)
		end

		if kind and kind:sub(1, 5) == "dock:" then
			local name = kind:sub(6)
			local entry = W.buttons and W.buttons[name]
			if not entry then return nil, nil end
			local scale = (W.dockScale and W.dockScale.Scale) or 1
			local dw, dh = 581 * scale, 70 * scale
			local dx = sw * 0.5 - dw * 0.5
			local dy = sh - 12 - dh
			local bw, bh = 44 * scale, 44 * scale
			local cx = dx + (entry.x or 290.5) * scale
			local cy = dy + 35 * scale
			return Vector2.new(cx - bw * 0.5, cy - bh * 0.5), Vector2.new(bw, bh)
		end

		if kind == "music" then
			local w, h = 440, 520
			return Vector2.new(sw * 0.5 - w * 0.5, sh * 0.45 - h * 0.5), Vector2.new(w, h)
		end

		if kind == "settings" then
			local w, h = 613, 384
			return Vector2.new(sw * 0.5 - w * 0.5, sh * 0.45 - h * 0.5), Vector2.new(w, h)
		end

		if kind == "general" then

			local ww, wh = 613, 384
			local sx = sw * 0.5 - ww * 0.5
			local sy = sh * 0.45 - wh * 0.5
			return Vector2.new(sx + 26, sy + 100), Vector2.new(179, 106)
		end

		if currentTarget and currentTarget.Parent then
			local pos = currentTarget.AbsolutePosition
			local size = currentTarget.AbsoluteSize
			local insetY = 0
			pcall(function()
				insetY = game:GetService("GuiService"):GetGuiInset().Y
			end)

			return Vector2.new(pos.X, pos.Y + insetY * 0), size
		end
		return nil, nil
	end

	local function layoutAround()
		local vp = screenSize()
		local sw, sh = vp.X, vp.Y
		local pos, size = resolveRect()
		if not pos then
			for _, d in ipairs(dims) do
				d.Position = UDim2.new()
				d.Size = UDim2.fromScale(1, 1)
			end
			ring.Visible = false
			return
		end
		local x = pos.X - holePad
		local y = pos.Y - holePad
		local w = size.X + holePad * 2
		local h = size.Y + holePad * 2
		dims[1].Position = UDim2.fromOffset(0, 0)
		dims[1].Size = UDim2.fromOffset(sw, math.max(0, y))
		dims[2].Position = UDim2.fromOffset(0, y + h)
		dims[2].Size = UDim2.fromOffset(sw, math.max(0, sh - (y + h)))
		dims[3].Position = UDim2.fromOffset(0, y)
		dims[3].Size = UDim2.fromOffset(math.max(0, x), h)
		dims[4].Position = UDim2.fromOffset(x + w, y)
		dims[4].Size = UDim2.fromOffset(math.max(0, sw - (x + w)), h)
		ring.Visible = true
		ring.Position = UDim2.fromOffset(x, y)
		ring.Size = UDim2.fromOffset(w, h)

		local tipW, tipH = 360, 178
		local tx = math.clamp(x + w * 0.5 - tipW * 0.5, 12, sw - tipW - 12)
		local ty = y + h + 14
		if ty + tipH > sh - 10 then
			ty = y - tipH - 14
		end
		if ty < 10 then
			ty = math.clamp(sh * 0.5 - tipH * 0.5, 10, sh - tipH - 10)
		end
		tip.Position = UDim2.fromOffset(tx, ty)
	end

	local function watch(kind, target)
		clearHooks()
		currentKind = kind
		currentTarget = target
		layoutAround()
		liveConn = runService.RenderStepped:Connect(layoutAround)
	end

	local function fullDim()
		clearHooks()
		currentKind, currentTarget = nil, nil
		for _, d in ipairs(dims) do
			d.Position = UDim2.new()
			d.Size = UDim2.fromScale(1, 1)
		end
		ring.Visible = false
		local vp = screenSize()
		tip.Position = UDim2.fromOffset(vp.X * 0.5 - 180, vp.Y * 0.5 - 90)
	end

	local function setTip(n, total, title, body, action)
		tipStep.Text = n .. " / " .. total
		tipTitle.Text = title
		tipBody.Text = body
		tipAction.Text = action or ""
	end

	local steps = {}
	local function nextStep()
		if finished then return end
		stepIndex += 1
		local s = steps[stepIndex]
		if not s then
			finish()
			return
		end
		s()
	end

	continueBtn.MouseButton1Click:Connect(function()
		Fn.playSound("Click")
		if onContinue then
			local fn = onContinue
			onContinue = nil
			fn()
		else
			nextStep()
		end
	end)

	local TOTAL = 8

	steps = {

		function()
			pcall(Fn.setHome, false)
			pcall(Fn.closeAllPanels)
			pcall(Fn.openCmdBar)
			task.wait(0.3)
			setTip(1, TOTAL, "Command bar", "Type fly and press Enter. Flight should turn on.", "Type fly → Enter")
			watch("cmd", W.cmdBar)
			if W.cmdBox then
				pcall(function() W.cmdBox:CaptureFocus() end)
			end
			task.spawn(function()
				local t0 = os.clock()
				while not finished and stepIndex == 1 do
					if Fn.Actions and Fn.Actions[2] and Fn.Actions[2].enabled then
						task.wait(0.3)
						nextStep()
						return
					end
					task.wait(0.2)
					if os.clock() - t0 > 120 then return end
				end
			end)
		end,

		function()
			pcall(Fn.setHome, false)
			if W.musicWin then
				pcall(function() W.musicWin.show() end)
				task.wait(0.35)
				setTip(2, TOTAL, "Music", "Drop .mp3 / .ogg / .wav into SchweinsAdmin/Music in your executor workspace. Refresh, then + to queue a track.", "Continue when ready")
				watch("music", W.musicWin.frame)
				continueBtn.Visible = true
				onContinue = nextStep
			else
				fullDim()
				setTip(2, TOTAL, "Music", "This executor can't play custom audio (no getcustomasset). Skipping music.", "Continue")
				continueBtn.Visible = true
				onContinue = nextStep
			end
		end,

		function()
			if W.musicWin and W.musicWin.open then pcall(W.musicWin.hide) end
			pcall(Fn.closeAllPanels)
			if not State.dockOpen then pcall(Fn.setDock, true) task.wait(0.3) end
			local btn = W.buttons and W.buttons.Settings and W.buttons.Settings.button
			setTip(3, TOTAL, "Settings", "Open Settings from the gear on the dock.", "Click the gear")
			watch("dock:Settings", btn)
			if btn then
				clickConn = btn.MouseButton1Click:Connect(function()
					task.wait(0.45)
					nextStep()
				end)
			else
				continueBtn.Visible = true
				onContinue = nextStep
			end
		end,

		function()
			if not (W.settingsWin and W.settingsWin.open) then
				pcall(function() if W.settingsWin then W.settingsWin.show() end end)
				task.wait(0.35)
			end
			local general = W.settingsCats and W.settingsCats.General
			setTip(4, TOTAL, "General", "Open the General category — everyday toggles live here.", "Click GENERAL")
			watch("general", general)
			if general then
				clickConn = general.MouseButton1Click:Connect(function()
					task.wait(0.4)
					nextStep()
				end)
			else
				continueBtn.Visible = true
				onContinue = nextStep
			end
		end,

		function()
			if not (W.settingsWin and W.settingsWin.open) then
				pcall(function() if W.settingsWin then W.settingsWin.show() end end)
			end
			watch("settings", W.settingsWin and W.settingsWin.frame)
			setTip(5, TOTAL, "Explore General", "Scroll the list — anonymous mode, chat spy, load hidden, anti-idle, and more. Flip a toggle if you want, then continue.", "Continue when you've looked around")
			continueBtn.Visible = true
			onContinue = nextStep
		end,

		function()
			if W.settingsWin and W.settingsWin.open then pcall(W.settingsWin.hide) end
			fullDim()
			local cur = tostring(Values.smartbar or "K")
			setTip(6, TOTAL, "Dock keybind", "Choose the key that shows and hides the dock. Press any key, or keep what you have.", "Press a key or Continue")
			keyPreview.Visible = true
			keyPreview.Text = "Current: " .. cur
			continueBtn.Visible = true
			onContinue = nextStep
			State.checkingKey = "smartbar"
			keyConn = userInputService.InputBegan:Connect(function(input, gpe)
				if finished or stepIndex ~= 6 then return end
				if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
				if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then return end

				Values.smartbar = input.KeyCode.Name
				pcall(Fn.saveSettings)
				keyPreview.Text = "Set: " .. Values.smartbar
				State.checkingKey = nil
				Fn.notify("Dock key set", "Toggle with " .. Values.smartbar .. ".", "ok")
				task.wait(0.25)
				nextStep()
			end)
		end,

		function()
			fullDim()
			setTip(7, TOTAL, "Your name", "Home greets you with this name. Type one, or leave blank to use your Roblox display name.", "Type a name → Continue")
			nameBox.Visible = true
			nameBox.Text = type(Values.welcomeName) == "string" and Values.welcomeName or ""
			pcall(function() nameBox:CaptureFocus() end)
			continueBtn.Visible = true
			onContinue = function()
				Values.welcomeName = tostring(nameBox.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
				pcall(Fn.saveSettings)
				pcall(Fn.updateHome)
				nextStep()
			end
		end,

		function()
			fullDim()
			local greet = (Values.welcomeName ~= "" and Values.welcomeName) or localPlayer.DisplayName
			setTip(8, TOTAL, "You're good, " .. greet, "Command bar, music, settings, General, your key, your name. Anti VC Ban is on Home when you need it.", "Finish")
			continueBtn.Visible = true
			continueBtn.Text = "Finish"
			onContinue = finish
		end,
	}

	skipBtn.MouseButton1Click:Connect(function()
		Fn.playSound("Click")
		finish()
	end)

	nextStep()
end

function Fn.start()
	Fn.buildDock()
	Fn.buildCharacter()
	Fn.buildScripts()
	Fn.buildPlayerlist()
	Fn.buildHome()
	Fn.buildMusic()
	Fn.buildSettings()
	Fn.buildScriptWindow()
	Fn.buildInput()
	Fn.buildLoops()
	Fn.installInterception()
	Fn.initAntiKick()

	for _, p in ipairs(players:GetPlayers()) do
		Fn.createEsp(p)
		track(p.Chatted:Connect(function(m)
			Fn.onChatted(p, m)
		end))
	end

	track(players.PlayerAdded:Connect(function(player)
		if not Fn.alive() then
			return
		end
		W.createRow(player)
		W.sortRows()
		Fn.createEsp(player)
		track(player.Chatted:Connect(function(m)
			Fn.onChatted(player, m)
		end))
		if Values.logplr then
			Fn.postWebhook(Values.logplrurl, {
				content = player.DisplayName .. " (@" .. player.Name .. ") joined the server.", username = player.DisplayName, allowed_mentions = { parse = {} },
				avatar_url = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. player.UserId .. "&width=420&height=420&format=png",
			})
		end
		if Values.moddetection and creatorType == Enum.CreatorType.Group then
			task.spawn(function()
				local ok, role = pcall(player.GetRoleInGroup, player, creatorId)
				if ok and type(role) == "string" then
					for _, keyword in ipairs({ "mod", "admin", "staff", "dev", "founder", "owner", "supervis", "manager", "management", "executive", "president", "chairman", "director" }) do
						if string.find(string.lower(role), keyword, 1, true) then
							Fn.promptModerator(player, role)
							Fn.notify("Administrator Joined", role .. " " .. player.DisplayName .. " has joined your session.", "warn")
							break
						end
					end
				end
			end)
		end
		if Values.friendnotifs then
			local ok, friend = pcall(localPlayer.IsFriendsWith, localPlayer, player.UserId)
			if ok and friend then
				Fn.notify("Friend Joined", "Your friend " .. player.DisplayName .. " has joined your server.", "info")
			end
		end
	end))

	track(players.PlayerRemoving:Connect(function(player)
		if Values.logplr then
			Fn.postWebhook(Values.logplrurl, {
				content = player.DisplayName .. " (@" .. player.Name .. ") left the server.", username = player.DisplayName, allowed_mentions = { parse = {} },
				avatar_url = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. player.UserId .. "&width=420&height=420&format=png",
			})
		end
		if State.spectating == player then
			Fn.restoreCamera()
		end
		if W.plRows[player] then
