function Fn.setDock(open)
	State.dockOpen = open
	if not open then
		Fn.closeAllPanels()
		Fn.setHome(false)
		if W.settingsWin then
			W.settingsWin.hide()
		end
		if W.musicWin then
			W.musicWin.hide()
		end
		if W.scriptWin then
			W.scriptWin.hide()
		end
		for name, dw in pairs(W.dockWindows or {}) do
			if dw and dw.dockLinked then
				pcall(dw.hide)
			end
		end
	end
	tween(W.dock, 0.65, { Position = UDim2.new(0.5, 0, 1, open and -12 or 110) }, Enum.EasingStyle.Back)
	tween(W.chevron, 0.65, { Position = UDim2.new(0.5, 0, 1, Fn.chevronY(false)) }, Enum.EasingStyle.Quint)
	tween(W.chevron, 0.65, { Rotation = open and 0 or 180 }, Enum.EasingStyle.Back)
	Fn.playSound(open and "Open" or "Close")
	if open and State.ready and not Fn.anyPanelOpen() then
		Fn.setHome(true)
	end
end

function Fn.toggleFromDock(name)
	local dw = W.dockWindows and W.dockWindows[name]
	if dw then
		if dw.open then
			dw.hide()
		else
			dw.show()
		end
	elseif name == "Settings" then
		if W.settingsWin.open then
			W.settingsWin.hide()
		else
			W.settingsWin.show()
		end
	elseif name == "Music" then
		if W.musicWin.open then
			W.musicWin.hide()
		else
			W.musicWin.show()
		end
	else
		if Fn.Panels[name].open then
			Fn.closePanel(name)
			Fn.setHome(true)
		else
			Fn.setHome(false)
			Fn.openPanel(name)
		end
	end
end

function Fn.getMovers()
	local bv = State.movers[1]
	if bv then
		local ok = pcall(function()
			bv.Parent = bv.Parent
		end)
		if not ok then
			State.movers = {}
			bv = nil
		end
	end
	if not bv then
		local bodyVelocity = Instance.new("BodyVelocity")
		bodyVelocity.MaxForce = Vector3.one * 9e9
		local bodyGyro = Instance.new("BodyGyro")
		bodyGyro.MaxTorque = Vector3.one * 9e9
		bodyGyro.P = 9e4
		local bodyAngular = Instance.new("BodyAngularVelocity")
		bodyAngular.AngularVelocity = Vector3.yAxis * 9e9
		bodyAngular.MaxTorque = Vector3.yAxis * 9e9
		bodyAngular.P = 9e9
		State.movers = { bodyVelocity, bodyGyro, bodyAngular }
	end
	return State.movers[1], State.movers[2], State.movers[3]
end

