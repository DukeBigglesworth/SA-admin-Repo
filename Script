		local function sample(frames, t)
			local n = #frames
			if n == 1 or t <= frames[1].t then
				return frames[1].p
			end
			for i = 1, n - 1 do
				local a, b = frames[i], frames[i + 1]
				if t >= a.t and t <= b.t then
					local span = b.t - a.t
					local alpha = span > 0 and (t - a.t) / span or 0
					local out = {}
					for name, cfa in pairs(a.p) do
						local cfb = b.p[name]
						out[name] = cfb and cfa:Lerp(cfb, alpha) or cfa
					end
					return out
				end
			end
			return frames[n].p
		end

