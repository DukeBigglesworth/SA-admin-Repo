function Fn.pentagram(parent, size, key, fixed)
	local c = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 }, parent)
	local parts = { lines = {}, strokes = {}, runes = {} }
	local function paint(inst, prop)
		if key then
			reg(inst, prop, key)
		else
			inst[prop] = fixed
		end
	end
	local function ring(scale, thick)
		local r = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(scale, scale), BackgroundTransparency = 1, BorderSizePixel = 0 }, c)
		round(r, 9999)
		local s = stroke(r, nil, 0, math.max(1, thick))
		paint(s, "Color")
		parts.strokes[#parts.strokes + 1] = s
	end
	ring(0.98, size / 60)
	ring(0.86, size / 90)
	local verts = {}
	local radius = size * 0.43
	for k = 0, 4 do
		local a = math.rad(-90 + k * 72)
		verts[k] = Vector2.new(math.cos(a) * radius, math.sin(a) * radius)
	end
	for k = 0, 4 do
		local a, b = verts[k], verts[(k + 2) % 5]
		local mid, d = (a + b) / 2, b - a
		local line = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, mid.X, 0.5, mid.Y), Size = UDim2.fromOffset(d.Magnitude, math.max(1.5, size / 70)),
			Rotation = math.deg(math.atan2(d.Y, d.X)), BorderSizePixel = 0,
		}, c)
		paint(line, "BackgroundColor3")
		parts.lines[#parts.lines + 1] = line
	end
	if size >= 120 then
		local runeRing = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, c)
		parts.runeRing = runeRing
		for k = 0, 35 do
			local a = math.rad(k * 10)
			local rr = size * 0.5 * 0.92
			local long = k % 3 == 0
			local rune = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, math.cos(a) * rr, 0.5, math.sin(a) * rr),
				Size = UDim2.fromOffset(long and size / 28 or size / 70, size / 70 + 1), Rotation = k * 10, BorderSizePixel = 0,
			}, runeRing)
			paint(rune, "BackgroundColor3")
			parts.runes[#parts.runes + 1] = rune
		end
	end
	return c, parts
end

function Fn.tintPent(parts, color, t)
	for _, l in ipairs(parts.lines) do
		tween(l, t, { BackgroundColor3 = color })
	end
	for _, s in ipairs(parts.strokes) do
		tween(s, t, { Color = color })
	end
	for _, r in ipairs(parts.runes) do
		tween(r, t, { BackgroundColor3 = color })
	end
end

function Fn.icon(parent, kind, size, key)
	local c = new("CanvasGroup", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 }, parent)
	local k = key
	local s = size / 20
	local function shape(o)
		local f = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, (o.x or 0) * s, 0.5, (o.y or 0) * s), Size = UDim2.fromOffset(o.w * s, (o.h or o.w) * s),
			Rotation = o.rot or 0, BorderSizePixel = 0, BackgroundTransparency = o.ring and 1 or 0,
