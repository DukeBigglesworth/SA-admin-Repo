local Air = {}
local function airStop()
	if Air.conn then
		Air.conn:Disconnect()
		Air.conn = nil
	end
	if Air.part then
		Air.part:Destroy()
		Air.part = nil
	end
end

local function airStart(upKey, downKey, speed)
	airStop()
	local r, h = root(), hum()
	if not r then
		error("__silent", 0)
	end
	local drop = 3
	if h and h.RigType == Enum.HumanoidRigType.R15 then
		drop = h.HipHeight + r.Size.Y / 2
	end
	Air.y = r.Position.Y - drop - 0.5
	Air.speed = speed
	local p = Instance.new("Part")
	p.Name = "SchweinsAir"
	p.Anchored = true
	p.CanCollide = true
	p.Transparency = 1
	p.Size = Vector3.new(7, 1, 7)
	p.CastShadow = false
	p.CFrame = CFrame.new(r.Position.X, Air.y, r.Position.Z)
	p.Parent = workspace.CurrentCamera
	Air.part = p
	Air.conn = runService.Heartbeat:Connect(function(dt)
		local rr = root()
		if not rr or not Air.part then
			return
		end
		if not typing() then
			if down(upKey) then
				Air.y += Air.speed * dt
			end
			if down(downKey) then
				Air.y -= Air.speed * dt
			end
		end
		Air.part.CFrame = CFrame.new(rr.Position.X, Air.y, rr.Position.Z)
	end)
end

