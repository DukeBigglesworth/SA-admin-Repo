local function favs()
	return Fn.tableValue("emoteFavs")
end

function An.isFav(id)
	for _, s in ipairs(favs()) do
		if s:match("^(%d+)|") == tostring(id) then
			return true
		end
	end
	return false
end

function An.toggleFav(item)
	local list = favs()
	for i, s in ipairs(list) do
		if s:match("^(%d+)|") == tostring(item.id) then
			table.remove(list, i)
			Fn.saveSettings()
			return false
		end
	end
	table.insert(list, 1, tostring(item.id) .. "|" .. tostring(item.name) .. "|" .. tostring(item.kind or "emote"))
	Fn.saveSettings()
	return true
end

function An.favItems()
	local out = {}
	for _, s in ipairs(favs()) do
		local id, name, kind = s:match("^(%d+)|(.-)|(%a+)$")
		if not id then
			id, name = s:match("^(%d+)|(.*)$")
			kind = "emote"
		end
		if id then
			out[#out + 1] = { id = id, name = name or id, kind = kind or "emote" }
		end
	end
	return out
end

function An.findEmote(q)
	q = lower(tostring(q or ""))
	if q == "" then
		return nil
	end
	for _, e in ipairs(Fn.EMOTES) do
		if lower(e.name) == q then
			return e
		end
	end
	for _, e in ipairs(Fn.EMOTES) do
		if string.find(lower(e.name), q, 1, true) then
			return e
		end
	end
	return nil
end

local function currentAnimate()
	local c = localPlayer.Character
	return c and c:FindFirstChild("Animate")
end

function An.applyCategory(cat, pack)
	local animate = currentAnimate()
	if not animate then
		return false
	end
	for i, slot in ipairs(PACK_MAP[cat]) do
		local folder = animate:FindFirstChild(slot[1])
		local anim = folder and folder:FindFirstChild(slot[2])
		local id = cat == "idle" and pack.idle[i] or (i == 1 and pack[cat] or nil)
		if anim and id then
			if An.origPack[anim] == nil then
				An.origPack[anim] = anim.AnimationId
			end
			anim.AnimationId = "http://www.roblox.com/asset/?id=" .. id
		end
	end
	return true
end

function An.refreshAnimate()
	local animate = currentAnimate()
	local h = Fn.hum()
	if not animate or not h then
		return
	end
	animate.Disabled = true
	for _, t in ipairs(h:GetPlayingAnimationTracks()) do
		t:Stop(0)
	end
	task.wait()
	animate.Disabled = false
end

function An.applyPack(packName, cats)
	local pack = Fn.packByName(packName)
	if not pack then
		return Fn.notify("Animation Pack", "No pack matches '" .. tostring(packName) .. "'.", "warn")
	end
	if not currentAnimate() then
		return Fn.notify("Animation Pack", "Your character has no Animate script to modify.", "warn")
	end
	for _, cat in ipairs(cats or CATS) do
		if (cat == "idle" and pack.idle[1]) or pack[cat] then
			An.applyCategory(cat, pack)
			An.packSel[cat] = pack.name
		end
	end
	Values.animPackSel = An.packSel
	Fn.saveSettings()
	task.spawn(An.refreshAnimate)
	An.refreshNow()
	Fn.notify("Animation Pack", pack.name .. (cats and (" applied to " .. table.concat(cats, ", ")) or " applied"), "ok")
end

function An.resetPacks()
	for anim, id in pairs(An.origPack) do
		if anim.Parent then
			anim.AnimationId = id
		end
	end
	An.origPack = {}
	An.packSel = {}
	Values.animPackSel = An.packSel
	Fn.saveSettings()
	task.spawn(An.refreshAnimate)
	An.refreshNow()
	Fn.notify("Animation Pack", "Back to your game's default animations.", "info")
end

function An.copyFrom(player)
	local c = player.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	local a = h and h:FindFirstChildOfClass("Animator")
	if not a then
		return Fn.notify("Copy Emote", player.DisplayName .. " has no animator right now.", "warn")
	end
	local copied = 0
	An.stopTrack()
	for _, tr in ipairs(a:GetPlayingAnimationTracks()) do
		if tr.Priority.Value >= Enum.AnimationPriority.Action.Value and tr.Animation then
			local id = cleanId(tr.Animation.AnimationId)
			if id then
				task.spawn(function()
					local mine = loadAnim(id)
					if mine then
						mine.Priority = tr.Priority
						mine.Looped = tr.Looped
						mine:Play(0.2, 1, tr.Speed)
						mine.TimePosition = tr.TimePosition
						An.extras[#An.extras + 1] = mine
					end
				end)
				copied += 1
			end
		end
	end
	if copied == 0 then
		Fn.notify("Copy Emote", player.DisplayName .. " isn't playing an emote or action animation.", "warn")
	else
		An.name = player.DisplayName .. " (copied)"
		An.refreshNow()
		Fn.notify("Copy Emote", "Copied " .. copied .. " animation(s) from " .. player.DisplayName .. ".", "ok")
	end
end

Fn.toggle("Animation", "syncemote", "syncemote <player>", "Mirror a player's emotes continuously", {
	title = "Sync Emote",
	on = function(args)
		local p = Fn.target1(args[1])
		if not p then
			error("__silent", 0)
		end
		local mirrored = {}
		local acc = 0
		Fn.loop("syncemote", function(dt)
			acc += dt
			if acc < 0.25 then
				return
			end
			acc = 0
			local h = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
			local a = h and h:FindFirstChildOfClass("Animator")
			if not a then
				return
			end
			local live = {}
			for _, tr in ipairs(a:GetPlayingAnimationTracks()) do
				if tr.Priority.Value >= Enum.AnimationPriority.Action.Value and tr.Animation then
					local id = cleanId(tr.Animation.AnimationId)
					if id then
						live[id] = tr
						if not mirrored[id] then
							mirrored[id] = "loading"
							task.spawn(function()
								local mine = loadAnim(id)
								if mine then
									mine.Priority = tr.Priority
									mine.Looped = tr.Looped
									mine:Play(0.15, 1, tr.Speed)
									mine.TimePosition = tr.TimePosition
									mirrored[id] = mine
								else
									mirrored[id] = nil
								end
							end)
						end
					end
				end
			end
			for id, mine in pairs(mirrored) do
				if not live[id] and typeof(mine) == "Instance" then
					pcall(function()
						mine:Stop(0.2)
					end)
					mirrored[id] = nil
				end
			end
		end)
		Mod.syncMirrored = mirrored
	end,
	off = function()
		Fn.unloop("syncemote")
		for _, mine in pairs(Mod.syncMirrored or {}) do
			if typeof(mine) == "Instance" then
				pcall(function()
					mine:Stop(0.2)
				end)
			end
		end
		Mod.syncMirrored = nil
	end,
})

local function logTrack(player, track)
	if not An.logOn then
		return
	end
	local anim = track.Animation
	local id = anim and cleanId(anim.AnimationId)
	if not id then
		return
	end
	if not An.logAll and track.Priority.Value < Enum.AnimationPriority.Action.Value then
		return
	end
	table.insert(An.log, 1, { t = os.date("%H:%M:%S"), player = player.Name, display = player.DisplayName, id = id, name = anim.Name, priority = track.Priority.Name, length = track.Length })
	if #An.log > 300 then
		table.remove(An.log)
	end
	if An.onLog then
		pcall(An.onLog)
	end
end

local function watchPlayer(p)
	local function hook(char)
		local h = char:WaitForChild("Humanoid", 6)
		local a = h and (h:FindFirstChildOfClass("Animator") or h:WaitForChild("Animator", 4))
		if a and An.logOn then
			An.logConns[#An.logConns + 1] = a.AnimationPlayed:Connect(function(tr)
				logTrack(p, tr)
			end)
		end
	end
	if p.Character then
		task.spawn(hook, p.Character)
	end
	An.logConns[#An.logConns + 1] = p.CharacterAdded:Connect(function(ch)
		task.spawn(hook, ch)
	end)
end

function An.setLogger(on)
	for _, c in ipairs(An.logConns) do
		c:Disconnect()
	end
	An.logConns = {}
	An.logOn = on and true or false
	if on then
		for _, p in ipairs(players:GetPlayers()) do
			watchPlayer(p)
		end
		An.logConns[#An.logConns + 1] = players.PlayerAdded:Connect(watchPlayer)
	end
	if An.onLog then
		pcall(An.onLog)
	end
end
Fn.onCleanup(function()
	An.setLogger(false)
end)

function An.catalogSearch(q, done)
	task.spawn(function()
		local enc = httpService:UrlEncode(q)
		local urls = {
			"https://catalog.roblox.com/v1/search/items/details?Category=12&Subcategory=39&Keyword=" .. enc .. "&Limit=30&SortType=0",
			"https://catalog.roblox.com/v1/search/items/details?Keyword=" .. enc .. "&Limit=30&AssetTypes=61",
			"https://catalog.roblox.com/v1/search/items?keyword=" .. enc .. "&limit=30&category=AvatarAnimations&subcategory=EmoteAnimations",
		}
		local out = {}
		for _, url in ipairs(urls) do
			local data = Fn.fetch(url)
			if type(data) == "table" and type(data.data) == "table" and #data.data > 0 then
				for _, it in ipairs(data.data) do
					if it.id then
						local name = it.name
						if not name then
							local ok, info = pcall(mpService.GetProductInfo, mpService, it.id)
							name = ok and info and info.Name or ("Item " .. it.id)
						end
						out[#out + 1] = { name = name, id = tostring(it.id), kind = "emote", sub = "Catalog result  |  ID " .. it.id }
					end
				end
				if #out > 0 then
					break
				end
			end
		end
		done(out)
	end)
end

track(runService.Heartbeat:Connect(function()
	if An.track and An.cancelOnMove and An.kind and not An.paused and os.clock() - (An.startedAt or 0) > 0.4 then
		local h = Fn.hum()
		if h and h.MoveDirection.Magnitude > 0.1 then
			An.stop()
		end
	end
end))

track(localPlayer.CharacterAdded:Connect(function(char)
	An.track = nil
	An.extras = {}
	An.origPack = {}
	An.name = ""
	An.refreshNow()
	task.spawn(function()
		local animate = char:WaitForChild("Animate", 8)
		if not animate or Values.animPackAuto == false then
			return
		end
		task.wait(0.6)
		local sel = Values.animPackSel
		if type(sel) == "table" then
			local any = false
			for cat, packName in pairs(sel) do
				local pack = Fn.packByName(packName)
				if pack and PACK_MAP[cat] then
					An.applyCategory(cat, pack)
					An.packSel[cat] = pack.name
					any = true
				end
			end
			if any then
				An.refreshAnimate()
			end
		end
	end)
end))

local function playCmd(args, kind)
	local q = table.concat(args, " ")
	if q == "" then
		return Fn.notify("Animation", "Give a name or ID. Try: emote gangnam, anim 507771019", "warn")
	end
	local id = q:match("^%d+$")
	if id then
		return An.play(id, "ID " .. id, kind or "emote")
	end
	local e = An.findEmote(q)
	if not e then
		return Fn.notify("Emote Not Found", "'" .. q .. "' isn't in the built-in list. Open emotes and search the catalog, or use the ID.", "warn")
	end
	An.play(e.id, e.name, e.kind)
end

