function Fn.checkPing()
	local p = State.ping
	local current = Fn.ping()
	table.insert(p.recent, current)
	if #p.recent > 12 then
		table.remove(p.recent, 1)
	end
	if #p.base < 30 then
		table.insert(p.base, current >= 350 and 300 or current)
		return false
	end
	local avg = 0
	for _, v in ipairs(p.recent) do
		avg += v
	end
	avg /= #p.recent
	local sorted = table.clone(p.base)
	table.sort(sorted)
	local median = #sorted % 2 == 0 and (sorted[#sorted / 2] + sorted[#sorted / 2 + 1]) / 2 or sorted[math.ceil(#sorted / 2)]
	return avg > median * 1.75
end

function Fn.tick()
	W.clock.Text = os.date("%H:%M")
	task.spawn(Fn.updateHome)
	local anonNow, shieldNow = Fn.anonWanted(), Fn.shieldWanted()
	if (anonNow and not State.lastAnon) or (shieldNow and not State.lastShield) then
		Fn.sweepDescendants()
	end
	State.lastAnon, State.lastShield = anonNow, shieldNow
	if getConnectionsFor then
		pcall(function()
			for _, c in getConnectionsFor(localPlayer.Idled) do
				if Values.antiidle then
					c:Disable()
				else
					c:Enable()
				end
			end
		end)
	end
	local promptGui = coreGui:FindFirstChild("RobloxPromptGui")
	local overlay = promptGui and promptGui:FindFirstChild("promptOverlay")
	local errorPrompt = overlay and overlay:FindFirstChild("ErrorPrompt")
	if errorPrompt and not State.promptedDisconnect then
		State.promptedDisconnect = true
		local area = errorPrompt:FindFirstChild("MessageArea")
		local frame = area and area:FindFirstChild("ErrorFrame")
		local msg = frame and frame:FindFirstChild("ErrorMessage")
		Fn.promptDisconnect(msg and msg.Text or "")
	end
	if Fn.checkPing() and State.ping.cooldown <= 0 and Values.latencynotif then
		Fn.notify("High Latency Warning", "Your latency is higher than usual. You may lag or see delayed actions. Check for background downloads.", "warn")
		State.ping.cooldown = 120
	end
	if State.ping.cooldown > 0 then
		State.ping.cooldown -= 1
	end
	local fq = State.frame
	if fq.cooldown <= 0 and #fq.queue > 0 and Values.fpsnotif and fq.total / #fq.queue < 20 then
		Fn.notify("Degraded Performance", "Your frames per second have dropped. Check for background tasks on your machine.", "warn")
		fq.cooldown = 120
	end
	if fq.cooldown > 0 then
		fq.cooldown -= 1
	end
end

