		local function setMotion(slot, kind, moving)
			local want = moving and "move" or "idle"
			if slot.state == want then
				return
			end
			slot.state = want
			stopTrack(slot.track)
			slot.track = nil
			local id
			if want == "move" then
				id = Fn.styleAnimId(kind)
			else
				id = kind == "fly" and X.flyIdle or X.runIdle
			end
			if id then
				slot.track = loadTrack(id, nil, true)
				if slot.track then
					slot.track:Play(0.2)
				end
			end
		end

		local function clearMotion(slot)
			stopTrack(slot.track)
			slot.track = nil
			slot.state = nil
		end

		local stopMfly, stopCfly, stopMrun

		local function stopFlightModes(except)
			if except ~= "mfly" then
				stopMfly(true)
			end
