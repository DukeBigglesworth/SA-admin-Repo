local function cleanId(id)
	return tostring(id or ""):match("%d+")
end
Fn.cleanAnimId = cleanId

local function animator()
	local h = Fn.hum()
	if not h then
		return nil
	end
	return Fn.getAnimator(h)
end

local function loadAnim(id)
	local a = animator()
	if not a then
		return nil
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://" .. id
	local ok, tr = pcall(function()
		return a:LoadAnimation(anim)
	end)
	if not ok or not tr then
		return nil
	end
	local t0 = os.clock()
	while tr.Length == 0 and os.clock() - t0 < 1.6 do
		task.wait()
	end
	if tr.Length == 0 then
		tr:Destroy()
		return nil
	end
	return tr
end
Fn.loadAnimById = loadAnim

local function viaObjects(id)
	local ok, objs = pcall(function()
		return game:GetObjects("rbxassetid://" .. id)
	end)
	if not ok or type(objs) ~= "table" then
		return nil
	end
	for _, o in ipairs(objs) do
		local a = o:IsA("Animation") and o or o:FindFirstChildWhichIsA("Animation", true)
		if a then
			local inner = cleanId(a.AnimationId)
			if inner and inner ~= id then
				local tr = loadAnim(inner)
				if tr then
					return tr
				end
			end
		end
	end
	return nil
end

function An.refreshNow()
	if An.onChange then
		pcall(An.onChange)
	end
end

function An.stopTrack()
	local t = An.track
	An.track = nil
	if t then
		pcall(function()
			t:Stop(0.2)
		end)
	end
	for _, e in ipairs(An.extras) do
		pcall(function()
			e:Stop(0.2)
		end)
	end
	An.extras = {}
end

function An.stop()
	An.stopTrack()
	An.name = ""
	An.paused = false
	An.refreshNow()
end

function An.play(id, name, kind, opts)
	opts = opts or {}
	id = cleanId(id)
	if not id then
		return Fn.notify("Animation", "That isn't a valid animation ID.", "warn")
	end
	An.playToken = (An.playToken or 0) + 1
	local token = An.playToken
	task.spawn(function()
		An.stopTrack()
		An.paused = false
		local track
		if kind == "emote" then
			local h = Fn.hum()
			if h then
				local ok, success, tr = pcall(function()
					return h:PlayEmoteAndGetAnimTrackById(tonumber(id))
				end)
				if ok and success and tr then
					track = tr
				end
			end
		end
		if not track then
			track = loadAnim(id)
		end
		if not track and kind == "emote" then
			track = viaObjects(id)
		end
		if token ~= An.playToken then
			if track then
				pcall(function()
					track:Stop(0)
				end)
			end
			return
		end
		if not track then
			An.name = ""
			An.refreshNow()
			return Fn.notify("Animation", "Couldn't load " .. tostring(name or id) .. ". The asset may be private, deleted, or R6 only.", "warn")
		end
		track.Priority = An.priority
		track.Looped = opts.looped ~= nil and opts.looped or An.looped
		if not track.IsPlaying then
			track:Play(0.2, 1, An.speed)
		end
		track:AdjustSpeed(opts.speed or An.speed)
		An.track = track
		An.id = id
		An.kind = kind
		An.name = name or id
		An.startedAt = os.clock()
		An.refreshNow()
		track.Stopped:Connect(function()
			if An.track == track then
				An.track = nil
				An.name = ""
				An.refreshNow()
			end
		end)
	end)
end

function An.setSpeed(v)
	An.speed = v
	if An.track and not An.paused then
		pcall(function()
			An.track:AdjustSpeed(v)
		end)
	end
end

function An.setLoop(v)
	An.looped = v
	if An.track then
		pcall(function()
			An.track.Looped = v
		end)
	end
end

function An.togglePause()
	if not An.track then
		return
	end
	An.paused = not An.paused
	pcall(function()
		An.track:AdjustSpeed(An.paused and 0 or An.speed)
	end)
	An.refreshNow()
end

function An.setPriority(name)
	An.priority = Enum.AnimationPriority[name]
	if An.track then
		pcall(function()
			An.track.Priority = An.priority
		end)
	end
	An.refreshNow()
