function Fn.closePanel(name)
	local p = Fn.Panels[name]
	if not p or not p.open then
		return
	end
	p.open = false
	local db = W.buttons[name]
	tween(db.dot, 0.3, { Size = UDim2.fromOffset(0, 3) })
	local btnX = (db.x - 290.5) * W.sc
	tween(p.frame, 0.35, { GroupTransparency = 1 })
	tween(p.frame, 0.5, { Size = UDim2.fromOffset(36, 36), Position = UDim2.new(0.5, btnX, 1, -(12 + 17 * W.sc)) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	task.delay(0.52, function()
		if not p.open then
			p.frame.Visible = false
		end
	end)
	local any = false
	for _, other in pairs(Fn.Panels) do
		if other.open then
			any = true
		end
	end
	if not any then
		tween(W.chevron, 0.6, { Position = UDim2.new(0.5, 0, 1, Fn.chevronY(false)) }, Enum.EasingStyle.Quint)
	end
	Fn.playSound("Close")
end

function Fn.openPanel(name)
	for n in pairs(Fn.Panels) do
		if n ~= name then
			Fn.closePanel(n)
		end
	end
	local p, db = Fn.Panels[name], W.buttons[name]
	if not p or p.open then
		return
	end
	p.open = true
	local btnX = (db.x - 290.5) * W.sc
	p.frame.Size = UDim2.fromOffset(36, 36)
	p.frame.Position = UDim2.new(0.5, btnX, 1, -(12 + 17 * W.sc))
	p.frame.GroupTransparency = 1
	p.frame.Visible = true
	tween(db.dot, 0.4, { Size = UDim2.fromOffset(14, 3) }, Enum.EasingStyle.Back)
	tween(p.frame, 0.35, { GroupTransparency = 0 })
	tween(p.frame, 0.9, { Size = UDim2.fromOffset(581, 246) }, Enum.EasingStyle.Exponential)
	tween(p.frame, 0.6, { Position = UDim2.new(0.5, 0, 1, -(20 + 70 * W.sc)) })
	tween(W.chevron, 0.65, { Position = UDim2.new(0.5, 0, 1, Fn.chevronY(true)) }, Enum.EasingStyle.Quint)
	Fn.stagger(p.content)
	Fn.playSound("Open")
end

function Fn.closeAllPanels()
	for n in pairs(Fn.Panels) do
		Fn.closePanel(n)
