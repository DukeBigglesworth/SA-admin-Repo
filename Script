			end
		end

		local function startCfly(speed)
			local _, h, r = parts()
			if not (h and r) then
				return say("CFrame Flight", "Your character isn't ready.", "warn")
			end
			stopFlightModes("cfly")
			stopMrun(true)
			stopCfly(true)
			local c = X.cfly
			if speed then
				c.speed = math.clamp(speed, 1, 1000)
			end
			c.on = true
			c.slot = {}
			h.PlatformStand = true
			bind("cfly", runService.Heartbeat, function(dt)
				local _, h2, r2 = parts()
				if not (c.on and h2 and r2) then
					stopCfly(true)
					return
				end
				local dir = steer(true)
				local moving = dir.Magnitude > 0.01
				local spd = c.speed
				if not typing() and down(keyCodes.LeftShift) then
					spd = spd * 2
				end
				r2.AssemblyLinearVelocity = Vector3.zero
				r2.AssemblyAngularVelocity = Vector3.zero
				local pos = r2.Position
				if moving then
					pos = pos + dir.Unit * spd * dt
				end
				local look = workspace.CurrentCamera.CFrame.LookVector
				local target
				if State.flyStyle == "superman" then
					target = aim(pos, look) * CFrame.Angles(math.rad(-90), 0, 0)
				else
					local flat = Vector3.new(look.X, 0, look.Z)
					if flat.Magnitude < 0.01 then
						flat = r2.CFrame.LookVector
					end
					target = CFrame.lookAt(pos, pos + flat)
				end
				r2.CFrame = CFrame.new(pos) * r2.CFrame.Rotation:Lerp(target.Rotation, math.min(dt * 12, 1))
				setMotion(c.slot, "fly", moving)
			end)
			say("CFrame Flight", "On - " .. c.speed .. " studs/s. Shift doubles, Space/E up, Q/Ctrl down.", "ok")
		end

		stopMrun = function(silent)
