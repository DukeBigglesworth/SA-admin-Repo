			avatar_url = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. player.UserId .. "&width=420&height=420&format=png",
		})
	end
end

function Fn.replacePlain(haystack, needleLower, replacement)
	if needleLower == "" then
		return haystack
	end
	local lowered = string.lower(haystack)
	local out, cursor = {}, 1
	while true do
		local s, e = string.find(lowered, needleLower, cursor, true)
		if not s then
			break
		end
		table.insert(out, string.sub(haystack, cursor, s - 1))
		table.insert(out, replacement)
		cursor = e + 1
	end
	if cursor == 1 then
		return haystack
	end
	table.insert(out, string.sub(haystack, cursor))
	return table.concat(out)
end

