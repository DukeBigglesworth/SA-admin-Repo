	local PERSIST_ACTIONS = { 1, 2, 5, 7, 8, 9, 10 }

	local function sessionPath()
		return folderPath("session.json")
	end

	local function packPos(gui)
		if not gui then return nil end
		local p = gui.Position
		return {
			xs = p.X.Scale, xo = p.X.Offset,
			ys = p.Y.Scale, yo = p.Y.Offset,
			ax = gui.AnchorPoint.X, ay = gui.AnchorPoint.Y,
		}
	end

	local function applyPos(gui, packed)
		if not gui or type(packed) ~= "table" then return end
		if type(packed.ax) == "number" and type(packed.ay) == "number" then
			gui.AnchorPoint = Vector2.new(packed.ax, packed.ay)
		end
		if type(packed.xs) == "number" and type(packed.xo) == "number" and type(packed.ys) == "number" and type(packed.yo) == "number" then
			gui.Position = UDim2.new(packed.xs, packed.xo, packed.ys, packed.yo)
		end
	end

	local function packWin(win)
		if not win or not win.frame then return nil end
		local p = packPos(win.frame)
		if not p then return nil end
		p.min = win.minimized == true
		p.open = win.open == true
		return p
	end

	function Fn.saveSessionState()
		if not writefile then return end
		Fn.ensureFolders()
		local data = {
			actions = {},
			speedBoost = State.speedBoost == true,
			jumpBoost = State.jumpBoost == true,
			sliders = {},
			openWindows = {},
			windowPos = {},
			toggles = {},
			openMinis = {},
			miniPos = {},
		}
		for _, i in ipairs(PERSIST_ACTIONS) do
			local a = Fn.Actions[i]
			if a then
				data.actions[tostring(i)] = a.enabled == true
			end
		end
		for i, s in ipairs(Fn.Sliders or {}) do
			data.sliders[tostring(i)] = s.value
		end
		local function noteWin(name, win)
			if not win or not win.frame then return end
			local packed = packWin(win)
			if packed then
				data.windowPos[name] = packed
			end
			if win.open then
				data.openWindows[name] = { min = win.minimized == true, pos = packPos(win.frame) }
			end
		end
		if W.dockWindows then
			for name, win in pairs(W.dockWindows) do
				noteWin(name, win)
			end
		end
		noteWin("Settings", W.settingsWin)
		noteWin("Music", W.musicWin)
		if W.mini then
			for key, m in pairs(W.mini) do
				if m and m.alive and m.frame then
					local p = packPos(m.frame)
					if p then
						data.miniPos[key] = p
					end
					if m.frame.Visible then
						data.openMinis[key] = p or true
					end
				end
			end
		end
		data.clicktp = Fn.ClickTP and Fn.ClickTP.on == true
		if Fn.Toggles then
			for name, t in pairs(Fn.Toggles) do
				if t.persist and t.enabled then
					data.toggles[name] = true
				end
			end
		end
		local ok, encoded = pcall(httpService.JSONEncode, httpService, data)
		if ok then
			pcall(writefile, sessionPath(), encoded)
		end
	end

	Fn.rememberOpenWindows = Fn.saveSessionState

	function Fn.loadSessionState()
		if not (isfile and readfile) then return end
		local ok, data = pcall(function()
			if isfile(sessionPath()) then
				return httpService:JSONDecode(readfile(sessionPath()))
			end
		end)
		if not (ok and type(data) == "table") then return end
		if type(data.sliders) == "table" and Fn.Sliders then
			for i, s in ipairs(Fn.Sliders) do
				local v = data.sliders[tostring(i)]
				if type(v) == "number" then
					s.value = v
					if W.sliderObjs and W.sliderObjs[i] and W.sliderObjs[i].set then
						W.sliderObjs[i].set(v, true)
					end
				end
			end
		end
		if data.speedBoost then
			State.speedBoost = true
			pcall(function()
				local h = Fn.humanoid()
				if h then h.WalkSpeed = Fn.Sliders[1].value end
			end)
			if W.sliderObjs and W.sliderObjs[1] and W.sliderObjs[1].setBoostVisual then
				W.sliderObjs[1].setBoostVisual(true)
			end
		end
		if data.jumpBoost then
			State.jumpBoost = true
			pcall(function()
				local h = Fn.humanoid()
				if h then
					local v = Fn.Sliders[2].value
					if h.UseJumpPower then h.JumpPower = v else h.JumpHeight = v end
				end
			end)
			if W.sliderObjs and W.sliderObjs[2] and W.sliderObjs[2].setBoostVisual then
				W.sliderObjs[2].setBoostVisual(true)
			end
		end
		if type(data.actions) == "table" then
			for _, i in ipairs(PERSIST_ACTIONS) do
				if data.actions[tostring(i)] and Fn.Actions[i] and not Fn.Actions[i].enabled then
					task.defer(function()
						pcall(Fn.toggleAction, i)
						if type(Fn.openMini) == "function" then
							pcall(Fn.openMini, "a" .. i)
						end
					end)
				end
			end
		end
		task.defer(function()
			task.wait(1.1)
			local function resolveWin(name)
				if name == "EmoteMini" or name == "Reanim" then
					return nil
				end
				local win = W.dockWindows and W.dockWindows[name]
				if win then return win end
				if name == "Settings" then return W.settingsWin end
				if name == "Music" then return W.musicWin end
				if name == "ToolGen" and type(Fn.buildToolGen) == "function" then return Fn.buildToolGen() end
				if name == "ClickTP" and type(Fn.buildClickTPWindow) == "function" then return Fn.buildClickTPWindow() end
				if name == "Airwalk" and type(Fn.buildAirwalkWindow) == "function" then return Fn.buildAirwalkWindow() end
				return nil
			end
			local function placeWin(win, pos)
				if not win or not win.frame or type(pos) ~= "table" then return end
				if type(pos.ax) == "number" and type(pos.ay) == "number" then
					win.frame.AnchorPoint = Vector2.new(pos.ax, pos.ay)
				end
				if type(pos.xs) == "number" then
					win.frame.Position = UDim2.new(pos.xs, pos.xo or 0, pos.ys or 0, pos.yo or 0)
					win.savedPos = win.frame.Position
				end
			end
			if type(data.windowPos) == "table" then
				for name, pos in pairs(data.windowPos) do
					local win = resolveWin(name)
					if win then placeWin(win, pos) end
				end
			end
			if type(data.openWindows) == "table" then
				for name, meta in pairs(data.openWindows) do
					local win = resolveWin(name)
					if win and win.show then
						if type(meta) == "table" and meta.pos then
							placeWin(win, meta.pos)
						elseif type(data.windowPos) == "table" and data.windowPos[name] then
							placeWin(win, data.windowPos[name])
						end
						pcall(win.show)
						if type(meta) == "table" and meta.pos then
							placeWin(win, meta.pos)
						elseif type(data.windowPos) == "table" and data.windowPos[name] then
							placeWin(win, data.windowPos[name])
						end
						pcall(Fn.clampWindow, win.frame)
						if type(meta) == "table" and meta.min and win.setMin then
							task.delay(0.45, function()
								pcall(win.setMin, true)
								if type(meta) == "table" and meta.pos then
									placeWin(win, meta.pos)
								end
								pcall(Fn.clampWindow, win.frame)
							end)
						end
					end
				end
			end
			if type(data.openMinis) == "table" and type(Fn.openMini) == "function" then
				for key, meta in pairs(data.openMinis) do
					local m = Fn.openMini(key)
					local pos = type(meta) == "table" and meta or (data.miniPos and data.miniPos[key])
					if m and m.frame and type(pos) == "table" and type(pos.xs) == "number" then
						if type(pos.ax) == "number" then
							m.frame.AnchorPoint = Vector2.new(pos.ax, pos.ay or 0)
						end
						m.frame.Position = UDim2.new(pos.xs, pos.xo or 0, pos.ys or 0, pos.yo or 0)
						pcall(Fn.clampWindow, m.frame)
					end
				end
			end
			if data.clicktp and type(Fn.setClickTP) == "function" then
				pcall(Fn.setClickTP, true)
				if type(Fn.buildClickTPWindow) == "function" then
					local win = Fn.buildClickTPWindow()
					if win and win.show then
						if data.windowPos and data.windowPos.ClickTP then
							placeWin(win, data.windowPos.ClickTP)
						end
						pcall(win.show)
						if data.windowPos and data.windowPos.ClickTP then
							placeWin(win, data.windowPos.ClickTP)
						end
					end
				end
			end
			if type(data.toggles) == "table" and Fn.setToggle then
				for name in pairs(data.toggles) do
					pcall(Fn.setToggle, name, true, {}, true)
					if name == "airwalk" and type(Fn.buildAirwalkWindow) == "function" then
						local win = Fn.buildAirwalkWindow()
						if win and win.show then
							if data.windowPos and data.windowPos.Airwalk then
								placeWin(win, data.windowPos.Airwalk)
							end
							pcall(win.show)
							if data.windowPos and data.windowPos.Airwalk then
								placeWin(win, data.windowPos.Airwalk)
							end
						end
					end
				end
			end
		end)
	end

