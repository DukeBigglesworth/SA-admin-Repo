		Sections.f_keyframes = function(C)
local Fn, W, State, Values = C.Fn, C.W, C.State, C.Values
local new, round, stroke, tween, txt, ttxt, reg, lerp, track = C.new, C.round, C.stroke, C.tween, C.txt, C.ttxt, C.reg, C.lerp, C.track
local S = C.S
local players, runService, userInputService, tweenService, lighting, httpService = S.players, S.runService, S.userInputService, S.tweenService, S.lighting, S.httpService
local starterGui, textService, teleportService, statsService = S.starterGui, S.textService, S.teleportService, S.statsService
local localPlayer, gui, folderPath = S.localPlayer, S.gui, C.folderPath
local lower, format, floor, clamp = string.lower, string.format, math.floor, math.clamp
local Mod = Fn.Mod
local rad, deg = math.rad, math.deg
local EASES = { "Linear", "Sine", "Quad", "Cubic", "Quart", "Back", "Bounce", "Elastic", "Constant" }
local POSE_EASE = { Linear = "Linear", Constant = "Constant", Elastic = "Elastic", Bounce = "Bounce" }
local FIELDS = { "Rotate X", "Rotate Y", "Rotate Z", "Move X", "Move Y", "Move Z" }

local KF = {
	frames = {}, length = 2, loop = true, speed = 1, time = 0, playing = false, joints = {}, order = {}, selected = nil, pose = {},
	name = "Untitled", ease = "Linear", engaged = false, freezeAnim = true, selKey = nil, touched = {},
}
Fn.KF = KF

local function newPose()
	return { 0, 0, 0, 0, 0, 0 }
end

local function copyPose(p)
	return { p[1], p[2], p[3], p[4], p[5], p[6] }
end

local function isIdentity(p)
	for i = 1, 6 do
		if math.abs(p[i]) > 0.001 then
			return false
		end
	end
	return true
end

local function poseCF(p)
	return CFrame.new(p[4], p[5], p[6]) * CFrame.fromOrientation(rad(p[1]), rad(p[2]), rad(p[3]))
end

local function cfToPose(cf)
	local rx, ry, rz = cf:ToOrientation()
	local pos = cf.Position
	return { deg(rx), deg(ry), deg(rz), pos.X, pos.Y, pos.Z }
end

local function easeAlpha(name, a)
	if name == "Linear" then
		return a
	elseif name == "Constant" then
		return 0
	end
	return tweenService:GetValue(a, Enum.EasingStyle[name], Enum.EasingDirection.InOut)
end

local function sortFrames()
	table.sort(KF.frames, function(a, b)
		return a.t < b.t
	end)
end

local function sample(j, t)
	local prev, nxt
	for _, fr in ipairs(KF.frames) do
		if fr.poses[j] then
			if fr.t <= t then
				prev = fr
			end
			if fr.t >= t and not nxt then
				nxt = fr
			end
		end
	end
	if not prev and not nxt then
		return nil
	end
	if not prev then
		return copyPose(nxt.poses[j])
	end
	if not nxt or prev == nxt or nxt.t == prev.t then
		return copyPose(prev.poses[j])
	end
	local a = easeAlpha(prev.ease or "Linear", (t - prev.t) / (nxt.t - prev.t))
	local p0, p1 = prev.poses[j], nxt.poses[j]
	local out = {}
	for i = 1, 6 do
		out[i] = p0[i] + (p1[i] - p0[i]) * a
	end
	return out
end

local function keyedJoints()
	local set = {}
	for _, fr in ipairs(KF.frames) do
		for j in pairs(fr.poses) do
			set[j] = true
		end
	end
	return set
end

local function resample()
	for j in pairs(keyedJoints()) do
		local p = sample(j, KF.time)
		if p then
			KF.pose[j] = p
			KF.touched[j] = true
		end
	end
end

local function scanJoints()
	KF.joints, KF.order = {}, {}
	local c = localPlayer.Character
	if not c then
		return
	end
	for _, d in ipairs(c:GetDescendants()) do
		if d:IsA("Motor6D") and d.Part1 and not KF.joints[d.Part1.Name] then
			KF.joints[d.Part1.Name] = d
			KF.order[#KF.order + 1] = d.Part1.Name
		end
	end
	table.sort(KF.order)
end

local function engage()
	if KF.engaged then
		return
	end
	scanJoints()
	KF.engaged = true
	local c = localPlayer.Character
	local animate = c and c:FindFirstChild("Animate")
	local h = Fn.hum()
	if KF.freezeAnim then
		if Fn.Anim then
			Fn.Anim.stop()
		end
		if animate then
			animate.Disabled = true
			KF.animateWas = animate
		end
		if h then
			for _, t in ipairs(h:GetPlayingAnimationTracks()) do
				t:Stop(0)
			end
		end
	end
	Fn.loop("kfdrive", function(dt)
		if KF.playing then
			KF.time += dt * KF.speed
			if KF.time >= KF.length then
				if KF.loop then
					KF.time = KF.time % math.max(KF.length, 0.01)
				else
					KF.time = KF.length
					KF.playing = false
				end
			end
			resample()
			if KF.onTime then
				KF.onTime()
			end
		end
		for j, p in pairs(KF.pose) do
			local m = KF.joints[j]
			if m and m.Parent then
				m.Transform = poseCF(p)
			end
		end
	end, runService.RenderStepped)
end

local function disengage()
	if not KF.engaged then
		return
	end
	KF.engaged = false
	KF.playing = false
	Fn.unloop("kfdrive")
	for j in pairs(KF.touched) do
		local m = KF.joints[j]
		if m and m.Parent then
			m.Transform = CFrame.new()
		end
	end
	if KF.animateWas and KF.animateWas.Parent then
		KF.animateWas.Disabled = false
	end
	KF.animateWas = nil
end
Fn.onCleanup(disengage)

track(localPlayer.CharacterAdded:Connect(function()
	KF.engaged = false
	Fn.unloop("kfdrive")
	KF.animateWas = nil
	KF.touched = {}
	if KF.ui and KF.ui.win.open then
		task.wait(0.8)
		engage()
		KF.ui.refreshJoints()
	end
end))

local function addKey()
	local t = floor(KF.time * 1000 + 0.5) / 1000
	local fr
	for _, f in ipairs(KF.frames) do
		if math.abs(f.t - t) < 0.001 then
			fr = f
			break
		end
	end
	if not fr then
		fr = { t = t, poses = {}, ease = KF.ease }
		KF.frames[#KF.frames + 1] = fr
	end
	local keyed = keyedJoints()
	fr.poses = {}
	fr.ease = KF.ease
	for j, p in pairs(KF.pose) do
		if not isIdentity(p) or keyed[j] then
			fr.poses[j] = copyPose(p)
		end
	end
	sortFrames()
	KF.selKey = fr
	return fr
end

local function deleteKey()
	local best, bd
	for _, f in ipairs(KF.frames) do
		local d = math.abs(f.t - KF.time)
		if not bd or d < bd then
			best, bd = f, d
		end
	end
	local target = KF.selKey or best
	if target then
		local at = table.find(KF.frames, target)
		if at then
			table.remove(KF.frames, at)
		end
		KF.selKey = nil
		return true
	end
	return false
end

local function exportData()
	local frames = {}
	for _, f in ipairs(KF.frames) do
		local poses = {}
		for j, p in pairs(f.poses) do
			poses[j] = { p[1], p[2], p[3], p[4], p[5], p[6] }
		end
		frames[#frames + 1] = { t = f.t, ease = f.ease, poses = poses }
	end
	return { name = KF.name, length = KF.length, loop = KF.loop, frames = frames }
end

local function importData(data)
	if type(data) ~= "table" or type(data.frames) ~= "table" then
		return false
	end
	KF.frames = {}
	for _, f in ipairs(data.frames) do
		if type(f) == "table" and type(f.poses) == "table" and tonumber(f.t) then
			local poses = {}
			for j, p in pairs(f.poses) do
				if type(p) == "table" and #p >= 6 then
					poses[j] = { tonumber(p[1]) or 0, tonumber(p[2]) or 0, tonumber(p[3]) or 0, tonumber(p[4]) or 0, tonumber(p[5]) or 0, tonumber(p[6]) or 0 }
				end
			end
			KF.frames[#KF.frames + 1] = { t = tonumber(f.t), ease = f.ease or "Linear", poses = poses }
		end
	end
	sortFrames()
	KF.name = tostring(data.name or "Imported")
	KF.length = math.max(tonumber(data.length) or 2, 0.1)
	KF.loop = data.loop ~= false
	KF.time = 0
	KF.pose = {}
	resample()
	return true
end

local function convertSequence(seq)
	local keyframes = seq:GetKeyframes()
	table.sort(keyframes, function(a, b)
		return a.Time < b.Time
	end)
	local frames = {}
	for _, k in ipairs(keyframes) do
		local poses = {}
		for _, d in ipairs(k:GetDescendants()) do
			if d:IsA("Pose") and d.Name ~= "HumanoidRootPart" then
				poses[d.Name] = cfToPose(d.CFrame)
			end
		end
		frames[#frames + 1] = { t = k.Time, ease = "Linear", poses = poses }
	end
	local last = frames[#frames]
	return { name = seq.Name, length = last and math.max(last.t, 0.1) or 1, loop = seq.Loop, frames = frames }
end

local function fetchSequence(id)
	local ok, objs = pcall(function()
		return game:GetObjects("rbxassetid://" .. id)
	end)
	if ok and type(objs) == "table" then
		for _, o in ipairs(objs) do
			if o:IsA("KeyframeSequence") then
				return o
			end
			local inner = o:FindFirstChildWhichIsA("KeyframeSequence", true)
			if inner then
				return inner
			end
		end
	end
	local ok2, seq = pcall(function()
		return game:GetService("KeyframeSequenceProvider"):GetKeyframeSequenceAsync("rbxassetid://" .. id)
	end)
	if ok2 and seq then
		return seq
	end
	return nil
end

function Fn.kfImportId(text)
	local id = Fn.cleanAnimId(text)
	if not id then
		return Fn.notify("Keyframes", "Enter an animation ID first.", "warn")
	end
	task.spawn(function()
		local seq = fetchSequence(id)
		if not seq then
			return Fn.notify("Keyframes", "Couldn't read keyframes from " .. id .. ". Roblox only gives them out for animations you own or that are free to use.", "warn")
		end
		if importData(convertSequence(seq)) then
			if KF.ui then
				KF.ui.refreshAll()
			end
			Fn.notify("Keyframes", "Imported " .. #KF.frames .. " keyframes from " .. id .. ".", "ok")
		end
	end)
end

local function buildSequence()
	local c = localPlayer.Character
	local kfs = Instance.new("KeyframeSequence")
	kfs.Name = KF.name
	kfs.Loop = KF.loop
	kfs.Priority = Enum.AnimationPriority.Action
	local children, hasParent = {}, {}
	if c then
		for _, d in ipairs(c:GetDescendants()) do
			if d:IsA("Motor6D") and d.Part0 and d.Part1 then
				children[d.Part0.Name] = children[d.Part0.Name] or {}
				table.insert(children[d.Part0.Name], d.Part1.Name)
				hasParent[d.Part1.Name] = true
			end
		end
	end
	local rootName = "HumanoidRootPart"
	local frames = {}
	for _, f in ipairs(KF.frames) do
		frames[#frames + 1] = f
	end
	if #frames > 0 and frames[#frames].t < KF.length then
		local src = KF.loop and frames[1] or frames[#frames]
		frames[#frames + 1] = { t = KF.length, poses = src.poses, ease = src.ease }
	end
	for _, f in ipairs(frames) do
		local kf = Instance.new("Keyframe")
		kf.Time = f.t
		local function addPose(name, parent)
			local pose = Instance.new("Pose")
			pose.Name = name
			local p = f.poses[name]
			pose.CFrame = p and poseCF(p) or CFrame.new()
			pose.Weight = name == rootName and 0 or 1
			local style = POSE_EASE[f.ease or "Linear"] or "Cubic"
			pose.EasingStyle = Enum.PoseEasingStyle[style]
			pose.EasingDirection = Enum.PoseEasingDirection.InOut
			pose.Parent = parent
			for _, ch in ipairs(children[name] or {}) do
				addPose(ch, pose)
			end
		end
		addPose(rootName, kf)
		kf.Parent = kfs
	end
	return kfs
end

function Fn.kfRunAsAnimation()
	if #KF.frames == 0 then
		return Fn.notify("Keyframes", "Add at least one keyframe first.", "warn")
	end
	local ok, id = pcall(function()
		return game:GetService("KeyframeSequenceProvider"):RegisterKeyframeSequence(buildSequence())
	end)
	if not ok or not id then
		return Fn.notify("Keyframes", "Your executor blocked RegisterKeyframeSequence. The live preview in the studio still works.", "warn")
	end
	KF.playing = false
	disengage()
	local h = Fn.hum()
	local a = h and Fn.getAnimator(h)
	if not a then
		return
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = id
	local ok2, tr = pcall(function()
		return a:LoadAnimation(anim)
	end)
	if ok2 and tr then
		tr.Priority = Enum.AnimationPriority.Action
		tr.Looped = KF.loop
		tr:Play(0.1, 1, KF.speed)
		KF.runTrack = tr
		Fn.notify("Keyframes", "Playing your animation as a real animation track.", "ok")
	else
		Fn.notify("Keyframes", "Couldn't load the generated animation.", "warn")
	end
end

	Fn.BuiltinKeyframes = {}

local function kfFolder()
	if isfolder and makefolder then
		if not isfolder(folderPath()) then
			pcall(makefolder, folderPath())
		end
		if not isfolder(folderPath("Keyframes")) then
			pcall(makefolder, folderPath("Keyframes"))
		end
	end
	return folderPath("Keyframes")
end

function Fn.kfSave(name)
	if not writefile then
		return Fn.notify("Keyframes", "Your executor has no writefile.", "warn")
	end
	name = tostring(name or KF.name):gsub("[^%w%-_ ]", "")
	if name == "" then
		name = "Untitled"
	end
	KF.name = name
	local ok, enc = pcall(httpService.JSONEncode, httpService, exportData())
	if ok then
		pcall(writefile, kfFolder() .. "/" .. name .. ".json", enc)
		Fn.notify("Keyframes", "Saved to " .. kfFolder() .. "/" .. name .. ".json", "ok")
	end
end

function Fn.kfFiles()
	local out = {}
	if listfiles then
		local ok, files = pcall(listfiles, kfFolder())
		if ok and type(files) == "table" then
			for _, p in ipairs(files) do
				local n = tostring(p):match("([^/\\]+)%.json$")
				if n then
					out[#out + 1] = { name = n, id = n }
				end
			end
		end
	end
	table.sort(out, function(a, b)
		return a.name:lower() < b.name:lower()
	end)
	return out
end

function Fn.kfLoad(name)
	if not (readfile and isfile) then
		return Fn.notify("Keyframes", "Your executor can't read files.", "warn")
	end
	local path = kfFolder() .. "/" .. name .. ".json"
	if not isfile(path) then
		return Fn.notify("Keyframes", "No saved animation called " .. name .. ".", "warn")
	end
	local ok, data = pcall(function()
		return httpService:JSONDecode(readfile(path))
	end)
	if ok and importData(data) then
		if KF.ui then
			KF.ui.refreshAll()
		end
		Fn.notify("Keyframes", "Loaded " .. name .. " (" .. #KF.frames .. " keyframes).", "ok")
	else
		Fn.notify("Keyframes", "That file isn't a valid keyframe animation.", "warn")
	end
end

local function frameListToData(name, frames)
	local out = {}
	for _, fr in ipairs(frames) do
		if type(fr) == "table" and type(fr.Data) == "table" and tonumber(fr.Time) then
			local poses = {}
			for joint, cf in pairs(fr.Data) do
				if joint ~= "HumanoidRootPart" and typeof(cf) == "CFrame" then
					poses[joint] = cfToPose(cf)
				end
			end
			out[#out + 1] = { t = tonumber(fr.Time), ease = "Linear", poses = poses }
		end
	end
	table.sort(out, function(a, b)
		return a.t < b.t
	end)
	local last = out[#out]
	return { name = name, length = last and math.max(last.t, 0.1) or 1, loop = true, frames = out }
end

function Fn.kfParseLua(raw)
	local fn, err = loadstring(raw)
	if not fn then
		error(err)
	end
	if not setfenv then
		error("no sandbox available")
	end
	setfenv(fn, { CFrame = { new = CFrame.new }, Vector3 = { new = Vector3.new }, math = math })
	return fn()
end

function Fn.kfLibraryNames()
	local out, seen = {}, {}
	for name in pairs(Fn.BuiltinKeyframes or {}) do
		out[#out + 1] = { name = tostring(name), id = tostring(name) }
		seen[tostring(name)] = true
	end
	if listfiles then
		local ok, files = pcall(listfiles, kfFolder())
		if ok and type(files) == "table" then
			for _, path in ipairs(files) do
				local n = tostring(path):match("([^/\\]+)$")
				if n and not seen[n] and (lower(n):match("%.lua$") or lower(n):match("%.txt$") or lower(n):match("%.json$")) then
					seen[n] = true
					out[#out + 1] = { name = n, id = n }
				end
			end
		end
	end
	table.sort(out, function(a, b)
		return lower(a.name) < lower(b.name)
	end)
	return out
end

function Fn.kfLoadLibrary(name)
	local data
	local builtin = Fn.BuiltinKeyframes and Fn.BuiltinKeyframes[name]
	if builtin then
		data = frameListToData(name, builtin)
	else
		if not (readfile and isfile) then
			return Fn.notify("Keyframes", "Your executor can't read files.", "warn")
		end
		local path = kfFolder() .. "/" .. name
		if not isfile(path) then
			return Fn.notify("Keyframes", "Couldn't find " .. name, "warn")
		end
		local raw = readfile(path)
		local ok, res = pcall(function()
			if string.find(raw, "return", 1, true) or string.find(raw, "CFrame", 1, true) then
				local tab = Fn.kfParseLua(raw)
				if type(tab) == "table" then
					if tab[1] and tab[1].Data then
						return frameListToData(name, tab)
					end
					for k, v in pairs(tab) do
						if type(v) == "table" and v[1] and (v[1].Time or v[1].Data) then
							return frameListToData(tostring(k), v)
						end
					end
				end
				error("no frames")
			end
			local decoded = httpService:JSONDecode(raw)
			if type(decoded) == "table" and type(decoded.frames) == "table" then
				return decoded
			end
			error("unknown format")
		end)
		if not ok then
			return Fn.notify("Keyframes", "Couldn't read " .. name .. " as a keyframe file.", "warn")
		end
		data = res
	end
	if #data.frames == 0 or not importData(data) then
		return Fn.notify("Keyframes", name .. " has no usable frames.", "warn")
	end
	KF.name = data.name
	KF.loop = true
	if KF.ui then
		KF.ui.refreshAll()
	end
	Fn.notify("Keyframes", "Loaded " .. data.name .. " (" .. #KF.frames .. " keyframes). Press Play / pause.", "ok")
end

function Fn.kfLibrary()
	local items = Fn.kfLibraryNames()
	if #items == 0 then
		return Fn.notify("Keyframes", "The library is empty. Drop .lua keyframe files into " .. folderPath("Keyframes"), "info")
	end
	Fn.pickList("Keyframe library", items, nil, function(item)
		if not KF.ui then
			Fn.openKeyframes()
		end
		Fn.kfLoadLibrary(item.id)
	end)
end

