			p.Anchored = true
			p.CanCollide = true
			p.CanTouch = false
			p.CanQuery = false
			p.Massless = true
			p.Material = Enum.Material.Neon
			p.Size = Vector3.new(a.size, 0.4, a.size)
			p.Color = Theme.accent
			p.Transparency = a.visible and 0.35 or 1
			p.Parent = workspace
			a.part = p
