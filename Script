Fn.cmd("Animation", { "animpack", "pack" }, "animpack [name]", "Swap your idle/walk/run/jump set (no name opens the picker)", function(args)
	local q = table.concat(args, " ")
	if q == "" then
		local items = {}
		for _, p in ipairs(Fn.PACKS) do
			items[#items + 1] = { name = p.name, id = p.name }
		end
		return Fn.pickList("Animation pack", items, nil, function(item)
			An.applyPack(item.id)
		end)
	end
	An.applyPack(q)
end)
Fn.cmd("Animation", { "resetanim", "defaultanims", "resetpack" }, "resetanim", "Restore the game's own animations", function()
