function Fn.hasCommand(name)
	for _, c in ipairs(Fn.Commands) do
		for _, n in ipairs(c.names) do
			if n == name then
				return true
			end
		end
	end
	return false
end

function Fn.cmd(cat, names, usage, desc, fn)
	if type(names) == "string" then
		names = { names }
	end
	local kept = {}
	for _, n in ipairs(names) do
		if not Fn.hasCommand(n) then
			kept[#kept + 1] = n
		end
	end
	if #kept == 0 or kept[1] ~= names[1] then
		return { names = names, hidden = true, skipped = true }
	end
	names = kept
	C.add(names, usage, desc, fn)
	local entry = Fn.Commands[#Fn.Commands]
	entry.cat = cat
	return entry
end

