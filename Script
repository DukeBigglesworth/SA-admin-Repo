		local function animateScript()
			local c = localPlayer.Character
			return c and c:FindFirstChild("Animate")
		end

		local function stopAllTracks()
			local _, h = parts()
			if h then
				for _, t in ipairs(h:GetPlayingAnimationTracks()) do
					pcall(function()
						t:Stop(0)
					end)
				end
			end
		end

		local function reloadAnimate()
			local animate = animateScript()
			if not animate then
				return
			end
			animate.Disabled = true
			stopAllTracks()
			task.wait()
			animate.Disabled = false
		end

		local function setStateAnim(folderName, id)
			local animate = animateScript()
			local folder = animate and animate:FindFirstChild(folderName)
			local ref = asset(id)
			if not (folder and ref) then
				return false
			end
			local n = 0
			for _, a in ipairs(folder:GetChildren()) do
				if a:IsA("Animation") then
					if X.animOriginals[a] == nil then
						X.animOriginals[a] = a.AnimationId
					end
					a.AnimationId = ref
					n = n + 1
				end
			end
			return n > 0
		end

