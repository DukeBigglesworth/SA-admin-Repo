		origStart2()
		pcall(Fn.buildToolGen)
		pcall(Fn.buildClickTPWindow)
		pcall(Fn.buildAirwalkWindow)
		task.defer(function()
			task.wait(0.9)
			pcall(Fn.loadSessionState)
		end)
	end
