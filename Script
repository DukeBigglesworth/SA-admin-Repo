	local AntiAttach = { on = false, lastSafe = nil, cooldown = 0 }
	Fn.toggle("Movement", "antiattach", "antiattach", "If something flings or attaches you into the void, snap back to solid ground", {
		title = "Anti Attach", persist = true, aliases = { "aa", "noattach" },
		on = function()
			AntiAttach.on = true
			AntiAttach.lastSafe = nil
			Fn.loop("antiattach", function()
				local c = localPlayer.Character
				local hrp = c and c:FindFirstChild("HumanoidRootPart")
				local h = c and c:FindFirstChildOfClass("Humanoid")
				if not hrp or not h then return end
				local pos = hrp.Position
				if pos.Y > -50 and h.FloorMaterial ~= Enum.Material.Air then
					AntiAttach.lastSafe = hrp.CFrame
				end
				local falling = pos.Y < -50 or (h.Health > 0 and pos.Y < workspace.FallenPartsDestroyHeight + 20)
				local weird = false
				for _, d in ipairs(c:GetDescendants()) do
					if d:IsA("BodyVelocity") or d:IsA("BodyAngularVelocity") or d:IsA("BodyForce") or d:IsA("LinearVelocity") or d:IsA("AngularVelocity") or d:IsA("VectorForce") then
						if d.Parent and d.Parent ~= hrp then
							weird = true
						end
					end
					if d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") then
						if d.Part0 and d.Part1 then
							local other = (d.Part0:IsDescendantOf(c) and d.Part1) or (d.Part1:IsDescendantOf(c) and d.Part0)
							if other and not other:IsDescendantOf(c) and other.Parent and other.Parent ~= workspace.CurrentCamera then
								local op = other.Parent
								if op and op:FindFirstChildOfClass("Humanoid") and op ~= localPlayer then
									weird = true
									pcall(function() d:Destroy() end)
								end
							end
						end
					end
				end
				if (falling or weird) and AntiAttach.lastSafe and (os.clock() - (AntiAttach.cooldown or 0)) > 0.35 then
					AntiAttach.cooldown = os.clock()
					hrp.AssemblyLinearVelocity = Vector3.zero
					hrp.AssemblyAngularVelocity = Vector3.zero
					hrp.CFrame = AntiAttach.lastSafe + Vector3.new(0, 3, 0)
					if h.Health < h.MaxHealth * 0.15 then
						h.Health = math.max(h.Health, h.MaxHealth * 0.5)
					end
				end
			end, runService.Heartbeat)
		end,
		off = function()
			AntiAttach.on = false
			Fn.unloop("antiattach")
		end,
	})

