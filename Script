	function Fn.musicFiles()
		local out = {}
		if not (listFiles and isfolder) then
			return out
		end
		Fn.ensureFolders()
		local ok, files = pcall(listFiles, folderPath("Music"))
		if ok and type(files) == "table" then
			for _, path in ipairs(files) do
				local name = tostring(path):match("([^/\\]+)$")
				local ext = name and name:lower():match("%.(%w+)$")
				if ext == "mp3" or ext == "ogg" or ext == "wav" or ext == "flac" then
					out[#out + 1] = name
				end
			end
		end
		table.sort(out, function(a, b)
			return a:lower() < b:lower()
		end)
		return out
	end

