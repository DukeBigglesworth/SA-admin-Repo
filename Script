function Fn.makeKeyChip(parent, id, props)
	props = props or {}
	W.keyChips = W.keyChips or {}
	local b = new("TextButton", {
		Position = props.Position or UDim2.fromOffset(0, 0),
		Size = props.Size or UDim2.fromOffset(54, 22),
		Text = "", AutoButtonColor = false, BorderSizePixel = 0,
		ZIndex = props.ZIndex or 6,
	}, parent)
	reg(b, "BackgroundColor3", "tile")
	round(b, 7)
	reg(stroke(b, nil, 0.45, 1), "Color", "stroke")
	local lab = ttxt(b, {
		Size = UDim2.fromScale(1, 1), Text = "", TextSize = 10, Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Center, ZIndex = (props.ZIndex or 6) + 1,
	}, "muted")
	local function refresh()
		if State.checkingKey == id then
			lab.Text = "…"
			return
		end
		local v = Values[id]
		lab.Text = (type(v) == "string" and v ~= "") and v or "Bind"
	end
	refresh()
	W.keyChips[id] = W.keyChips[id] or {}
	table.insert(W.keyChips[id], refresh)
	b.MouseButton1Click:Connect(function()
		Fn.playSound("Click")
		State.checkingKey = id
		refresh()
		Fn.notify("Set keybind", "Press a key. Backspace clears. Esc cancels.", "info")

		local token = id
		task.delay(8, function()
			if State.checkingKey == token then
				State.checkingKey = nil
				Fn.refreshKeyChips(id)
			end
		end)
	end)
	return b
end

function Fn.updateSliderFromX(s, x)
	local a = math.clamp((x - s.frame.AbsolutePosition.X) / math.max(s.frame.AbsoluteSize.X, 1), 0, 1)
	s.set(math.floor(s.min + (s.max - s.min) * a + 0.5))
end

function Fn.applyActionVisual(i)
	local a, o = Fn.Actions[i], W.actionTiles and W.actionTiles[i]
	if not o then
		return
	end
	o.icon.Image = "rbxassetid://" .. a.images[a.enabled and 1 or 2]
	tween(o.tile, 0.5, { BackgroundTransparency = a.enabled and 0.12 or 0.6 })
	tween(o.stroke, 0.5, { Transparency = a.enabled and 1 or 0.4 })
	tween(o.icon, 0.4, { ImageTransparency = a.enabled and 0.05 or 0.45 })
	if a.enabled and a.rotate and not o.spinning then
		o.spinning = true
		task.spawn(function()
			repeat
				o.icon.Rotation = 0
				tween(o.icon, 0.75, { Rotation = 360 })
				task.wait(1)
			until not a.enabled or not Fn.alive()
			o.icon.Rotation = 0
			o.spinning = false
		end)
	end
end

