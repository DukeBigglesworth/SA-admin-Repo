local function nametagStyle(userId)
	local rng = Random.new(math.abs(tonumber(userId) or 0))
	local roll = rng:NextNumber(0, 100)
	if roll < 0.1 then
		return nil, true
	elseif roll < 1.1 then
		return Color3.fromRGB(229, 232, 238), false
	elseif roll < 3.1 then
		return Color3.fromRGB(255, 196, 64), false
	end
	local common = {
		Color3.fromRGB(18, 18, 22), Color3.fromRGB(235, 63, 72),
		Color3.fromRGB(70, 205, 112), Color3.fromRGB(255, 145, 55),
		Color3.fromRGB(75, 145, 255), Color3.fromRGB(176, 105, 255),
		Color3.fromRGB(75, 220, 220), Color3.fromRGB(245, 245, 245),
	}
	return common[rng:NextInteger(1, #common)], false
end
