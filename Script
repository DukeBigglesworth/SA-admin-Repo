		local function playFrames(frames, label)
			local c, h = parts()
			if not (c and h) then
				return say("Keyframes", "Your character isn't ready.", "warn")
			end
			local length = frames[#frames].t
			if length <= 0 then
				return say("Keyframes", "That animation has no length.", "warn")
			end
			stopKf(true)
			local animate = animateScript()
			K.animateWas = animate and animate.Disabled or false
			if animate then
				animate.Disabled = true
			end
			stopAllTracks()
			K.motors = buildMotors(c)
			K.frames = frames
			K.length = length
			K.time = 0
			K.playing = true
			bind("kf", runService.Heartbeat, function(dt)
				if localPlayer.Character ~= c or not c.Parent then
					return stopKf(true)
				end
				K.time = K.time + dt * K.speed
				if K.time > K.length then
					if K.loop then
						K.time = K.time % K.length
					else
						return stopKf()
					end
				end
				local pose = sample(K.frames, K.time)
				for name, info in pairs(K.motors) do
					local cf = pose[name]
					info.m.C0 = cf and info.c0 * cf or info.c0
				end
			end)
