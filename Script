local function schedulePreview()
	if pending then
		task.cancel(pending)
	end
	pending = task.delay(0.06, function()
		pending = nil
		refreshPreview()
	end)
end

local function commit(path, v)
	setPath(P, path, v)
	P = NT.sanitize(P)
	for _, s in ipairs(setters) do
		s()
	end
	schedulePreview()
end

