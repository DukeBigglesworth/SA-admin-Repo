local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function b64e(data)
	local out = {}
	for i = 1, #data, 3 do
		local a, b, c = string.byte(data, i, i + 2)
		local n = a * 65536 + (b or 0) * 256 + (c or 0)
		local c1, c2, c3, c4 = floor(n / 262144) % 64, floor(n / 4096) % 64, floor(n / 64) % 64, n % 64
		out[#out + 1] = string.sub(B64, c1 + 1, c1 + 1) .. string.sub(B64, c2 + 1, c2 + 1) .. (b and string.sub(B64, c3 + 1, c3 + 1) or "=") .. (c and string.sub(B64, c4 + 1, c4 + 1) or "=")
	end
	return table.concat(out)
end
local function b64d(s)
	s = s:gsub("[^%w%+/=]", "")
	local out = {}
	for i = 1, #s, 4 do
		local n, pad = 0, 0
		for j = 0, 3 do
			local ch = string.sub(s, i + j, i + j)
			local v
			if ch == "=" or ch == "" then
				v = 0
				pad += 1
			else
				v = (string.find(B64, ch, 1, true) or 1) - 1
			end
			n = n * 64 + v
		end
		out[#out + 1] = string.sub(string.char(floor(n / 65536) % 256, floor(n / 256) % 256, n % 256), 1, 3 - pad)
	end
	return table.concat(out)
end

