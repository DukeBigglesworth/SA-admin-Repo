local function parseArgs(c)
	local out = {}
	local usage = c.usage or ""
	for tok in usage:gmatch("[<%[][^>%]]+[>%]]") do
		local inner = tok:sub(2, -2)
		if lower(inner) ~= "on|off" and #out < 3 then
			out[#out + 1] = { label = inner, required = tok:sub(1, 1) == "<" }
		end
	end
	return out
end

