		local function startMrun(speed)
			local _, h, r = parts()
			if not (h and r) then
				return say("M7 Run", "Your character isn't ready.", "warn")
			end
			stopFlightModes()
			stopMrun(true)
			local m = X.mrun
			if speed then
				m.speed = math.clamp(speed, 5, 400)
			end
			m.on = true
			m.slot = {}
			m.saved = h.WalkSpeed > 0 and h.WalkSpeed or 16
			h.WalkSpeed = 0
			h.AutoRotate = false
			local bv = Instance.new("BodyVelocity")
			bv.MaxForce = Vector3.new(9e9, 0, 9e9)
			bv.P = 10000
			bv.Velocity = Vector3.zero
			bv.Parent = r
			local bg = Instance.new("BodyGyro")
			bg.MaxTorque = Vector3.one * 9e9
			bg.P = 30000
			bg.D = 1200
			bg.CFrame = r.CFrame
			bg.Parent = r
			m.bv, m.bg = bv, bg
			local cur = 0
			local face = r.CFrame
			bind("mrun", runService.Heartbeat, function(dt)
				local _, h2, r2 = parts()
				if not (m.on and h2 and r2 and bv.Parent and bg.Parent) then
					stopMrun(true)
					return
				end
				local dir = steer(false)
				dir = Vector3.new(dir.X, 0, dir.Z)
				local moving = dir.Magnitude > 0.05
				local spd = m.speed
				if not typing() and down(keyCodes.LeftControl) then
					spd = spd * 1.6
				end
				h2.WalkSpeed = 0
				if moving then
					cur = cur + (spd - cur) * math.min(dt * 10, 1)
					bv.Velocity = dir.Unit * cur
					face = face:Lerp(CFrame.lookAt(r2.Position, r2.Position + dir.Unit), math.min(dt * 12, 1))
				else
					cur = cur * (1 - math.min(dt * 14, 1))
					if cur < 0.5 then
						cur = 0
					end
					bv.Velocity = Vector3.zero
				end
				bg.CFrame = face
				setMotion(m.slot, "run", moving)
				if moving and m.slot.track then
					pcall(function()
						m.slot.track:AdjustSpeed(math.clamp(cur / math.max(spd, 1) * 1.1, 0.4, 2))
					end)
				end
			end)
			say("M7 Run", "On - " .. m.speed .. " studs/s. Hold Ctrl to sprint.", "ok")
		end

