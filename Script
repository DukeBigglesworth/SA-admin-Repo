			elseif Fn.reanimTakeControl then
				Fn.reanimTakeControl(function() if refresh then refresh() end end)
			end
			if refresh then refresh() end
		end, true, 4)
		local _, pauseLabel = Fn.makeButton(f, "Pause", UDim2.fromOffset(16, 118), UDim2.fromOffset(82, 26), function()
			if reanim.clip then reanim.playing = not reanim.playing end
			if refresh then refresh() end
		end, false, 4)
		local _, loopLabel = Fn.makeButton(f, "Loop: On", UDim2.fromOffset(106, 118), UDim2.fromOffset(88, 26), function()
			reanim.loop = not reanim.loop
			if refresh then refresh() end
		end, false, 4)
		local _, slowerLabel = Fn.makeButton(f, "−", UDim2.fromOffset(202, 118), UDim2.fromOffset(30, 26), function()
			reanim.speed = math.clamp((reanim.speed or 1) - 0.25, -4, 4)
			if refresh then refresh() end
		end, false, 4)
		local speedLabel = ttxt(f, { Position = UDim2.fromOffset(236, 118), Size = UDim2.fromOffset(76, 26), Text = "Speed 1.00x", TextSize = 10, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4 }, "muted")
		local _, fasterLabel = Fn.makeButton(f, "+", UDim2.fromOffset(318, 118), UDim2.fromOffset(26, 26), function()
			reanim.speed = math.clamp((reanim.speed or 1) + 0.25, -4, 4)
			if refresh then refresh() end
		end, false, 4)
		local search = Fn.makeInput(f, UDim2.fromOffset(16, 154), UDim2.fromOffset(328, 30), "Search keyframes", "", 3)
		local list = new("ScrollingFrame", {
			Position = UDim2.fromOffset(16, 194), Size = UDim2.fromOffset(328, 298), BackgroundTransparency = 1, BorderSizePixel = 0,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 2, ZIndex = 3,
		}, f)
		reg(list, "ScrollBarImageColor3", "accent")
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, list)

		local function rebuild()
			for _, child in ipairs(list:GetChildren()) do
				if child:IsA("GuiObject") then child:Destroy() end
			end
			local query = string.lower(search.Text or "")
			local items, seen = {}, {}
			for name in pairs(Fn.BuiltinKeyframes or {}) do
				local label = tostring(name)
				if query == "" or string.find(string.lower(label), query, 1, true) then
					items[#items + 1], seen[label] = label, true
				end
			end
			for _, label in ipairs(Fn.listKeyframeFiles and Fn.listKeyframeFiles() or {}) do
				if not seen[label] and (query == "" or string.find(string.lower(label), query, 1, true)) then
					items[#items + 1], seen[label] = label, true
				end
			end
			table.sort(items)
			for i, name in ipairs(items) do
				if i > 100 then break end
				local row = new("Frame", { Size = UDim2.new(1, -6, 0, 36), BorderSizePixel = 0, LayoutOrder = i, ZIndex = 4 }, list)
				reg(row, "BackgroundColor3", "tile")
				round(row, 8)
				ttxt(row, { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -74, 1, 0), Text = name, TextSize = 11, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 5 }, "text")
				Fn.makeButton(row, "Play", UDim2.new(1, -60, 0.5, -12), UDim2.fromOffset(52, 24), function()
					Fn.playReanim(name)
					task.defer(function() if refresh then refresh() end end)
				end, true, 6)
			end
			if #items == 0 then
				ttxt(list, { Size = UDim2.new(1, 0, 0, 54), Text = "No saved keyframes found. Use kfimport or kfrec to add one.", TextSize = 11, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4 }, "muted")
			end
		end

		refresh = function()
			status.Text = reanim.active and (reanim.playing and ("Playing " .. tostring(reanim.label or "keyframe")) or "Reanimated — ready") or "Reanimation inactive"
			controlLabel.Text = reanim.active and "Release" or "Take control"
			pauseLabel.Text = reanim.playing and "Pause" or "Resume"
			loopLabel.Text = reanim.loop and "Loop: On" or "Loop: Off"
			speedLabel.Text = ("Speed %.2fx"):format(reanim.speed or 1)
			rebuild()
		end
		search:GetPropertyChangedSignal("Text"):Connect(function() task.defer(rebuild) end)
		win.refresh = refresh
		win.onShow = refresh
		refresh()
		return win
	end

	Fn.cmd("Animation", { "emotemini", "quickemotes" }, "emotemini", "Open uploaded Roblox emotes", function()
		Fn.openAnimHub("Emotes")
	end)
	Fn.cmd("Animation", { "kfmini" }, "kfmini", "Open the Reanim keyframe controls", function()
