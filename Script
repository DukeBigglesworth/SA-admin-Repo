local fc = { pos = Vector3.zero, rot = Vector2.zero }
Fn.toggle("Camera", "freecam", "freecam [speed]", "Detach the camera and fly it around (WASD, E up, Q down, right-click look)", {
	title = "Freecam",
	on = function(args)
		local c = cam()
		local speed = tonumber(args[1]) or 1
		fc.pos = c.CFrame.Position
		local x, y = c.CFrame:ToOrientation()
		fc.rot = Vector2.new(x, y)
		c.CameraType = Enum.CameraType.Scriptable
		local r = Fn.rootPart()
		if r then
			fc.anchoredWas = r.Anchored
			r.Anchored = true
		end
		Fn.loop("freecam", function(dt)
			local look = Enum.UserInputType.MouseButton2
			if userInputService:IsMouseButtonPressed(look) then
				userInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
				local d = userInputService:GetMouseDelta()
				fc.rot = Vector2.new(clamp(fc.rot.X - d.Y * 0.004, -1.5, 1.5), fc.rot.Y - d.X * 0.004)
			else
				userInputService.MouseBehavior = Enum.MouseBehavior.Default
			end
			local cf = CFrame.fromOrientation(fc.rot.X, fc.rot.Y, 0)
			local dir = Vector3.zero
			local K = Enum.KeyCode
			local function d(k)
				return userInputService:IsKeyDown(k)
			end
			if not userInputService:GetFocusedTextBox() then
				if d(K.W) then dir += cf.LookVector end
				if d(K.S) then dir -= cf.LookVector end
				if d(K.D) then dir += cf.RightVector end
				if d(K.A) then dir -= cf.RightVector end
				if d(K.E) then dir += Vector3.yAxis end
				if d(K.Q) then dir -= Vector3.yAxis end
			end
			local mult = d(K.LeftShift) and 3 or 1
			fc.pos += dir * 60 * speed * mult * dt
			cam().CFrame = CFrame.new(fc.pos) * cf
		end, runService.RenderStepped)
	end,
	off = function()
		Fn.unloop("freecam")
		userInputService.MouseBehavior = Enum.MouseBehavior.Default
		local c = cam()
		c.CameraType = Enum.CameraType.Custom
		local r = Fn.rootPart()
		if r and fc.anchoredWas ~= nil then
			r.Anchored = fc.anchoredWas
		end
		local h = Fn.hum()
		if h then
			c.CameraSubject = h
		end
	end,
})

