function Fn.setScriptMode(mode)
	local win = W.scriptWin
	win.mode = mode
	for key, b in pairs(win.tabs) do
		tween(b, 0.3, { BackgroundColor3 = key == mode and Theme.accent or Theme.tile, TextColor3 = key == mode and Theme.bg or Theme.muted })
	end
	win.runPane.Visible = mode == "run"
	win.list.Visible = mode ~= "run"
	win.empty.Text = ""
	if mode == "favourites" then
		Fn.populateScripts(State.library.favourites, "No favourites yet. Press the heart on any script.")
	elseif mode == "recent" then
		Fn.populateScripts(State.library.recent, "Nothing executed yet.")
	elseif mode == "files" then
		local entries = {}
		if listFiles and isfolder then
			Fn.ensureFolders()
			local ok, files = pcall(listFiles, folderPath("Scripts"))
			if ok and type(files) == "table" then
				for _, path in ipairs(files) do
					local name = tostring(path):match("([^/\\]+)$") or tostring(path)
					if name:match("%.lua$") or name:match("%.txt$") or name:match("%.luau$") then
						entries[#entries + 1] = { title = name, file = path, game = "Local file" }
					end
				end
			end
		end
		Fn.populateScripts(entries, "Put .lua or .txt files in " .. folderPath("Scripts") .. " to list them here.")
	elseif mode == "results" then
		if win.lastResults then
			Fn.populateScripts(win.lastResults, "No scripts found.")
		else
			Fn.clearScriptList()
			win.empty.Text = "Search above, or open All Scripts from the Scripts panel."
		end
	end
end

function Fn.populateScripts(entries, emptyText)
	local win = W.scriptWin
	Fn.clearScriptList()
	win.empty.Text = #entries == 0 and emptyText or ""
	for i, entry in ipairs(entries) do
		if i > 40 then
			break
		end
		local card = new("Frame", { Size = UDim2.new(1, -8, 0, 64), BorderSizePixel = 0, ZIndex = 3, LayoutOrder = i }, win.list)
		reg(card, "BackgroundColor3", "tile")
		round(card, 12)
		reg(stroke(card, nil, 0.5, 1), "Color", "stroke")
		local nameLabel = ttxt(card, {
			Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -230, 0, 18), Text = tostring(entry.title or "Untitled"), TextSize = 13, Font = Enum.Font.GothamBold,
			TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 4,
		}, "text")
		local subText = tostring(entry.game or "Universal")
		if entry.verified then
			subText = subText .. "  |  verified"
		end
		if entry.patched then
			subText = subText .. "  |  patched"
		end
		ttxt(card, { Position = UDim2.fromOffset(16, 32), Size = UDim2.new(1, -230, 0, 16), Text = subText, TextSize = 11, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 4 }, "muted")
		local exec = Fn.tile(card, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.fromOffset(86, 32), corner = 9 }, "accent")
		ttxt(exec, { Size = UDim2.fromScale(1, 1), Text = "Execute", TextSize = 12, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 5 }, "bg")
		Fn.hoverTile(exec, 1.06)
		Fn.ripple(exec)
		exec.MouseButton1Click:Connect(function()
			task.spawn(Fn.runEntry, entry)
		end)
		if entry.slug then
			local heart = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -108, 0.5, 0), Size = UDim2.fromOffset(32, 32), Text = "", BackgroundTransparency = 1, ZIndex = 5 }, card)
			local hIcon = Fn.icon(heart, "heart", 18, Fn.isFavourite(entry.slug) and "accent" or "muted")
			local function refresh()
				hIcon:Destroy()
				hIcon = Fn.icon(heart, "heart", 18, Fn.isFavourite(entry.slug) and "accent" or "muted")
			end
			heart.MouseButton1Click:Connect(function()
				local now = Fn.toggleFavourite(entry)
				refresh()
				hIcon.Size = UDim2.fromOffset(10, 10)
				tween(hIcon, 0.5, { Size = UDim2.fromOffset(18, 18) }, Enum.EasingStyle.Back)
				Fn.notify(now and "Added to Favourites" or "Removed from Favourites", tostring(entry.title), "ok")
			end)
		end
		card.Position = UDim2.fromOffset(0, 12)
		task.delay(i * 0.03, function()
			if card.Parent then
				tween(card, 0.45, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
			end
		end)
	end
end

function Fn.searchScripts(query)
	local win = W.scriptWin
	win.mode = "results"
	Fn.setScriptMode("results")
	Fn.clearScriptList()
	win.empty.Text = "Searching..."
	task.spawn(function()
		local url
		if query and #query > 0 then
			url = "https://scriptblox.com/api/script/search?q=" .. httpService:UrlEncode(query) .. "&mode=free&max=20&page=1"
		else
			url = "https://scriptblox.com/api/script/fetch?page=1"
		end
		local data = Fn.fetch(url)
		local scripts = data and data.result and data.result.scripts
		if type(scripts) ~= "table" then
			win.empty.Text = "ScriptBlox didn't respond. Try again later."
			return
		end
		local entries = {}
		for _, s in ipairs(scripts) do
			entries[#entries + 1] = {
				title = s.title, slug = s.slug, script = s.script, game = s.game and s.game.name or (s.isUniversal and "Universal" or "Unknown game"),
				verified = s.verified, patched = s.isPatched,
			}
		end
		win.lastResults = entries
		if win.mode == "results" then
			Fn.populateScripts(entries, "No scripts found.")
		end
	end)
end

function Fn.openScriptWindow(mode, query)
	W.scriptWin.show()
	if mode == "search" then
		W.scriptWin.box.Text = query or ""
		if query then
			Fn.searchScripts(query)
		else
			Fn.setScriptMode("results")
			task.delay(0.35, function()
				W.scriptWin.box:CaptureFocus()
			end)
		end
	else
		Fn.setScriptMode(mode)
	end
end

