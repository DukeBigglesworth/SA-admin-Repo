local function flightDir(cam)
	local d = Vector3.zero
	if typing() then
		return d
	end
	local cf = cam.CFrame
	if down(Enum.KeyCode.W) then
		d += cf.LookVector
	end
	if down(Enum.KeyCode.S) then
		d -= cf.LookVector
	end
	if down(Enum.KeyCode.D) then
		d += cf.RightVector
	end
	if down(Enum.KeyCode.A) then
		d -= cf.RightVector
	end
	if down(Enum.KeyCode.Space) then
		d += Vector3.yAxis
	end
	if down(Enum.KeyCode.LeftShift) or down(Enum.KeyCode.LeftControl) or down(Enum.KeyCode.Q) then
		d -= Vector3.yAxis
	end
	return d
end

local function flatLook(cam, fallback)
	local l = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
	if l.Magnitude < 0.01 then
		return fallback
	end
	return l.Unit
end

local function stopMovers()
	if Mod.mv then
		for _, i in pairs(Mod.mv) do
			i:Destroy()
		end
		Mod.mv = nil
	end
end

Fn.toggle("Flight", "mfly", "mfly [speed]", "Smooth momentum flight with idle and move animations (Space up, Shift down, E boost)", {
	title = "Smooth Flight", persist = true, aliases = { "smoothfly", "mflight" },
	on = function(args)
		local r, h = root(), hum()
		if not r or not h then
			error("__silent", 0)
		end
		local sp = tonumber(args[1])
		if sp then
			Fl.speed = clamp(sp, 5, 400)
			saveCfg()
		end
		stopMovers()
		local bv = Instance.new("BodyVelocity")
		bv.MaxForce = Vector3.one * 9e9
		bv.Velocity = Vector3.zero
		bv.Parent = r
		local bg = Instance.new("BodyGyro")
		bg.MaxTorque = Vector3.one * 9e9
		bg.P = 9e4
		bg.D = 1000
		bg.CFrame = r.CFrame
		bg.Parent = r
		Mod.mv = { bv = bv, bg = bg }
		h.AutoRotate = false
		local vel, face = Vector3.zero, r.CFrame
		Fn.loop("mfly", function(dt)
			local rr = root()
			if not rr or not bv.Parent then
				return
			end
			local cam = workspace.CurrentCamera
			local dir = flightDir(cam)
			local moving = dir.Magnitude > 0.01
			local boost = (not typing() and down(Enum.KeyCode.E)) and Fl.boost or 1
			local target = moving and dir.Unit * Fl.speed * boost or Vector3.zero
			vel = vel:Lerp(target, math.min(dt * Fl.smooth, 1))
			if vel.Magnitude < 0.3 then
				vel = Vector3.zero
			end
			bv.Velocity = vel
			local look = moving and dir.Unit or flatLook(cam, rr.CFrame.LookVector)
			face = face:Lerp(CFrame.lookAt(rr.Position, rr.Position + look), math.min(dt * 6, 1))
			bg.CFrame = face
			setPose(moving and Fl.move.id or Fl.idle.id)
		end)
	end,
	off = function()
		Fn.unloop("mfly")
		stopMovers()
		clearPose()
		local h = hum()
		if h then
			h.AutoRotate = true
		end
	end,
})

