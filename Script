local function new(className, props, parent)
	local inst = Instance.new(className)
	for k, v in pairs(props or {}) do
		inst[k] = v
	end
	inst.Parent = parent
	return inst
end

local function round(obj, r)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 10) }, obj)
end

local function stroke(obj, color, transparency, thickness)
	return new("UIStroke", {
		Color = color or Color3.new(1, 1, 1), Transparency = transparency or 0.5, Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, obj)
end

local function tween(obj, t, props, style, dir)
	local tw = tweenService:Create(obj, TweenInfo.new(math.max(t, 0.01), style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function txt(parent, props)
	props.BackgroundTransparency = 1
	props.Font = props.Font or Enum.Font.GothamMedium
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.TextColor3 = props.TextColor3 or Color3.new(1, 1, 1)
	return new("TextLabel", props, parent)
end

local function lerp(a, b, t)
	return a + (b - a) * t
end

local function reg(inst, prop, key)
	themeRegistry[#themeRegistry + 1] = { inst = inst, prop = prop, key = key }
	inst[prop] = type(key) == "function" and key(Theme) or Theme[key]
	return inst
end

local function ttxt(parent, props, key)
	return reg(txt(parent, props), "TextColor3", key or "text")
end

function Fn.theme()
	return Theme
end

function Fn.applyTheme(name, t)
	Theme = Themes[name]
	W.themeName = name
	for i = #themeRegistry, 1, -1 do
		local e = themeRegistry[i]
		if not e.inst.Parent then
			table.remove(themeRegistry, i)
		else
			local v = type(e.key) == "function" and e.key(Theme) or Theme[e.key]
			local tv = typeof(v)
			if t and t > 0 and tv ~= "ColorSequence" and tv ~= "NumberSequence" then
				tween(e.inst, t, { [e.prop] = v }, Enum.EasingStyle.Quad)
			else
				e.inst[e.prop] = v
			end
		end
	end
	local demon = name == "demon"
	W.embersOn = demon and Values.embers
	if W.embers then
		tween(W.embers, t or 0.01, { GroupTransparency = W.embersOn and 0.15 or 1 })
	end
end

function Fn.animStroke(parent, speed)
	local s = stroke(parent, Color3.new(1, 1, 1), 0.35, 1)
	local g = new("UIGradient", {}, s)
	reg(g, "Color", function(t)
		return ColorSequence.new({ ColorSequenceKeypoint.new(0, t.stroke), ColorSequenceKeypoint.new(0.5, t.accent), ColorSequenceKeypoint.new(1, t.stroke) })
	end)
	animGradients[#animGradients + 1] = { g = g, speed = speed or 60 }
	return s
end

