local function pickCmd(names, usage, title, list, key)
	Fn.cmd("Flight", names, usage, "Choose the " .. lower(title) .. " (no name opens a picker)", function(args)
		local q = lower(table.concat(args, " "))
		local function choose(item)
			Fl[key] = item
			saveCfg()
			Fn.notify(title, item.name, "ok")
			if Fl.refresh then
				Fl.refresh()
			end
		end
		if q == "" then
			return Fn.pickList(title, list, Fl[key].id, choose)
		end
		for _, it in ipairs(list) do
			if lower(it.name) == q or string.find(lower(it.name), q, 1, true) then
				return choose(it)
			end
		end
		Fn.notify(title, "Nothing matches '" .. q .. "'.", "warn")
	end)
end
