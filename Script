local flyOrientById = {}
for _, s in ipairs(Fn.FlyStyles) do
	flyOrientById[s.id] = s.orient
end

function Fn.flyOrient(style, cf, vel, rot, dt)
	local mode = flyOrientById[style] or "tilt"
	if mode == "prone" then
		return cf.Rotation * CFrame.Angles(math.rad(-85), 0, 0)
	end
	local flat = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
	if flat.Magnitude < 0.01 then
		flat = Vector3.new(0, 0, -1)
	end
	local yaw = CFrame.lookAt(Vector3.zero, flat)
	if mode == "upright" then
		return yaw
	elseif mode == "plane" then
		local side = vel.Magnitude > 0 and vel.Unit:Dot(cf.RightVector) or 0
		return cf.Rotation * CFrame.Angles(math.rad(-80), 0, 0) * CFrame.Angles(0, math.rad(side * 60), 0)
	elseif mode == "spin" then
		Mod.heliAngle = ((Mod.heliAngle or 0) + (dt or 0.016) * 16) % (math.pi * 2)
		return yaw * CFrame.Angles(0, Mod.heliAngle, 0)
	end
	return rot
end

