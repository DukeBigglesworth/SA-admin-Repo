function Fn.buildAnimHub()
	local win = Fn.makeWindow("Animations", 700, 560, "Animations", "Emotes, animation packs, legacy moves, custom IDs and a live animation logger.", "Animations")
	W.dockWindows = W.dockWindows or {}
	W.dockWindows.Animations = win
	local f = win.frame
	local tabNames = { "Emotes", "Favourites", "Packs", "Legacy", "Custom", "Logger" }
	local tabBtns = {}
	local ui = { tab = "Emotes", shown = 60, catalog = {}, catalogFor = "" }

	local search = Fn.makeInput(f, UDim2.fromOffset(26, 124), UDim2.fromOffset(648, 32), "Search", "", 3)
	local list = new("ScrollingFrame", {
		Position = UDim2.fromOffset(26, 164), Size = UDim2.fromOffset(648, 292), BackgroundTransparency = 1, BorderSizePixel = 0, CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 2, ZIndex = 3,
	}, f)
	reg(list, "ScrollBarImageColor3", "accent")
	new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	local empty = ttxt(f, { Position = UDim2.fromOffset(26, 280), Size = UDim2.fromOffset(648, 40), Text = "", TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = true, ZIndex = 4 }, "muted")
	local packPane = new("Frame", { Position = UDim2.fromOffset(26, 124), Size = UDim2.fromOffset(648, 332), BackgroundTransparency = 1, Visible = false, ZIndex = 3 }, f)
	local customPane = new("Frame", { Position = UDim2.fromOffset(26, 124), Size = UDim2.fromOffset(648, 332), BackgroundTransparency = 1, Visible = false, ZIndex = 3 }, f)
	local loggerBar = new("Frame", { Position = UDim2.fromOffset(26, 164), Size = UDim2.fromOffset(648, 30), BackgroundTransparency = 1, Visible = false, ZIndex = 3 }, f)

	local function clearList()
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("GuiObject") then
				c:Destroy()
			end
		end
	end

	local function baseRow(i, title, sub)
		local row = new("Frame", { Size = UDim2.new(1, -8, 0, 46), BorderSizePixel = 0, ZIndex = 4, LayoutOrder = i }, list)
		reg(row, "BackgroundColor3", "tile")
		round(row, 10)
		reg(stroke(row, nil, 0.5, 1), "Color", "stroke")
		ttxt(row, { Position = UDim2.fromOffset(14, 6), Size = UDim2.new(1, -230, 0, 18), Text = title, TextSize = 13, Font = Enum.Font.GothamBold, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 5 }, "text")
		ttxt(row, { Position = UDim2.fromOffset(14, 25), Size = UDim2.new(1, -230, 0, 14), Text = sub, TextSize = 10, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 5 }, "muted")
		row.Position = UDim2.fromOffset(0, 10)
		task.delay(math.min(i, 12) * 0.02, function()
			if row.Parent then
				tween(row, 0.4, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
			end
		end)
		return row
	end

	local function rowButton(row, text, x, w, accent, cb)
		local b = Fn.tile(row, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -x, 0.5, 0), Size = UDim2.fromOffset(w, 28), corner = 8, ZIndex = 5 }, accent and "accent" or "tile")
		ttxt(b, { Size = UDim2.fromScale(1, 1), Text = text, TextSize = 11, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 6 }, accent and "bg" or "text")
		Fn.hoverTile(b, 1.05)
		b.MouseButton1Click:Connect(function()
			Fn.playSound("Click")
			cb(b)
		end)
		return b
	end

	local function showMore(i, count)
		local b = Fn.tile(list, { Size = UDim2.new(1, -8, 0, 36), corner = 10, ZIndex = 4 })
		b.LayoutOrder = i
		ttxt(b, { Size = UDim2.fromScale(1, 1), Text = "Show more (" .. count .. " left)", TextSize = 12, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 5 }, "accent")
		Fn.hoverTile(b, 1.02)
		b.MouseButton1Click:Connect(function()
			ui.shown += 60
			Fn.animHubRender()
		end)
	end

	local function itemList(items, q)
		local matches = {}
		for _, it in ipairs(items) do
			if q == "" or string.find(lower(it.name), q, 1, true) or string.find(tostring(it.id), q, 1, true) then
				matches[#matches + 1] = it
			end
		end
		return matches
	end

	local function emoteRow(i, item)
		local row = baseRow(i, item.name, item.sub or (("ID " .. item.id) .. (item.kind == "emote" and "  |  UGC emote" or "  |  animation")))
		rowButton(row, "Play", 14, 64, true, function()
			An.play(item.id, item.name, item.kind, { looped = item.looped })
		end)
		local star = rowButton(row, An.isFav(item.id) and "Saved" or "Save", 90, 64, false, function(b)
			local now = An.toggleFav(item)
			b:FindFirstChildWhichIsA("TextLabel").Text = now and "Saved" or "Save"
			if ui.tab == "Favourites" then
				Fn.animHubRender()
			end
		end)
		return star
	end

	local function updateEmpty(text)
		empty.Text = text or ""
	end

	function Fn.animHubRender()
		local tab = ui.tab
		local q = lower(search.Text)
		packPane.Visible = tab == "Packs"
		customPane.Visible = tab == "Custom"
		loggerBar.Visible = tab == "Logger"
		local listTab = tab == "Emotes" or tab == "Favourites" or tab == "Legacy" or tab == "Logger"
		list.Visible = listTab
		search.Parent.Visible = listTab
		list.Position = UDim2.fromOffset(26, tab == "Logger" and 200 or 164)
		list.Size = UDim2.fromOffset(648, tab == "Logger" and 256 or 292)
		clearList()
		updateEmpty("")
		for name, b in pairs(tabBtns) do
			tween(b, 0.25, { BackgroundColor3 = name == tab and Fn.theme().accent or Fn.theme().tile, TextColor3 = name == tab and Fn.theme().bg or Fn.theme().muted })
		end
		if tab == "Emotes" then
			if type(Fn.fetchUGCEmotes) == "function" then
				pcall(Fn.fetchUGCEmotes)
			end
			local items = {}
			local seen = {}
			if #ui.catalog > 0 and ui.catalogFor == q then
				for _, it in ipairs(ui.catalog) do
					local id = tostring(it.id or "")
					if id ~= "" then seen[id] = true end
					items[#items + 1] = it
				end
			end
			local ugc = type(Fn.getUGCEmotes) == "function" and Fn.getUGCEmotes() or nil
			if type(ugc) == "table" then
				for _, it in ipairs(ugc) do
					local id = tostring(it.id or "")
					local name = tostring(it.name or "")
					if id ~= "" and not seen[id] then
						if q == "" or string.find(lower(name), q, 1, true) or string.find(id, q, 1, true) then
							seen[id] = true
							items[#items + 1] = { name = name, id = id, kind = "emote", sub = "UGC emote  |  ID " .. id }
						end
					end
				end
			end
			for _, it in ipairs(itemList(Fn.EMOTES, q)) do
				local id = tostring(it.id or "")
				if not seen[id] then
					seen[id] = true
					items[#items + 1] = it
				end
			end
			local n = 0
			if q ~= "" then
				local b = Fn.tile(list, { Size = UDim2.new(1, -8, 0, 36), corner = 10, ZIndex = 4 })
				b.LayoutOrder = 0
				ttxt(b, { Size = UDim2.fromScale(1, 1), Text = "Search the Roblox catalog for '" .. search.Text .. "'", TextSize = 12, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 5 }, "accent")
				Fn.hoverTile(b, 1.02)
				b.MouseButton1Click:Connect(function()
					updateEmpty("Searching the catalog...")
					An.catalogSearch(search.Text, function(res)
						ui.catalog = res
						ui.catalogFor = lower(search.Text)
						if #res == 0 then
							updateEmpty("The catalog search returned nothing. Roblox may have changed it. Use Custom and paste the emote ID instead.")
						end
						Fn.animHubRender()
					end)
				end)
			end
			for i, it in ipairs(items) do
				if i > ui.shown then
					showMore(i, #items - ui.shown)
					break
				end
				n += 1
				emoteRow(i, it)
			end
			if n == 0 and q ~= "" then
				updateEmpty("Nothing matches. Try the catalog search above or paste an ID in Custom.")
			end
		elseif tab == "Favourites" then
			local items = itemList(An.favItems(), q)
			for i, it in ipairs(items) do
				emoteRow(i, it)
			end
			if #items == 0 then
				updateEmpty("No favourites yet. Press Save on any emote.")
			end
		elseif tab == "Legacy" then
			local items = {}
			for _, l in ipairs(Fn.LEGACY) do
				items[#items + 1] = { name = l[1], id = l[2], kind = "anim", looped = l[3], sub = "R6 style  |  " .. (l[3] and "loops" or "one-shot") .. "  |  ID " .. l[2] }
			end
			for i, it in ipairs(itemList(items, q)) do
				emoteRow(i, it)
			end
		elseif tab == "Logger" then
			local n = 0
			for i, e in ipairs(An.log) do
				if q == "" or string.find(lower(e.player), q, 1, true) or string.find(lower(e.display), q, 1, true) or string.find(lower(e.name), q, 1, true) or e.id:find(q, 1, true) then
					n += 1
					if n > 80 then
						break
					end
					local row = baseRow(i, e.display .. "  -  " .. e.name, e.t .. "  |  " .. e.priority .. "  |  " .. format("%.2fs", e.length) .. "  |  ID " .. e.id)
					rowButton(row, "Play", 14, 54, true, function()
						An.play(e.id, e.name, "anim")
					end)
					rowButton(row, "Copy ID", 76, 70, false, function()
						local ok = Fn.clipboard(e.id)
						Fn.notify(ok and "Copied" or "Clipboard unavailable", e.id, ok and "ok" or "warn")
					end)
					rowButton(row, "Save", 154, 54, false, function()
						An.toggleFav({ id = e.id, name = e.display .. " - " .. e.name, kind = "anim" })
						Fn.notify("Saved", e.name, "ok")
					end)
				end
			end
			if n == 0 then
				updateEmpty(An.logOn and "Waiting for someone to play an animation..." or "Turn the logger on, then watch what other players do.")
			end
		end
	end

	for i, name in ipairs(tabNames) do
		local b = new("TextButton", {
			Position = UDim2.fromOffset(26 + (i - 1) * 110, 88), Size = UDim2.fromOffset(102, 28), Text = name, AutoButtonColor = false, Font = Enum.Font.GothamBold, TextSize = 11,
			BorderSizePixel = 0, ZIndex = 3,
		}, f)
		reg(b, "BackgroundColor3", "tile")
		reg(b, "TextColor3", "muted")
		round(b, 9)
		Fn.ripple(b)
		tabBtns[name] = b
		b.MouseButton1Click:Connect(function()
			Fn.playSound("Click")
			ui.tab = name
			ui.shown = 60
			search.Text = ""
			Fn.animHubRender()
		end)
	end

	local debounce = 0
	search:GetPropertyChangedSignal("Text"):Connect(function()
		debounce += 1
		local mine = debounce
		task.delay(0.18, function()
			if mine == debounce and win.open then
				ui.shown = 60
				Fn.animHubRender()
			end
		end)
	end)

