function Fn.trackParts(character)
	for _, c in ipairs(State.partConns) do
		c:Disconnect()
	end
	table.clear(State.partConns)
	table.clear(State.partList)
	table.clear(State.partDefaults)
	if not character then
		return
	end
	local function add(part)
		if part:IsA("BasePart") then
			State.partList[part] = true
			if State.partDefaults[part] == nil then
				State.partDefaults[part] = part.CanCollide
			end
		end
	end
	for _, d in ipairs(character:GetDescendants()) do
		add(d)
	end
	table.insert(State.partConns, character.DescendantAdded:Connect(add))
	table.insert(State.partConns, character.DescendantRemoving:Connect(function(part)
		State.partList[part] = nil
		State.partDefaults[part] = nil
	end))
end

