				{ "fly", "Flight" }, { "anim", "Animation" }, { "emote", "Animation" }, { "keyframe", "Animation" }, { "camera", "Camera" }, { "zoom", "Camera" },
				{ "light", "World" }, { "fog", "World" }, { "shadow", "World" }, { "sky", "World" }, { "server", "Server" }, { "rejoin", "Server" },
				{ "player", "Players" }, { "teleport", "Players" }, { "walk", "Movement" }, { "jump", "Movement" }, { "speed", "Movement" }, { "gravity", "Movement" },
				{ "noclip", "Movement" }, { "platform", "Movement" }, { "waypoint", "Movement" }, { "orbit", "Movement" }, { "follow", "Movement" }, { "tool", "Tools" },
				{ "esp", "Visual" }, { "nametag", "Visual" }, { "health", "Character" }, { "character", "Character" }, { "chat", "Chat" },
			}) do
				if string.find(d, rule[1], 1, true) then
					guess = rule[2]
					break
				end
			end
			c.cat = catOf[c.names[1]] or guess
		end
	end
end

function Fn.setToggle(name, on, args, quiet)
	local t = Fn.Toggles[name]
	if not t then
		return
	end
	if on then
		if t.enabled then
			pcall(t.off)
		end
		t.args = args or {}
		local ok, err = pcall(t.on, t.args)
		if not ok then
			t.enabled = false
			pcall(t.off)
			if string.find(tostring(err), "__silent", 1, true) == nil then
				Fn.notify(t.title, "Couldn't enable: " .. tostring(err), "warn")
			end
			return
		end
		t.enabled = true
	else
		if not t.enabled then
			return
		end
		t.enabled = false
		pcall(t.off)
	end
	if not quiet then
		Fn.notify(t.title, on and (t.onText or "On") or "Off", on and "ok" or "info")
	end
	for _, listener in ipairs(Fn.toggleListeners) do
		pcall(listener, name)
	end
end

function Fn.toggle(cat, name, usage, desc, spec)
	if Fn.hasCommand(name) then
		return
	end
	spec.title = spec.title or name
	spec.name = name
	spec.enabled = false
	Fn.Toggles[name] = spec
	local names = { name }
	for _, a in ipairs(spec.aliases or {}) do
		names[#names + 1] = a
	end
	Fn.cmd(cat, names, usage, desc, function(args)
		local a = lower(args[1] or "")
		if a == "off" then
			Fn.setToggle(name, false)
		elseif a == "on" then
			Fn.setToggle(name, true, { table.unpack(args, 2) })
		elseif #args > 0 then
			Fn.setToggle(name, true, args)
		else
			Fn.setToggle(name, not spec.enabled, {})
		end
	end)
	local off = Fn.cmd(cat, { "un" .. name }, "un" .. name, "Disable " .. lower(spec.title), function()
		Fn.setToggle(name, false)
	end)
	off.hidden = true
	spec.cat = cat
	spec.desc = desc
end

function Fn.disableAllToggles()
	for name, t in pairs(Fn.Toggles) do
		if t.enabled then
			Fn.setToggle(name, false, nil, true)
		end
	end
end

function Fn.reapplyToggles()
	for _, t in pairs(Fn.Toggles) do
		if t.enabled and t.persist then
			task.spawn(function()
				task.wait(0.7)
				if t.enabled then
					pcall(t.off)
					pcall(t.on, t.args or {})
				end
			end)
		end
	end
end

function Fn.targets(q, includeSelf)
	local out, seen = {}, {}
	local function push(p, force)
		if p and not seen[p] and (includeSelf or force or p ~= localPlayer) then
			seen[p] = true
			out[#out + 1] = p
		end
	end
	q = lower(tostring(q or ""))
	if q == "" then
		return out
	end
	local myRoot = Fn.rootPart()
	for token in string.gmatch(q, "[^,]+") do
		token = token:gsub("^%s+", "")
		token = token:gsub("%s+$", "")
		if token == "me" or token == "self" then
			push(localPlayer, true)
		elseif token == "all" or token == "others" then
			for _, p in ipairs(players:GetPlayers()) do
				push(p)
			end
		elseif token == "random" then
			local pool = {}
			for _, p in ipairs(players:GetPlayers()) do
				if p ~= localPlayer then
					pool[#pool + 1] = p
				end
			end
			if #pool > 0 then
				push(pool[math.random(1, #pool)])
			end
		elseif token == "friends" then
			for _, p in ipairs(players:GetPlayers()) do
				local ok, f = pcall(localPlayer.IsFriendsWith, localPlayer, p.UserId)
				if ok and f then
					push(p)
				end
			end
		elseif token == "team" or token == "enemies" then
			for _, p in ipairs(players:GetPlayers()) do
				local same = p.Team == localPlayer.Team
				if (token == "team" and same) or (token == "enemies" and not same) then
					push(p)
				end
			end
		elseif token == "nearest" or token == "closest" or token == "farthest" then
			local best, bd
			for _, p in ipairs(players:GetPlayers()) do
				local r = p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
				if r and myRoot then
					local d = (r.Position - myRoot.Position).Magnitude
					if not bd or (token == "farthest" and d > bd) or (token ~= "farthest" and d < bd) then
						best, bd = p, d
					end
				end
			end
			push(best)
		else
			local found
			for _, p in ipairs(players:GetPlayers()) do
				if lower(p.Name) == token or lower(p.DisplayName) == token then
					found = p
					break
				end
			end
			if not found then
				for _, p in ipairs(players:GetPlayers()) do
					if lower(p.Name):sub(1, #token) == token or lower(p.DisplayName):sub(1, #token) == token then
						found = p
						break
					end
				end
			end
			if not found then
				for _, p in ipairs(players:GetPlayers()) do
					if string.find(lower(p.Name), token, 1, true) or string.find(lower(p.DisplayName), token, 1, true) then
						found = p
						break
					end
				end
			end
			push(found, true)
		end
	end
	return out
end

function Fn.target1(q)
