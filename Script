function Fn.fetch(url)
	local ok, body = pcall(function()
		if originalRequest then
			local r = originalRequest({ Url = url, Method = "GET" })
			return r.Body
		end
		return game:HttpGet(url)
	end)
	if not ok or type(body) ~= "string" or #body == 0 then
		return nil
	end
	local decoded
	if pcall(function()
		decoded = httpService:JSONDecode(body)
	end) then
		return decoded
	end
	return nil
end

function Fn.runCode(source, label)
	local chunk, err = loadstring(source)
	if not chunk then
		Fn.notify("Script Error", "Couldn't compile " .. tostring(label) .. ": " .. tostring(err), "warn")
		return false
	end
	local ok, runErr = pcall(chunk)
	if not ok then
		Fn.notify("Script Error", tostring(label) .. " errored: " .. tostring(runErr), "warn")
		return false
	end
	return true
end

function Fn.isFavourite(slug)
	for _, f in ipairs(State.library.favourites) do
		if f.slug == slug then
			return true
		end
	end
	return false
end

function Fn.toggleFavourite(entry)
	for i, f in ipairs(State.library.favourites) do
		if f.slug == entry.slug then
			table.remove(State.library.favourites, i)
			Fn.saveLibrary()
			return false
		end
	end
	table.insert(State.library.favourites, 1, { title = entry.title, slug = entry.slug, game = entry.game })
	Fn.saveLibrary()
	return true
end

function Fn.addRecent(entry)
	if not entry.slug then
		return
	end
	for i, r in ipairs(State.library.recent) do
		if r.slug == entry.slug then
			table.remove(State.library.recent, i)
			break
		end
	end
	table.insert(State.library.recent, 1, { title = entry.title, slug = entry.slug, game = entry.game })
	while #State.library.recent > 25 do
		table.remove(State.library.recent)
	end
	Fn.saveLibrary()
end

function Fn.runEntry(entry)
	if entry.file then
		local ok, src = pcall(readfile, entry.file)
		if ok and src then
			Fn.notify("Script Search", "Running " .. entry.title, "ok")
			Fn.runCode(src, entry.title)
		else
			Fn.notify("Script Search", "Couldn't read " .. entry.title, "warn")
		end
		return
	end
	local body = entry.script
	if type(body) ~= "string" or #body == 0 then
		local data = entry.slug and Fn.fetch("https://scriptblox.com/api/script/" .. entry.slug)
		body = data and data.script and data.script.script
	end
	if type(body) ~= "string" or #body == 0 then
		Fn.notify("Script Search", "ScriptBlox didn't return a script body for " .. tostring(entry.title) .. ".", "warn")
		return
	end
	Fn.notify("Script Search", "Running " .. tostring(entry.title), "ok")
	if Fn.runCode(body, entry.title) then
		Fn.addRecent(entry)
	end
end

