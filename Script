local digitNames = { ["0"] = "Zero", ["1"] = "One", ["2"] = "Two", ["3"] = "Three", ["4"] = "Four", ["5"] = "Five", ["6"] = "Six", ["7"] = "Seven", ["8"] = "Eight", ["9"] = "Nine" }

function Fn.normalizeKey(s)
	local l = lower(tostring(s or ""))
	if digitNames[l] then
		return digitNames[l]
	end
	for _, kc in ipairs(Enum.KeyCode:GetEnumItems()) do
		if lower(kc.Name) == l then
			return kc.Name
		end
	end
	return nil
end

